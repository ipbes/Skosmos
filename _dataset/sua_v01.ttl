Aerial seeding by drones for reforestation ITEM CSL_CITATION {"citationID":"iV9BtHij","properties":{"formattedCitation":"(Lang, 2018)","plainCitation":"(Lang, 2018)","noteIndex":0},"citationItems":[{"id":1653,"uris":["http://zotero.org/groups/2344805/items/T6R2P7VJ"],"itemData":{"id":1653,"type":"article-journal","container-title":"Forestry Studies","DOI":"10.2478/fsmu-2018-0001","issue":"1","note":"publisher: De Gruyter Poland","page":"5–24","title":"Construction of tree species composition map of Estonia using multispectral satellite images, soil map and a random forest algorithm","volume":"68","author":[{"family":"Lang","given":"Mait"},{"family":"Kaha","given":"Mihkel"},{"family":"Laarmann","given":"Diana"},{"family":"Sims","given":"Allan"}],"issued":{"date-parts":[["2018"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; improved efficiency of wood-biomass use for energy production ITEM CSL_CITATION {"citationID":"U1rylm2l","properties":{"formattedCitation":"(Proskurina, 2019)","plainCitation":"(Proskurina, 2019)","noteIndex":0},"citationItems":[{"id":1676,"uris":["http://zotero.org/groups/2344805/items/FQE32IU6"],"itemData":{"id":1676,"type":"article-journal","container-title":"Biofuels, bioproducts and biorefining","issue":"2","note":"publisher: Wiley Online Library","page":"371–387","title":"Global biomass trade for energy—Part 2: Production and trade streams of wood pellets, liquid biofuels, charcoal, industrial roundwood and emerging energy biomass","volume":"13","author":[{"family":"Proskurina","given":"Svetlana"},{"family":"Junginger","given":"Martin"},{"family":"Heinimö","given":"Jussi"},{"family":"Tekinel","given":"Beysin"},{"family":"Vakkilainen","given":"Esa"}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; product substitution and the digital era ITEM CSL_CITATION {"citationID":"uFR8t2Vi","properties":{"formattedCitation"