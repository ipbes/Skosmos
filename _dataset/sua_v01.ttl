* Asia-Pacific
The Asia-Pacific region includes countries from Asia, Oceania and the South Pacific Island countries. From a total of 119 sources originally retrieved for this region, 96 studies were included in the review, in conjunction with literature from assessment authors. These studies cover small-scale fisheries in more than 36 countries (see the data management report for Chapter 3 systematic literature review at https://doi.org/10.5281/zenodo.6452651) from Southeast Asia ITEM CSL_CITATION {"citationID":"2ekoMq69","properties":{"formattedCitation":"(Mattson, 2006)","plainCitation":"(Mattson, 2006)","noteIndex":0},"citationItems":[{"id":31749,"uris":["http://zotero.org/groups/2344805/items/GBAKVSJ5"],"itemData":{"id":31749,"type":"article-journal","archive":"Scopus","container-title":"International Journal of Ecology and Environmental Sciences","issue":"1","page":"109-117","title":"Conservation and enhancement of fisheries: The case of the Lower Mekong Basin","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-33745043289&partnerID=40&md5=65dbcc1ebfc1ce026fc9f27ba7e6c13e","volume":"32","author":[{"family":"Mattson","given":"N.S."}],"issued":{"date-parts":[["2006"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}, Western Asia ITEM CSL_CITATION {"citationID":"plYBpV6O","properties":{"formattedCitation":"(Al-Abdulrazzak, Zeller, Belhabib, Tesfamichael, & Pauly, 2015)","plainCitation":"(Al-Abdulrazzak, Zeller, Belhabib, Tesfamichael, & Pauly, 2015)","noteIndex":0},"citationItems":[{"id":1100,"uris":["http://zotero.org/groups/2344805/items/R5CQCPCK"],"itemData":{"id":1100,"type":"article-journal","container-title":"Regional Studies in Marine Science","ISSN":"2352-4855","journalAbbreviation":"Regional Studies in Marine Science","page":"28-34","title":"Total marine fisheries catches in the Persian/Arabian Gulf from 1950 to 2010","volume":"2","author":[{"family":"Al-Abdulrazzak","given":"Dalal"},{"family":"Zeller","given":"Dirk"},{"family":"Belhabib","given":"Dyhia"},{"family":"Tesfamichael","given":"Dawit"},{"family":"Pauly","given":"Daniel"}],"issued":{"date-parts":[["2015"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} and the Pacific ITEM CSL_CITATION {"citationID":"yEiAMIsb","properties":{"formattedCitation":"(P. J. Cohen & Foale, 2013; Cruz-Trinidad, Ali\\\\uc0\\\\u241{}o, Geronimo, & Cabral, 2014; Eriksson, 2018; Kronen, Magron, McArdle, & Vunisea, 2010; D. Zeller, 2015)","plainCitation":"(P. J. Cohen & Foale, 2013; Cruz-Trinidad, Aliño, Geronimo, & Cabral, 2014; Eriksson, 2018; Kronen, Magron, McArdle, & Vunisea, 2010; D. Zeller, 2015)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":386,"uris":["http://zotero.org/groups/2344805/items/P5WMZSU7"],"itemData":{"id":386,"type":"article-journal","archive":"Scopus","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2012.05.010","issue":"1","page":"278-287","title":"Sustaining small-scale fisheries with periodically harvested marine reserves","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84867331391&doi=10.1016%2fj.marpol.2012.05.010&partnerID=40&md5=97e90d359d0fb32c61f04cd63be1a4a1","volume":"37","author":[{"family":"Cohen","given":"P.J."},{"family":"Foale","given":"S.J."}],"issued":{"date-parts":[["2013"]]}},"label":"page"},{"id":1057,"uris":["http://zotero.org/groups/2344805/items/NQD2UQ88"],"itemData":{"id":1057,"type":"article-journal","container-title":"Coastal Management","DOI":"10.1080/08920753.2014.877761","issue":"2","page":"160-182","title":"Linking Food Security with Coral Reefs and Fisheries in the Coral Triangle","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84893949295&doi=10.1080%2f08920753.2014.877761&partnerID=40&md5=6ebb7927d40611101d1b906904dc15ac","volume":"42","author":[{"family":"Cruz-Trinidad","given":"A."},{"family":"Aliño","given":"P.M."},{"family":"Geronimo","given":"R.C."},{"family":"Cabral","given":"R.B."}],"issued":{"d