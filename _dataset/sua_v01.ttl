2344805/items/RF3WZSYZ"],"itemData":{"id":30639,"type":"article-journal","container-title":"Nature","language":"en","page":"15–15","title":"Managing fisheries in a changing climate - No need to wait for more information: industrialized fishing is already wiping out stocks","volume":"429","author":[{"family":"Worm","given":"B."},{"family":"Myers","given":"R.A."}],"issued":{"date-parts":[["2004"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. However, no fundamentally new ecological concepts were added to the conceptualization of sustainability of fishing. Rather, there was widespread interest in bringing the individual bio-ecological aspects of fishing together in what became known as the ecosystem approach to fishing ITEM CSL_CITATION {"citationID":"8ToXKqYK","properties":{"formattedCitation":"(Bianchi & Skjoldal, 2008; Commission of the European Communities, 2008; European Union, 2008; Garcia, 2003)","plainCitation":"(Bianchi & Skjoldal, 2008; Commission of the European Communities, 2008; European Union, 2008; Garcia, 2003)","noteIndex":0},"citationItems":[{"id":30399,"uris":["http://zotero.org/groups/2344805/items/VUFMNKBN"],"itemData":{"id":30399,"type":"book","event-place":"Rome","language":"en","number-of-pages":"363","publisher":"CABI Press","publisher-place":"Rome","title":"An Ecosystem Approach to Fisheries. UN Food and Agriculture Organization","author":[{"family":"Bianchi","given":"G."},{"family":"Skjoldal","given":"H.-R."}],"issued":{"date-parts":[["2008"]]}}},{"id":30392,"uris":["http://zotero.org/groups/2344805/items/BBHXYL7A"],"itemData":{"id":30392,"type":"document","title":"Communication from the Commission to the Council and the European Parliament - The role of the CFP in implementing an ecosystem approach to marine management","URL":"https://op.europa.eu/en/publication-detail/-/publication/67cba718-cfa7-4e32-aad5-657b1c1e1b1a/language-en/format-PDF","author":[{"family":"Commission of the European Communities","given":""}],"accessed":{"date-parts":[["2022",4,18]]},"issued":{"date-parts":[["2008"]]}}},{"id":30391,"uris":["http://zotero.org/groups/2344805/items/V8PN5SCW"],"itemData":{"id":30391,"type":"document","title":"Directive 2008/56/EC of the European Parliament and of the Council of 17 June 2008 establishing a framework for community action in the field of marine environmental policy (Marine Strategy Framework Directive)","URL":"https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex:32008L0056","author":[{"family":"European Union","given":""}],"accessed":{"date-parts":[["2022",4,18]]},"issued":{"date-parts":[["2008"]]}}},{"id":34881,"uris":["http://zotero.org/groups/2344805/items/2KVXKIH5"],"itemData":{"id":34881,"type":"article-journal","container-title":"FAO Fisheries Technical Paper","issue":"443","language":"fr","note":"publisher-place: Rome, FAO","page":"71","title":"The ecosystem approach to fisheries. Issues, terminology, principles, institutional foundations, implementation and outlook","author":[{"family":"Garcia","given":"S.M."},{"family":"Zerbi","given":"A."},{"family":"Aliaume","given":"C."},{"family":"Do Chi","given":"T."},{"family":"Lasserre","given":"G."}],"issued":{"date-parts":[["2003"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. This did change the dialogue regarding fishing sustainability from the presence or absence of individual properties in the fishery and its impacts to a dialogue about planning and conducting all the fishing in an area in coherent and compatible ways. This, too, became a part of the conceptualization of sustainable fishing ITEM CSL_CITATION {"citationID":"WjXLwchj","properties":{"formattedCitation":"(McLeod, 2005; Ruckelshaus, 2008)","plainCitation":"(McLeod, 2005; Ruckelshaus, 2008)","noteIndex":0},"citationItems":[{"id":30390,"uris":["http://zotero.org/groups/2344805/items/EMFCZQ2C"],"itemData":{"id":30390,"type":"document","language":"En","title":"Scientific Consensus Statement on Marine Ecosystem-Based Management","URL":"http://www.onlyoneplanet.com/marineEBM_ConsensusStatement.pdf","author":[{"family":"McLeod","given":"K."},{"family":"Lubchenco","given":"J."},{"family":"Palumbi","given":"S. R."},{"family":"Rosenberg","given":"A."},{"family":"Boesch","given":"D. F."},{"family":"Carr","given":"M. H."},{"family":"Cicin-Sain","given":"B."},{"family":"Conover","given":"David O."},{"family":"Crowder","given":"Larry B."},{"family":"Fluharty","given":"David L."},{"family":"Gaines","given":"S. D."},{"family":"Hixon","given":"M. A."},{"family":"Kennel","given":"C. F."},{"family":"Levin","given":"S. A."},{"family":"Levinton","given":"J. S."},{"family":"Mangel","given":"Marc"},{"family":"Ogden","given":""},{"family":"Peterson","given":"C. H."},{"family":"Pikitch","given":"E. K."},{"family":"Rabalais","given":"N.N."},{"family":"Sala","given":"E."},{"family":"Steneck","given":"R. S."},{"family":"Warner","given":""}],"accessed":{"date-parts":[["2022",4,18]]},"issued":{"date-parts":[["2005"]]}}},{"id":30374,"uris":["http://zotero.org/groups/2344805/items/EM52ECZ9"],"itemData":{"id":30374,"type":"article-journal","container-title":"BioScience","DOI":"10.1641/B580110","ISSN":"1525-3244, 0006-3568","issue":"1","language":"en","page":"53-63","source":"DOI.org (Crossref)","title":"Marine Ecosystem-based Management in Practice: Scientific and Governance Challenges","title-short":"Marine Ecosystem-based Management in Practice","URL":"https://academic.oup.com/bioscience/article/58/1/53/233486","volume":"58","author":[{"family":"Ruckelshaus","given":"Mary"},{"family":"Klinger","given":"Terrie"},{"family":"Knowlton","given":"Nancy"},{"family":"DeMaster","given":"Douglas P."}],"accessed":{"date-parts":[["2022",4,18]]},"issued":{"date-parts":[["2008",1,1]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. These conceptual advances were tracked and taken up by developments in fishing policy and practices, as reported in Chapter 6, section 6.4.1.
As the ecosystem approach to fisheries developed, there were important developments in global policy regarding social justice. The United Nations Conference on Environment and Development in 1992 (http://www.ciesin.org/docs/008-585/unced-home.html) and the World Summit on Sustainable Development (2002) (https://sustainabledevelopment.un.org/milesstones/wssd) brought the uses of wild species in planning development and poverty reduction to central places on the research and the policy stages ITEM CSL_CITATION {"citationID":"7eDt1oKx","properties":{"formattedCitation":"(Berkes & Folke, 1998; Ostrom, 2009)","plainCitation":"(Berkes & Folke, 1998; Ostrom, 2009)","noteIndex":0},"citationItems":[{"id":34574,"uris":["http://zotero.org/groups/2344805/items/44YM8BPL"],"itemData":{"id":34574,"type":"book","event-place":"New York","ISBN":"978-0-521-78562-4","number-of-pages":"459","publisher":"Cambridge University Press","publisher-place":"New York","title":"Linking social and ecological systems : management practices and social mechanisms for building resilience","URL":"https://www.cambridge.org/de/academic/subjects/life-sciences/ecology-and-conservation/linking-social-and-ecological-systems-management-practices-and-social-mechanisms-building-resilience?format=PB","author":[{"family":"Berkes","given":"Fikret."},{"family":"Folke","given":"Carl."}],"issued":{"date-parts":[["1998"]]}}},{"id":36,"uris":["http://zotero.org/groups/2344805/items/SMSFJKCG","http://zotero.org/groups/2344805/items/2NACCRB4"],"itemData":{"id":36,"type":"article-journal","container-title":"Science","DOI":"10.1126/science.1172133","ISSN":"0036-8075, 1095-9203","issue":"5939","journalAbbreviation":"Science","language":"en","page":"419-422","source":"DOI.org (Crossref)","title":"A General Framework for Analyzing Sustainability of Social-Ecological Systems","URL":"https://www.sciencemag.org/lookup/doi/10.1126/science.1172133","volume":"325","author":[{"family":"Ostrom","given":"Elinor"}],"accessed":{"date-parts":[["2021",4,1]]},"issued":{"date-parts":[["2009",7,24]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. In fishing, the developing ecosystem approach provided a ready setting for expanding the dialogue on the boundaries of an “ecosystem approach” to include social equity and community well-being as a part of any dialogue on the full “ecosystem” ITEM CSL_CITATION {"citationID":"VP86luzH","properties":{"formattedCitation":"(Allison & Ellis, 2001; Andrew, 2007; Berkes, 2003; de Young, 2008; Schumann & Macinko, 2007)","plainCitation":"(Allison & Ellis, 2001; Andrew, 2007; Berkes, 2003; de Young, 2008; Schumann & Macinko, 2007)","noteIndex":0},"citationItems":[{"id":30398,"uris":["http://zotero.org/groups/2344805/items/TUJUCL3B"],"itemData":{"id":30398,"type":"article-journal","container-title":"Marine Policy","language":"en","page":"377–388","title":"The livelihoods approach and management of small-scale fisheries","volume":"25","author":[{"family":"Allison","given":"E.H."},{"family":"Ellis","given":"F."}],"issued":{"date-parts":[["2001"]]}}},{"id":30401,"uris":["http://zotero.org/groups/2344805/items/4ADK9LAJ"],"itemData":{"id":30401,"type":"article-journal","container-title":"And Fisheries","language":"en","page":"227–240","title":"Diagnosis and management of small-scale fisheries in developing countries Fish","volume":"8","author":[{"family":"Andrew","given":"N.L."},{"family":"Bene","given":"C."},{"family":"S.","given":"Hall"}],"issued":{"date-parts":[["2007"]]}}},{"id":30378,"uris":["http://zotero.org/groups/2344805/items/SX2DVPI5"],"itemData":{"id":30378,"type":"article-journal","container-title":"Environments","issue":"1","language":"en","page":"5","title":"Alternatives to conventional management: Lessons from small-scale fisheries","volume":"31","author":[{"family":"Berkes","given":"F."}],"issued":{"date-parts":[["2003"]]}}},{"id":30393,"uris":["http://zotero.org/groups/2344805/items/WAUMA9ZM"],"itemData":{"id":30393,"type":"article-journal","container-title":"FAO Fisheries Technical Paper","issue":"489","language":"en","note":"publisher: FAO, Rome","page":"152","title":"Human dimensions of the ecosystem approach to fisheries: an overview of context, concepts, tools and methods","author":[{"family":"Young","given":"C.","non-dropping-particle":"de"},{"family":"Charles","given":"A."},{"family":"Hjort","given":"A."}],"issued":{"date-parts":[["2008"]]}}},{"id":34675,"uris":["http://zotero.org/groups/2344805/items/3VZ7LHJU"],"itemData":{"id":34675,"type":"article-journal","abstract":"Consideration of subsistence ?shing activities seems particularly relevant to coastal ?sheries policy, yet formal recognition of subsistence ?shing is often absent from associated policy frameworks. A critical problem is the very meaning of the term ‘‘subsistence.’’ A review of the literature on subsistence, dominated until recently by North American research, reveals a schism between interpretations emphasizing material aspects of subsistence and interpretations highlighting cultural aspects. The North American literature on the subject is heavily in?uenced by a focus on Arctic indigenous populations emphasizing cultural survival. Ultimately, subsistence can be a matter of survival in the belly, the soul, or both. International case studies suggest that different interpretations of subsistence are appropriate in different circumstances, and that appropriate policy can be fashioned only after the local context of subsistence is understood.","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2006.12.010","ISSN":"0308597X","issue":"6","journalAbbreviation":"Marine Policy","language":"en","page":"706-718","source":"DOI.org (Crossref)","title":"Subsistence in coastal fisheries policy: What's in a word?","title-short":"Subsistence in coastal fisheries policy","URL":"https://linkinghub.elsevier.com/retrieve/pii/S0308597X07000176","volume":"31","author":[{"family":"Schumann","given":"Sarah"},{"family":"Macinko","given":"Seth"}],"accessed":{"date-parts":[["2021",3,29]]},"issued":{"date-parts":[["2007",11]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Guidance documents such as the Food and Agriculture Organization of the United Nations (FAO) Code of Conduct for Responsible Fisheries in 1995 were found to give insufficient attention to social aspects of the sustainability of fishing. Publications such as ITEM CSL_CITATION {"citationID":"eXOUfigy","properties":{"formattedCitation":"(Berkes, 2001; Kurien, 2007)","plainCitation":"(Berkes, 2001; Kurien, 2007)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":32976,"uris":["http://zotero.org/groups/2344805/items/YY6ACT9M"],"itemData":{"id":32976,"type":"article-journal","container-title":"IDRC","language":"en","title":"Managing small-scale fisheries: alternative directions and methods","URL":"http://hdl.handle.net/10625/31968","author":[{"family":"Berkes","given":"F."},{"family":"Mahon","given":"R."},{"family":"McConney","given":"P."},{"family":"Pollnac","given":"R."},{"family":"Pomeroy","given":"R."}],"issued":{"date-parts":[["2001"]]}}},{"id":30614,"uris":["http://zotero.org/groups/2344805/items/NF498KT4"],"itemData":{"id":30614,"type":"chapter","container-title":"Reclaiming nature – environmental justice and ecological restoration","event-place":"Stanton","language":"en","page":"23–52","publisher":"Anthem Press","publisher-place":"Stanton","title":"The blessing of the commons: small-scale fisheries, community property rights and coastal natural assets","author":[{"family":"Kurien","given":"J."}],"editor":[{"family":"Boyce","given":"J.K."},{"family":"Narain","given":"S."},{"literal":"E.A."}],"issued":{"date-parts":[["2007"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; contributed to the guidelines on small-scale fisheries ITEM CSL_CITATION {"citationID":"SNrhLj4Y","properties":{"formattedCitation":"(FAO, 2015)","plainCitation":"(FAO, 2015)","noteIndex":0},"citationItems":[{"id":30673,"uris":["http://zotero.org/groups/2344805/items/9QM368CL"],"itemData":{"id":30673,"type":"book","event-place":"Rome, Italy","ISBN":"978-92-5-108704-6","language":"en","number-of-pages":"35","publisher-place":"Rome, Italy","title":"Voluntary Guidelines for Securing Sustainable Small-Scale Fisheries in the Context of Food Security and Poverty Eradication","URL":"https://www.fao.org/documents/card/en/c/I4356EN","author":[{"literal":"FAO"}],"accessed":{"date-parts":[["2022",4,18]]},"issued":{"date-parts":[["2015"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Nevertheless, there continued to be calls for more input from experts on the social aspects of fishing outcomes and greater use of knowledge of indigenous peoples and local communities ITEM CSL_CITATION {"citationID":"9DlyHNuD","properties":{"formattedCitation":"(B\\\\uc0\\\\u233{}n\\\\uc0\\\\u233{}, 2010; de Young, 2008)","plainCitation":"(Béné, 2010; de Young, 2008)","noteIndex":0},"citationItems":[{"id":30403,"uris":["http://zotero.org/groups/2344805/items/9CHWP77R"],"itemData":{"id":30403,"type":"article-journal","container-title":"Development Policy Review","language":"en","page":"325–358","title":"Not by Rent Alone: Analysing the Pro-Poor Functions of Small-Scale Fisheries in Developing Countries","volume":"28","author":[{"family":"Béné","given":"C."},{"family":"Allison","given":"E.H."},{"family":"Hersoug","given":"B."}],"issued":{"date-parts":[["2010"]]}}},{"id":30393,"uris":["http://zotero.org/groups/2344805/items/WAUMA9ZM"],"itemData":{"id":30393,"type":"article-journal","container-title":"FAO Fisheries Technical Paper","issue":"489","language":"en","note":"publisher: FAO, Rome","page":"152","title":"Human dimensions of the ecosystem approach to fisheries: an overview of context, concepts, tools and methods","author":[{"family":"Young","given":"C.","non-dropping-particle":"de"},{"family":"Charles","given":"A."},{"family":"Hjort","given":"A."}],"issued":{"date-parts":[["2008"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}.
      This was the landscape of points of general agreement in 2010 with regard to how sustainable use was conceptualized for fishing. This is affirmed in the very specific language of Aichi Biodiversity Target 6, in 2010. Among the first targets to be adopted at the 10th Conference of the Parties, it states: “by 2020 all fish and invertebrate stocks and aquatic plants are managed and harvested sustainably, legally and applying ecosystem based approaches, so that overfishing is avoided, recovery plans and measures are in place for all depleted species, fisheries have no significant adverse impacts on threatened species and vulnerable ecosystems and the impacts of fisheries on stocks, species and ecosystems are within safe ecological limits.” 
      It confirms in policy that sustainable fishing consider harvesting rate, provision for recovery of depleted stocks, bycatches and habitat impacts, particularly for species and habitats of special concern, and that the combinations of management measures and provisions can be integrated in an ecosystem approach; all themes which the expert literature had stressed as important. The benchmarks: “no serious adverse impacts” and “within safe ecological limits” came from earlier agreements, respectively the United Nations Sustainable Fisheries Resolution 61/105, which required bottom-contacting fishing gears to cause “no serious adverse impacts” on “vulnerable marine ecosystems” (https://undocs.org/A/RES/61/105), and the Marine Strategy Framework Directive of the European Union (https://ec.europa.eu/environment/marine/eu-coast-and-marine-policy/marine-strategy-framework-directive/index_en.htm), which required impacts of uses of marine resources in waters of the European Union to be within “safe ecological limits”. These benchmarks reflect the availability of evidence-based guidance on what comprised a serious adverse impact ITEM CSL_CITATION {"citationID":"Mqzm0uWd","properties":{"formattedCitation":"(FAO, 2013; J. C. Rice, 2015)","plainCitation":"(FAO, 2013; J. C. Rice, 2015)","noteIndex":0},"citationItems":[{"id":30375,"uris":["http://zotero.org/groups/2344805/items/CVCUKCJ7"],"itemData":{"id":30375,"type":"article-journal","container-title":"FAO Fisheries and Aquaculture Report","issue":"1018","language":"en","note":"publisher-place: Rome","page":"41","title":"Workshop for the Development of a Global Database for Vulnerable Marine Ecosystems","author":[{"literal":"FAO"}],"issued":{"date-parts":[["2013"]]}}},{"id":30624,"uris":["http://zotero.org/groups/2344805/items/LDVSQAYF"],"itemData":{"id":30624,"type":"chapter","container-title":"Governance of Marine Fisheries and Conservation of Biodiversity","event-place":"London","language":"en","page":"81","publisher":"Wiley","publisher-place":"London","title":"Parallel Initiatives: the CBD Ecologically or Biologically Significant Areas and FAO’ Vulnerable Marine Ecosystems criteria and processes","author":[{"family":"Rice","given":"J.C."},{"family":"Lee","given":"J."},{"family":"Tandstad","given":"M."}],"editor":[{"family":"Garcia","given":"S.M."},{"family":"Rice","given":"J.C."},{"family":"Charles","given":"A.T."}],"issued":{"date-parts":[["2015"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}, and “safe ecological limits” in general ITEM CSL_CITATION {"citationID":"DNJOeb7X","properties":{"formattedCitation":"(European Commission, 2011)","plainCitation":"(European Commission, 2011)","noteIndex":0},"citationItems":[{"id":30377,"uris":["http://zotero.org/groups/2344805/items/XNEU4AJA"],"itemData":{"id":30377,"type":"book","language":"en","publisher":"Publications Office","title":"Scientific Support To The European Commission On The Marine Strategy Framework Directive: Management Group Report, March 2010","URL":"https://op.europa.eu/en/publication-detail/-/publication/ce197957-b77d-4507-a756-7b4f680c7cd1/language-en","author":[{"family":"European Commission","given":""},{"family":"Joint Research Centre","given":""},{"family":"Cardoso","given":"A.C."},{"family":"Cochrane","given":"S."},{"family":"Doerner","given":"H."},{"family":"Ferreira","given":"J.G."},{"family":"Galgani","given":"F."},{"family":"Hagebro","given":"C."},{"family":"Hanke","given":"S."},{"family":"Hoepffner","given":"N."},{"family":"Keizer","given":"P.D."},{"family":"Law","given":"R."},{"family":"Olenin","given":"S."},{"family":"Piet","given":"G."},{"family":"Rice","given":"J."},{"family":"Rogers","given":"J."},{"family":"Swartenbroux","given":"S.I."},{"family":"Tasker","given":"S.W."},{"family":"Bund","given":"W."}],"editor":[{"family":"Piha","given":"H."}],"accessed":{"date-parts":[["2022",4,18]]},"issued":{"date-parts":[["2011"]]}}}],"schema":"https://github.com/ci