me":"47","author":[{"family":"Muallil","given":"R.N."},{"family":"Mamauag","given":"S.S."},{"family":"Cababaro","given":"J.T."},{"family":"Arceo","given":"H.O."},{"family":"Aliño","given":"P.M."}],"issued":{"date-parts":[["2014"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [37] ITEM CSL_CITATION {"citationID":"snhSveA5","properties":{"formattedCitation":"(O\\\\uc0\\\\u8217{}Donnell, 2012)","plainCitation":"(O’Donnell, 2012)","noteIndex":0},"citationItems":[{"id":31716,"uris":["http://zotero.org/groups/2344805/items/IMNC98Q2"],"itemData":{"id":31716,"type":"article-journal","archive":"Scopus","container-title":"Coastal Management","DOI":"10.1080/08920753.2012.727734","issue":"6","page":"594-611","title":"Comparing Fisher Interviews, Logbooks, and Catch Landings Estimates of Extraction Rates in a Small-Scale Fishery","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84868265819&doi=10.1080%2f08920753.2012.727734&partnerID=40&md5=ad8d271ce5cfe17e3269d685d23c03d3","volume":"40","author":[{"family":"O'Donnell","given":"K.P."},{"family":"Molloy","given":"P.P."},{"family":"Vincent","given":"A.C.J."}],"issued":{"date-parts":[["2012"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [38] ITEM CSL_CITATION {"citationID":"EvjsHhS6","properties":{"formattedCitation":"(Webster, 2017)","plainCitation":"(Webster, 2017)","noteIndex":0},"citationItems":[{"id":357,"uris":["http://zotero.org/groups/2344805/items/69EEYSQU"],"itemData":{"id":357,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Research","DOI":"10.1016/j.fishres.2016.08.026","page":"168-176","title":"Detecting fisheries trends in a co-managed area in the Kingdom of Tonga","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84984675566&doi=10.1016%2fj.fishres.2016.08.026&partnerID=40&md5=dd3d3448a40c5b5329829689a6c5c647","volume":"186","author":[{"family":"Webster","given":"F.J."},{"family":"Cohen","given":"P.J."},{"family":"Malimali","given":"S."},{"family":"Tautai","given":"M."},{"family":"Vidler","given":"K."},{"family":"Mailau","given":"S."},{"family":"Vaipuna","given":"L."},{"family":"Fatongiatau","given":"V."}],"issued":{"date-parts":[["2017"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [39] ITEM CSL_CITATION {"citationID":"8YeJFFD2","properties":{"formattedCitation":"(Santos Thykjaer, dos Santos Rodrigues, Haimovici, & Cardoso, 2019)","plainCitation":"(Santos Thykjaer, dos Santos Rodrigues, Haimovici, & Cardoso, 2019)","noteIndex":0},"citationItems":[{"id":1089,"uris":["http://zotero.org/groups/2344805/items/NQW6NRI5"],"itemData":{"id":1089,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Management and Ecology","DOI":"10.1111/fme.12398","title":"Long-term changes in fishery resources of an estuary in southwestern Atlantic according to local ecological knowledge","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85075733062&doi=10.1111%2ffme.12398&partnerID=40&md5=373c76110b9153f491498366fa2fdbcb","author":[{"family":"Santos Thykjaer","given":"V."},{"family":"Santos Rodrigues","given":"L.","non-dropping-particle":"dos"},{"family":"Haimovici","given":"M."},{"family":"Cardoso","given":"L.G."}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [40] ITEM CSL_CITATION {"citationID":"EIaTF2o0","properties":{"formattedCitation":"(G. Hallwass, 2019)","plainCitation":"(G. Hallwass, 2019)","noteIndex":0},"citationItems":[{"id":382,"uris":["http://zotero.org/groups/2344805/items/2T4NL3H7"],"itemData":{"id":382,"type":"article-journal","abstract":"The local ecological knowledge (LEK) of ?shermen has been applied to reconstruct temporal patterns of resource abundance and to assess resource exploitation, especially in tropical ecosystems. Protected areas (PAs) are the main conservation measure in the Amazon, but their ef?cacy to improve ?sheries is poorly known. The main goal of this study was to apply ?shermen’ LEK to evaluate temporal changes in composition and abundance of exploited ?sh species among three different categories of PAs in the Tapajo s River, Brazilian Amazon. We interviewed 203 ?shers about their highest ?sh catches, and the main ?sh caught at two time periods: the beginning of their ?shing careers and currently. Fishers’ LEK indicated decreases in citations of larger-bodied ?shes and in reported catches over time, evidencing a gradient of conservation according to PA’s time of establishment and management rules. We noticed higher changes (reduced catches and smaller ?sh exploited) in the Environmental PA, established 10 years ago and lacking management plan and buffer zone. In National Forest, which was created 40 years ago with more restrictive management rules, ?sh composition and catches included larger commercial ?sh. The Extractive Reserve, which was created 15 years ago and lacks speci?c ?shing rules, may be in an intermediate stage, as large ?sh and highest catches decreased over time, but medium and large ?sh are still exploited. Fishers’ LEK can be an invaluable but neglected source of data on temporal patterns of ?shing pressure and conservation needs, especially in tropical megadiverse, poorly known and threatened rivers.","container-title":"Animal Conservation","DOI":"10.1111/acv.12504","ISSN":"1367-9430, 1469-1795","journalAbbreviation":"Anim Conserv","language":"en","page":"acv.12504","source":"DOI.org (Crossref)","title":"Fishers’ knowledge indicates temporal changes in composition and abundance of fishing resources in Amazon protected areas","URL":"https://onlinelibrary.wiley.com/doi/abs/10.1111/acv.12504","author":[{"family":"Hallwass","given":"G."},{"family":"Schiavetti","given":"A."},{"family":"Silvano","given":"R. A. M."}],"accessed":{"date-parts":[["2019",8,8]]},"issued":{"date-parts":[["2019",4,11]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [41] ITEM CSL_CITATION {"citationID":"aotc3tgmv8","properties":{"formattedCitation":"(Damasio, 2015)","plainCitation":"(Damasio, 2015)","noteIndex":0},"citationItems":[{"id":31730,"uris":["http://zotero.org/groups/2344805/items/BJUS6UF3"],"itemData":{"id":31730,"type":"article-journal","abstract":"Background In small-scale fishery, information provided by fishers has been useful to complement current and past lack of knowledge on species and environment.\\nMethodology Through interviews, 82 fishers from the largest fishing communities on the north and south borders of a Brazilian northeastern coastal state provided estimates of the catch per unit effort (CPUE) and rank of species abundance of their main target fishes for three time points: current year (2013 at the time of the research), 10, and 20 years past. This information was contrasted to other available data sources: scientific sampling of fish landing (2013), governmental statistics (2003), and information provided by expert fishers (1993), respectively. Principal Findings Fishers were more accurate when reporting information about their maximum CPUE for 2013, but except for three species, which they estimated accurately, fishers overestimated their mean CPUE per species. Fishers were also accurate at establishing ranks of abundance of their main target species for all periods. Fishers' beliefs that fish abundance has not changed over the last 10 years (2003–2013) were corroborated by governmental and scientific landing data.\\nConclusions The comparison between official and formal landing records and fishers' perceptions revealed that fishers are accurate when reporting maximum CPUE, but not when reporting mean CPUE. Moreover, fishers are less precise the less common a species is in their","container-title":"PLOS ONE","DOI":"10.1371/journal.pone.0133122","ISSN":"1932-6203","issue":"7","journalAbbreviation":"PLoS ONE","language":"en","page":"e0133122","source":"DOI.org (Crossref)","title":"Matching Fishers’ Knowledge and Landing Data to Overcome Data Missing in Small-Scale Fisheries","URL":"https://dx.plos.org/10.1371/journal.pone.0133122","volume":"10","author":[{"family":"Damasio","given":"Ludmila de Melo Alves"},{"family":"Lopes","given":"Priscila F. M."},{"family":"Guariento","given":"Rafael D."},{"family":"Carvalho","given":"Adriana R."}],"editor":[{"family":"Stergiou","given":"Konstantinos I"}],"accessed":{"date-parts":[["2019",8,8]]},"issued":{"date-parts":[["2015",7,15]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [42] ITEM CSL_CITATION {"citationID":"v6RO5ptk","properties":{"formattedCitation":"(Strieder Philippsen, 2017)","plainCitation":"(Strieder Philippsen, 2017)","noteIndex":0},"citationItems":[{"id":1087,"uris":["http://zotero.org/groups/2344805/items/M3NVXDYA"],"itemData":{"id":1087,"type":"article-journal","archive":"Scopus","container-title":"Marine and Freshwater Research","DOI":"10.1071/MF16053","issue":"5","page":"980-992","title":"Fishers' and scientific histories: An example of consensus from an inland fishery","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85018262780&doi=10.1071%2fMF16053&partnerID=40&md5=6e52ce85acf3e8f7dedaf166b96e8e14","volume":"68","author":[{"family":"Strieder Philippsen","given":"J."},{"family":"Minte-Vera","given":"C.V."},{"family":"Okada","given":"E.K."},{"family":"Carvalho","given":"A.R."},{"family":"Angelini","given":"R."}],"issued":{"date-parts":[["2017"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [43] ITEM CSL_CITATION {"citationID":"E8lD33Gz","properties":{"formattedCitation":"(Barbosa-Filho, 2020)","plainCitation":"(Barbosa-Filho, 2020)","noteIndex":0},"citationItems":[{"id":34918,"uris":["http://zotero.org/groups/2344805/items/BAITNNUM"],"itemData":{"id":34918,"type":"article-journal","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2019.105025","title":"Evidence of shifting baseline and Fisher judgment on lane snapper (Lutjanus synagris) management in a Brazilian marine protected area","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85074530717&doi=10.1016%2fj.ocecoaman.2019.105025&partnerID=40&md5=3c216b9020fa44d107f70dc930e50806","volume":"183","author":[{"family":"Barbosa-Filho","given":"M.L.V."},{"family":"Souza","given":"G.B.G.","non-dropping-particle":"de"},{"family":"Lopes","given":"S.D.F."},{"family":"Siciliano","given":"S."},{"family":"Hauser Davis","given":"R.A."},{"family":"Mourão","given":"J.D.S."}],"issued":{"date-parts":[["2020"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [44] ITEM CSL_CITATION {"citationID":"7kar2oRr","properties":{"formattedCitation":"(de Souza Junior, Nunes, & Silvano, 2020)","plainCitation":"(de Souza Junior, Nunes, & Silvano, 2020)","noteIndex":0},"citationItems":[{"id":1097,"uris":["http://zotero.org/groups/2344805/items/LIXVXRVT"],"itemData":{"id":1097,"type":"article-journal","archive":"Scopus","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2020.103870","title":"Biology, ecology and behavior of the acoupa weakfish Cynoscion acoupa (Lacepède, 1801) according to the local knowledge of fishermen in the northern coast of Brazil","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85079524865&doi=10.1016%2fj.marpol.2020.103870&partnerID=40&md5=defa5444ee38d9abb3aa09da283334c9","author":[{"family":"Souza Junior","given":"O.G.","non-dropping-particle":"de"},{"family":"Nunes","given":"J.L.G."},{"family":"Silvano","given":"R.A.M."}],"issued":{"date-parts":[["2020"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [45] ITEM CSL_CITATION {"citationID":"OUkI1QSH","properties":{"formattedCitation":"(Giglio & Bornatowski, 2016)","plainCitation":"(Giglio & Bornatowski, 2016)","noteIndex":0},"c