ms/4F3DPD2A"],"itemData":{"id":19217,"type":"article-journal","container-title":"Journal of ethnobiology and ethnomedicine","issue":"1","language":"en","page":"1–16","title":"Use of columnar cacti in the Tehuacán Valley, Mexico: perspectives for sustainable management of non-timber forest products","volume":"10","author":[{"family":"Pérez-Negrón","given":"E."},{"family":"Dávila","given":"P."},{"family":"Casas","given":"A."}],"issued":{"date-parts":[["2014"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. 
      Protecting habitat for gathered species will be especially important for the long-term sustainability of gathering ITEM CSL_CITATION {"citationID":"am22ebi0p","properties":{"unsorted":true,"formattedCitation":"(Rist, 2010; Klauberg, 2014; Garc\\\\uc0\\\\u237{}a, 2016; Isaza, 2016; Munt, 2016; Isaza, 2017; Bond\\\\uc0\\\\u233{}, 2020; Sinasson, 2021)","plainCitation":"(Rist, 2010; Klauberg, 2014; García, 2016; Isaza, 2016; Munt, 2016; Isaza, 2017; Bondé, 2020; Sinasson, 2021)","noteIndex":0},"citationItems":[{"id":19220,"uris":["http://zotero.org/groups/2344805/items/F2URC8GK"],"itemData":{"id":19220,"type":"article-journal","container-title":"Forest Ecology and Management","issue":"12","language":"fr","page":"2224–2231","title":"Sustainable harvesting of coco de mer, Lodoicea maldivica, in the Vallée de Mai, Seychelles","volume":"260","author":[{"family":"Rist","given":"L."},{"family":"Kaiser-Bunbury","given":"C.N."},{"family":"Fleischer-Dogley","given":"F."},{"family":"Edwards","given":"P."},{"family":"Bunbury","given":"N."},{"family":"Ghazoul","given":"J."}],"issued":{"date-parts":[["2010"]]}}},{"id":19486,"uris":["http://zotero.org/groups/2344805/items/4AWV8LVM"],"itemData":{"id":19486,"type":"article-journal","container-title":"Agricultural Systems","language":"en","page":"116–122","title":"Determining the optimal harvest cycle for copaíba (Copaifera spp.) oleoresin production","volume":"131","author":[{"family":"Klauberg","given":"C."},{"family":"Vidal","given":"E."},{"family":"Rodriguez","given":"L.C."},{"family":"Diaz-Balteiro","given":"L."}],"issued":{"date-parts":[["2014"]]}}},{"id":19470,"uris":["http://zotero.org/groups/2344805/items/R9MAF4BG"],"itemData":{"id":19470,"type":"article-journal","container-title":"Biotropica","issue":"5","language":"es","page":"598–607","title":"Demography and sustainable management of two fiber?producing Astrocaryum palms in Colombia","volume":"48","author":[{"family":"García","given":"N."},{"family":"Zuidema","given":