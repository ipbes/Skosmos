ITEM CSL_CITATION {"citationID":"a150f9itl3p","properties":{"formattedCitation":"(Braden, 2014)","plainCitation":"(Braden, 2014)","noteIndex":0},"citationItems":[{"id":31049,"uris":["http://zotero.org/groups/2344805/items/2VNX2HEQ"],"itemData":{"id":31049,"type":"article-journal","abstract":"Poaching in Russia has been reported to be of catastrophic proportions and threatens maintenance of biodiversity. Management of game species has stabilized some numbers, but both endangered species listed in the Russian Red Book and animals traditionally viewed as hunting prey are diminishing in some regions. Rank-and-file hunters, increasingly shut off from access to hunting grounds, have expressed a negative reaction to new hunting regulations adopted by the Russian government in 2012. While high-profile poaching incidents by so-called “VIP hunters” do not apparently make up a large portion of cases, the symbolism of the alleged crimes has a derogatory impact on ordinary hunters because lawlessness is reinforced by perceptions of impunity for elite poachers.","container-title":"Eurasian Geography and Economics","DOI":"10.1080/15387216.2015.1020320","ISSN":"1538-7216","issue":"5","note":"publisher: Routledge\\n_eprint: https://doi.org/10.1080/15387216.2015.1020320","page":"457-490","source":"Taylor and Francis+NEJM","title":"Illegal recreational hunting in Russia: the role of social norms and elite violators","title-short":"Illegal recreational hunting in Russia","URL":"https://doi.org/10.1080/15387216.2015.1020320","volume":"55","author":[{"family":"Braden","given":"Kathleen"}],"accessed":{"date-parts":[["2021",3,13]]},"issued":{"date-parts":[["2014",9,3]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} 
