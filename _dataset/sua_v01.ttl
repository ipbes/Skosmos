ily":"Herrera-Pavon","given":"Roberto"}],"issued":{"date-parts":[["2018"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} or to assess bycatch rates and mortality of the Ganges River dolphins (Platanista gangetica gangetica) ITEM CSL_CITATION {"citationID":"a9kjacsgkr","properties":{"formattedCitation":"(Dewhurst\\\\uc0\\\\u8208{}Richman, 2020)","plainCitation":"(Dewhurst?Richman, 2020)","noteIndex":0},"citationItems":[{"id":31751,"uris":["http://zotero.org/groups/2344805/items/RHKFN35A"],"itemData":{"id":31751,"type":"article-journal","container-title":"Animal Conservation","ISSN":"1367-9430","issue":"2","journalAbbreviation":"Animal Conservation","page":"160-170","title":"Fishing for the facts: river dolphin bycatch in a small?scale freshwater fishery in Bangladesh","volume":"23","author":[{"family":"Dewhurst?Richman","given":"NI"},{"family":"Jones","given":"JPG"},{"family":"Northridge","given":"Simon"},{"family":"Ahmed","given":"B"},{"family":"Brook","given":"S"},{"family":"Freeman","given":"R"},{"family":"Jepson","given":"P"},{"family":"Mahood","given":"SP"},{"family":"Turvey","given":"ST"}],"issued":{"date-parts":[["2020"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. These ecological data provided by fishers could also be useful to assess sustainability of small-scale fisheries and improve their management. 
	A promising way forward to better integrate fishers’ local ecological knowledge and provide needed data about poorly known small-scale fisheries includes collaborations with fishers. This could include participatory monitoring that facilitates fisher involvement in abundance surveys and recording catch, size and information on reproduction of fisheries resources, and occurrence of bycatch ITEM CSL_CITATION {"citationID":"6ofKEqFh","properties":{"formattedCitation":"(Alpina Begossi, Salivonchyk, & Silvano, 2016; Cuevas, 2018; A. C. E. Dias, Cinti, Parma, & Seixas, 2020; Friedrich Wofgang Keppeler, Hallwass, Santos, da Silva, & Silvano, 2020; F.W. Keppeler, Hallwass, & Silvano, 2017; Obura, Wells, Church, & Horrill, 2002; O\\\\uc0\\\\u8217{}Donnell, 2012; Schemmel, 2016; Renato A.M. Silvano, 2020; Renato Azevedo Matias Silvano & Hallwass, 2020; Webster, 2017)","plainCitation":"(Alpina Begossi, Salivonchyk, & Silvano, 2016; Cuevas, 2018; A. C. E. Dias, Cinti, Parma, & Seixas, 2020; Friedrich Wofgang Keppeler, Hallwass, Santos, da Silva, & Silvano, 2020; F.W. Keppeler, Hallwass, & Silvano, 2017; Obura, Wells, Church, & Horrill, 2002; O’Donnell, 2012; Schemmel, 2016; Renato A.M. Silvano, 2020; Renato Azevedo Matias Silvano & Hallwass, 2020; Webster, 2017)","noteIndex":0},"citationItems":[{"id":31760,"uris":["http://zotero.org/groups/2344805/items/6UDCIY82"],"itemData":{"id":31760,"type":"article-journal","container-title":"J Coast Zone Manag","issue":"428","journalAbbreviation":"J Coast Zone Manag","page":"21-23","title":"Collaborative Research on dusky grouper (Epinephelus marginatus): Catches from the small-scale fishery of Copacabana Beach, Rio de Janeiro, Brazil","volume":"19","author":[{"family":"Begossi","given":"Alpina"},{"family":"Salivonchyk","given":"S"},{"family":"Silvano","given":"RAM"}],"issued":{"date-parts":[["2016"]]}},"label":"page"},{"id":31763,"uris":["http://zotero.org/groups/2344805/items/R8KC3M93"],"itemData":{"id":31763,"type":"article-journal","c