The rapid declines in biodiversity and degradation of ecosystem functions and global environmental commons, such as climate and water resources, heavily affect human wellbeing ITEM CSL_CITATION {"citationID":"QbhRBhHz","properties":{"formattedCitation":"(IPBES, 2019d; Millenium Ecosystem Assessment, 2005)","plainCitation":"(IPBES, 2019d; Millenium Ecosystem Assessment, 2005)","noteIndex":0},"citationItems":[{"id":70,"uris":["http://zotero.org/groups/2344805/items/W8MUUZXN"],"itemData":{"id":70,"type":"book","event-place":"Bonn, Germany","ISBN":"978-3-947851-13-3","publisher":"Secretariat of the Intergovernmental Science-Policy Platform on Biodiversity and Ecosystem Services","publisher-place":"Bonn, Germany","title":"Summary for policymakers of the global assessment report on biodiversity and ecosystem services of the Intergovernmental Science-Policy Platform on Biodiversity and Ecosystem Services","URL":"https://doi.org/10.5281/zenodo.3831673","author":[{"family":"IPBES","given":""}],"contributor":[{"family":"Díaz","given":"S."},{"family":"Settele","given":"J."},{"family":"Brondizio","given":"E."},{"family":"Ngo","given":"H."},{"family":"Guèze","given":"M."},{"family":"Agard","given":"J."},{"family":"Arneth","given":"A."},{"family":"Balvanera","given":"P."},{"family":"Brauman","given":"K. A."},{"family":"Butchart","given":"S. H. M."},{"family":"Chan","given":"K. M. A."},{"family":"Garibaldi","given":"L. A."},{"family":"Ichii","given":"K."},{"family":"Liu","given":"J."},{"family":"Subramanian","given":"S. M."},{"family":"Midgley","given":"G. F."},{"family":"Miloslavich","given":"P."},{"family":"Molnár","given":"Z"},{"family":"Obura","given":"D."},{"family":"Pfaff","given":"A."},{"family":"Polasky","given":"F."},{"family":"Purvis","given":"A."},{"family":"Razzaque","given":"J."},{"family":"Reyers","given":"B."},{"family":"Roy Chowdhury","given":"R."},{"family":"Shin","given":"Y. J."},{"family":"Visseren-Hamakers","given":"I. J."},{"family":"Willis","given":"K. J."},{