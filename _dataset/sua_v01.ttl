ITEM CSL_CITATION {"citationID":"a4c8dje8nn","properties":{"formattedCitation":"(Bodmer & Lozano, 2001)","plainCitation":"(Bodmer & Lozano, 2001)","noteIndex":0},"citationItems":[{"id":30859,"uris":["http://zotero.org/groups/2344805/items/42UJ7KZJ"],"itemData":{"id":30859,"type":"article-journal","container-title":"Conservation Biology","DOI":"10.1046/j.1523-1739.2001.0150041163.x","ISSN":"0888-8892, 1523-1739","issue":"4","journalAbbreviation":"Conservation Biology","language":"en","page":"1163-1170","source":"DOI.org (Crossref)","title":"Rural Development and Sustainable Wildlife Use in Peru","URL":"http://doi.wiley.com/10.1046/j.1523-1739.2001.0150041163.x","volume":"15","author":[{"family":"Bodmer","given":"Richard E."},{"family":"Lozano","given":"Etersit Pezo"}],"accessed":{"date-parts":[["2020",6,3]]},"issued":{"date-parts":[["2001",8,3]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} 
