ITEM CSL_CITATION {"citationID":"a1nogkpdl1","properties":{"formattedCitation":"(Mattsson, 2008; Mensah & Elofsson, 2017)","plainCitation":"(Mattsson, 2008; Mensah & Elofsson, 2017)","noteIndex":0},"citationItems":[{"id":31046,"uris":["http://zotero.org/groups/2344805/items/NAJEBPUC"],"itemData":{"id":31046,"type":"book","language":"sv","note":"Google-Books-ID: ja9VNQAACAAJ","number-of-pages":"40","publisher":"Adaptiv förvaltning av vilt och fisk, Sveriges lantbruksuniversitet","source":"Google Books","title":"Jakten i Sverige: ekonomiska värden och attityder jaktåret 2005/06","title-short":"Jakten i Sverige","author":[{"family":"Mattsson","given":"Leif"}],"issued":{"date-parts":[["2008"]]}}},{"id":31050,"uris":["http://zotero.org/groups/2344805/items/FPIBKMWT"],"itemData":{"id":31050,"type":"article-journal","abstract":"Game species generate considerable benefits to society in terms of hunting values, tourism, and maintenance of ecosystem balance. This paper seeks to estimate hunting values for multiple hunted species by disentangling the role of wildlife harvesting opportunities from other factors that affect hunting lease prices. We examine the determinants of hunting lease prices in Sweden using both spatial and nonspatial econometric techniques. Our analysis confirms considerable hunting values for fallow deer and wild boar. Also, the study reveals the presence of spatial spillovers in lease prices, implying that landowners have little scope for exerting monopoly power on the hunting lease market.","container-title":"Land Economics","issue":"2","language":"en","note":"publisher: University of Wisconsin Press","page":"292-308","source":"ideas.repec.org","title":"An Empirical Analysis of Hunting Lease Pricing and Value of Game in Sweden","URL":"https://ideas.repec.org/a/uwp/landec/v93y2017i2p292-308.html","volume":"93","author":[{"family":"Mensah","given":"Justice Tei"},{"family":"Elofsson","given":"Katarina"}],"accessed":{"date-parts":[["2021",3,13]]},"issued":{