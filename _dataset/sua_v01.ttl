.org/groups/2344805/items/TEUB24GR"],"itemData":{"id":19205,"type":"article-journal","container-title":"Ambio","issue":"9","language":"en","page":"1681–1697","title":"Sustainability of wild plant use in the Andean Community of South America","volume":"50","author":[{"family":"Kor","given":"L."},{"family":"Homewood","given":"K."},{"family":"Dawson","given":"T.P."},{"family":"Diazgranados","given":"M."}],"issued":{"date-parts":[["2021"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}.
 
5.4.3.7 Cultural
Gathering has particular importance in the culture, myths, identity and spiritual practices of communities throughout the world including, but not exclusively, indigenous peoples. Notwithstanding this importance, less than half of studies examined in a systematic review of the literature on the social-ecological sustainability of non-timber forest products mention cultural dimensions of gathering ITEM CSL_CITATION {"citationID":"gOHUNv89","properties":{"formattedCitation":"(de Mello, 2020)","plainCitation":"(de Mello, 2020)","noteIndex":0},"citationItems":[{"id":7469,"uris":["http://zotero.org/groups/2344805/items/TV355YM2"],"itemData":{"id":7469,"type":"article-journal","container-title":"Forest Policy and Economics","DOI":"10.1016/j.forpol.2020.102109","ISSN":"13899341","journalAbbreviation":"Forest Policy and Economics","language":"en","page":"102109","source":"DOI.org (Crossref)","title":"Social-ecological sustainability of non-timber forest products: A review and theoretical considerations for future research","title-short":"Social-ecological sustainability of non-timber forest products","volume":"112","author":[{"family":"Mello","given":"Natália Girão Rodrigues","non-dropping-particle":"de"},{"family":"Gulinck","given":"Hubert"},{"family":"Van den Broeck","given":"Pieter"},{"family":"Parra","given":"Constanza"}],"issued":{"date-parts":[["2020",3]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} although it is a common focus of research in the fields of ethnobotany ITEM CSL_CITATION {"citationID":"Dn0H9tNN","properties":{"formattedCitation":"(Balick & Cox, 2020)","plainCitation":"(Balick & Cox, 2020)","noteIndex":0},"citationItems":[{"id":19171,"uris":["http://zotero.org/groups/2344805/items/9JJGNJ7U"],"itemData":{"id":19171,"type":"book","event-place":"New York","language":"en","note":"DOI: 10.1201/9781003049074","publisher":"Garland","publisher-place":"New York","title":"Plants, People, and Culture: The Science of Ethnobotany","author":[{"family":"Balick","given":"Michael J."},{"family":"Cox","given":"Paul Alan"}],"issued":{"date-parts":[["2020"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} and biocultural diversity ITEM CSL_CITATION {"citationID":"9wd3YwIw","properties":{"formattedCitation":"(Baumflek, Kassam, Ginger, & Emery, 2021; Kassam, 2010)","plainCitation":"(Baumflek, Kassam, Ginger, & Emery, 2021; Kassam, 2010)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":19172,"uris":["http://zotero.org/groups/2344805/items/72CQ5ICS"],"itemData":{"id":19172,"type":"article-journal","container-title":"Society & Natural Resources","issue":"9","language":"en","note":"publisher-place: Maine, USA and New Brunswick, Canada","page":"1155–1173","title":"Incorporating Biocultural Approaches in Forest Management: Insights from a Case Study of Indigenous Plant Stewardship in","volume":"34","author":[{"family":"Baumflek","given":"M.J."},{"family":"Kassam","given":"K.-A."},{"family":"Ginger","given":"C."},{"family":"Emery","given":"M.R."}],"issued":{"date-parts":[["2021"]]}}},{"id":19201,"uris":["http://zotero.org/groups/2344805/items/XKSUBNY9"],"itemData":{"id":19201,"type":"article-journal","container-title":"Ecology & Society","issue":"2","language":"en","page":"8","title":"Pluralism, resilience, and the ecology of survival: case studies from the Pamir Mountains of Afghanistan","volume":"15","author":[{"family":"Kassam","given":"K.-A.S."}],"issued":{"date-parts":[["2010"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. While not explicitly included in the parameters of scenarios and models relevant to gathering, modeling studies frequently make mention of cultural uses of gathered materials. Examples include use of the leaves from the cycad Dioon merolae ITEM CSL_CITATION {"citationID":"a2g6ir1kr9u","properties":{"formattedCitation":"\\\\uldash{(de Luca, 1981)}","plainCitation":"(de Luca, 1981)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":20197,"uris":["http://zotero.org/groups/2344805/items/UMXHL25M"],"itemData":{"id":20197,"type":"article-journal","container-title":"Brittonia","DOI":"10.2307/2806317","ISSN":"0007196X","issue":"2","journalAbbreviation":"Brittonia","page":"179","source":"DOI.org (Crossref)","title":"Dioon Merolae (Zamiaceae), a New Species from Mexico","volume":"33","author":[{"family":"Luca","given":"Paolo","non-dropping-particle":"de"},{"family":"Sabato","given":"Sergio"},{"family":"Torres","given":"Mario Vazquez"}],"issued":{"date-parts":[["1981",4]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}(De Luca & Sabato; Nance 2009) for ceremonial purposes by indigenous and mestizo communities in Chiapas, México ITEM CSL_CITATION {"citationID":"kLpqE593","properties":{"formattedCitation":"(L\\\\uc0\\\\u225{}zaro-Zerme\\\\uc0\\\\u241{}o, 2011)","plainCitation":"(Lázaro-Zermeño, 2011)","noteIndex":0},"citationItems":[{"id":19491,"uris":["http://zotero.org/groups/2344805/items/RQTYB8SA"],"itemData":{"id":19491,"type":"article-journal","container-title":"Forest Ecology and Management","issue":"3","language":"en","page":"427–439","title":"Individual growth, reproduction and population dynamics of Dioon merolae (Zamiaceae) under different leaf harvest histories in Central Chiapas, Mexico","volume":"261","author":[{"family":"Lázaro-Zermeño","given":"J.M."},{"family":"González-Espinosa","given":"M."},{"family":"Mendoza","given":"A."},{"family":"Martínez-Ramos","given":"M."},{"family":"Quintana-Ascencio","given":"P.F."}],"issued":{"date-parts":[["2011"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} and ceremonial uses of ectomycorrhizal fungi ITEM CSL_CITATION {"citationID":"trsITPBS","properties":{"formattedCitation":"(P\\\\uc0\\\\u233{}rez\\\\uc0\\\\u8208{}Moreno, 2021)","plainCitation":"(Pérez?Moreno, 2021)","noteIndex":0},"citationItems":[{"id":20100,"uris":["http://zotero.org/groups/2344805/items/E35V4YCV"],"itemData":{"id":20100,"type":"article-journal","container-title":"PLANTS, PEOPLE, PLANET","DOI":"10.1002/ppp3.10199","ISSN":"2572-2611, 2572-2611","issue":"5","journalAbbreviation":"Plants People Planet","language":"en","page":"471-490","source":"DOI.org (Crossref)","title":"Edible mycorrhizal fungi of the world: What is their role in forest sustainability, food security, biocultural conservation and climate change?","title-short":"Edible mycorrhizal fungi of the world","volume":"3","author":[{"family":"Pérez?Moreno","given":"Jesús"},{"family":"Guerin?Laguette","given":"Alexis"},{"family":"Rinaldi","given":"Andrea C."},{"family":"Yu","given":"Fuqiang"},{"family":"Verbeken","given":"Annemieke"},{"family":"Hernández?Santiago","given":"Faustino"},{"family":"Martínez?Reyes","given":"Magdalena"}],"issued":{"date-parts":[["2021",9]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}, as well as tensions between commercialization and cultural values ITEM CSL_CITATION {"citationID":"3ti8ZOLi","properties":{"formattedCitation":"(Walsh & Douglas, 2011)","plainCitation":"(Walsh & Douglas, 2011)","noteIndex":0},"citationItems":[{"id":2525,"uris":["http://zotero.org/groups/2344805/items/BYDDK24W"],"itemData":{"id":2525,"type":"article-journal","abstract":"Improvement in Aboriginal people’s livelihoods and economic opportunities has been a major aim of increased research and development on bush foods over the past decade. But worldwide the development of trade in non-timber forest products from natural populations has raised questions about the ecological sustainability of harvest. Trade-offs and tensions between commercialisation and cultural values have also been found. We investigated the sustainability of the small-scale commercial harvest and trade in native plant products sourced from central Australian rangelands (including Solanum centrale J.M. Black, Acacia Mill. spp.). We used semi-structured interviews with traders and Aboriginal harvesters, participant observation of trading and harvesting trips, and analysis of species and trader records. An expert Aboriginal reference group guided the project. We found no evidence of either taxa being vulnerable to over-harvest. S. centrale production is enhanced by harvesting when it co-occurs with patch-burning. Extreme fluctuations in productivity of both taxa, due to inter-annual rainfall variability, have a much greater impact on supply than harvest effects. Landscape-scale degradation (including cattle grazing and wildfire) affected ecological sustainability according to participants. By contrast, we found that sustainability of bush food trade is more strongly impacted by social and economic factors. The relationship-based links between harvesters and traders are critical to monetary trade. Harvesters and traders identified access to productive lands and narrow economic margins between costs and returns as issues for the future sustainability of harvest and trade. Harvesters and the reference group emphasised that sustaining bush harvest relies on future generations having necessary knowledge and skills; these are extremely vulnerable to loss. Aboriginal people derive multiple livelihood benefits from harvest and trade. Aboriginal custodians and harvester groups involved in recent trade are more likely to benefit from research and development investment to inter-generational knowledge and skill transfer than from investments in plant breeding and commercial horticultural development. In an inductive comparison, our study found there to be strong alignment between key findings about the strategies used by harvesters and traders in bush produce and the ‘desert system’..","container-title":"The Rangeland Journal","DOI":"10.1071/RJ11028","ISSN":"1834-7541","issue":"4","journalAbbreviation":"Rangel. J.","language":"en","note":"publisher: CSIRO PUBLISHING","page":"395-416","source":"www.publish.csiro.au","title":"No bush foods without people: the essential human dimension to the sustainability of trade in native plant products from desert Australia","title-short":"No bush foods without people","volume":"33","author":[{"family":"Walsh","given":"Fiona"},{"family":"Douglas","given":"Josie"}],"issued":{"date-parts":[["2011",12,20]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. The effects of commercialization on the cultural values and ceremonial uses of gathered species has received little attention and remains an important knowledge gap.
      As the case of beargrass above illustrates ITEM CSL_CITATION {"citationID":"GjCH29FV","properties":{"formattedCitation":"(Hart\\\\uc0\\\\u8208{}Fredeluces, 2021)","plainCitation":"(Hart?Fredeluces, 2021)","noteIndex":0},"citationItems":[{"id":19191,"uris":["http://zotero.org/groups/2344805/items/CJCBTM79"],"itemData":{"id":19191,"type":"article-journal","container-title":"Journal of Ecology","issue":"3","language":"en","page":"1133–1147","title":"Simulated Indigenous fire stewardship increases the population growth rate of an understorey herb","volume":"109","author":[{"family":"Hart?Fredeluces","given":"G.M."},{"family":"Ticktin","given":"T."},{"family":"Lake","given":"F.K."}],"issued":{"date-parts":[["2021"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}, the knowledge base gatherers draw on can also exert a fundamental influence on the sustainability of their practices. Indigenous and local knowledge can, and often does, provide a foundation for sustainable gathering ITEM CSL_CITATION {"citationID":"Iw5dXlQe","properties":{"formattedCitation":"(Hart\\\\uc0\\\\u8208{}Fredeluces, 2021; Kor, 2021; Papageorgiou, 2020; Saha & Sundriyal, 2012; Walsh & Douglas, 2011)","plainCitation":"(Hart?Fredeluces, 2021; Kor, 2021; Papageorgiou, 2020; Saha & Sundriyal, 2012; Walsh & Douglas, 2011)","noteIndex":0},"citationItems":[{"id":19191,"uris":["http://zotero.org/groups/2344805/items/CJCBTM79"],"itemData":{"id":19191,"type":"article-journal","container-title":"Journal of Ecology","issue":"3","language":"en","page":"1133–1147","title":"Simulated Indigenous fire stewardship increases the population growth rate of an understorey herb","volume":"109","author":[{"family":"Hart?Fredeluces","given":"G.M."},{"family":"Ticktin","given":"T."},{"family":"Lake","given":"F.K."}],"issued":{"date-parts":[["2021"]]}}},{"id":19205,"uris":["http://zotero.org/groups/2344805/items/TEUB24GR"],"itemData":{"id":19205,"type":"article-journal","container-title":"Ambio","issue":"9","language":"en","page":"1681–1697","title":"Sustainability of wild plant use in the Andean Community of South America","volume":"50","author":[{"family":"Kor","given":"L."},{"family":"Homewood","given":"K."},{"family":"Dawson","given":"T.P."},{"family":"Diazgranados","given":"M."}],"issued":{"date-parts":[["2021"]]}}},{"id":1340,"uris":["http://zotero.org/groups/2344805/items/ZH3L9RVH"],"itemData":{"id":1340,"type":"article-journal","container-title":"Journal of ethnobiology and ethnomedicine","DOI":"https://doi.org/10.1186/s13002-020-00390-4","issue":"1","note":"publisher: BioMed Central","page":"1–23","title":"Local knowledge about sustainable harvesting and availability of wild medicinal plant species in Lemnos island, Greece","volume":"16","author":[{"family":"Papageorgiou","given":"Dimitrios"},{"family":"Bebeli","given":"Penelope J"},{"family":"Panitsa","given":"Maria"},{"family":"Schunko","given":"Christoph"}],"issued":{"date-parts":[["2020"]]}}},{"id":19221,"uris":["http://zotero.org/groups/2344805/items/GIF6BGV7"],"itemData":{"id":19221,"type":"article-journal","container-title":"Forest Policy and Economics","issue":"1","language":"en","page":"28–40","title":"Utilization of non-timber forest products in humid tropics: Implications for management and livelihood","volume":"14","author":[{"family":"Saha","given":"D."},{"family":"Sundriyal","given":"R.C."}],"issued":{"date-parts":[["2012"]]}}},{"id":2525,"uris":["http://zotero.org/groups/2344805/items/BYDDK24W"],"itemData":{"id":2525,"type":"article-journal","abstract":"Improvement in Aboriginal people’s livelihoods and economic opportunities has been a major aim of increased research and development on bush foods over the past decade. But worldwide the development of trade in non-timber forest products from natural populations has raised questions about the ecological sustainability of harvest. Trade-offs and tensions between commercialisation and cultural values have also been found. We investigated the sustainability of the small-scale commercial harvest and trade in native plant products sourced from central Australian rangelands (including Solanum centrale J.M. Black, Acacia Mill. spp.). We used semi-structured interviews with traders and Aboriginal harvesters, participant observation of trading and harvesting trips, and analysis of species and trader records. An expert Aboriginal reference group guided the project. We found no evidence of either taxa being vulnerable to over-harvest. S. centrale production is enhanced by harvesting when it co-occurs with patch-burning. Extreme fluctuations in productivity of both taxa, due to inter-annual rainfall variability, have a much greater impact on supply than harvest effects. Landscape-scale degradation (including cattle grazing and wildfire) affected ecological sustainability according to participants. By contrast, we found that sustainability of bush food trade is more strongly impacted by social and economic factors. The relationship-based links between harvesters and traders are critical to monetary trade. Harvesters and traders identified access to productive lands and narrow economic margins between costs and returns as issues for the future sustainability of harvest and trade. Harvesters and the reference group emphasised that sustaining bush harvest relies on future generations having necessary knowledge and skills; these are extremely vulnerable to loss. Aboriginal people derive multiple livelihood benefits from harvest and trade. Aboriginal custodians and harvester groups involved in recent trade are more likely to benefit from research and development investment to inter-generational knowledge and skill transfer than from investments in plant breeding and commercial horticultural development. In an inductive comparison, our study found there to be strong alignment between key findings about the strategies used by harvesters and traders in bush produce and the ‘desert system’..","container-title":"The Rangeland Journal","DOI":"10.1071/RJ11028","ISSN":"1834-7541","issue":"4","journalAbbreviation":"Rangel. J.","language":"en","note":"publisher: CSIRO PUBLISHING","page":"395-416","source":"www.publish.csiro.au","title":"No bush foods without people: the essential human dimension to the sustainability of trade in native plant products from desert Australia","title-short":"No bush foods without people","volume":"33","author":[{"family":"Walsh","given":"Fiona"},{"family":"Douglas","given":"Josie"}],"issued":{"date-parts":[["2011",12,20]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. In western Australia, research shows that the ecological and economic future of small-scale trade in bush food will depend on intergenerational transfer of Aboriginal knowledge and skills ITEM CSL_CITATION {"citationID":"TFxBG1Te","properties":{"formattedCitation":"(Walsh & Douglas, 2011)","plainCitation":"(Walsh & Douglas, 2011)","noteIndex":0},"citationItems":[{"id":2525,"uris":["http://zotero.org/groups/2344805/items/BYDDK24W"],"itemData":{"id":2525,"type":"article-journal","abstract":"Improvement in Aboriginal people’s livelihoods and economic opportunities has been a major aim of increased research and development on bush foods over the past decade. But worldwide the development of trade in non-timber forest products from natural populations has raised questions about the ecological sustainability of harvest. Trade-offs and tensions between commercialisation and cultural values have also been found. We investigated the sustainability of the small-scale commercial harvest and trade in native plant products sourced from central Australian rangelands (including Solanum centrale J.M. Black, Acacia Mill. spp.). We used semi-structured interviews with traders and Aboriginal harvesters, participant observation of trading and harvesting trips, and analysis of species and trader records. An expert Aboriginal reference group guided the project. We found no evidence of either taxa being vulnerable to over-harvest. S. centrale production is enhanced by harvesting when it co-occurs with patch-burning. Extreme fluctuations in productivity of both taxa, due to inter-annual rainfall variability, have a much greater impact on supply than harvest effects. Landscape-scale degradation (including cattle grazing and wildfire) affected ecological sustainability according to participants. By contrast, we found that sustainability of bush food trade is more strongly impacted by social and economic factors. The relationship-based links between harvesters and traders are critical to monetary trade. Harvesters and traders identified access to productive lands and narrow economic margins between costs and returns as issues for the future sustainability of harvest and trade. Harvesters and the reference group emphasised that sustaining bush harvest relies on future generations having necessary knowledge and skills; these are extremely vulnerable to loss. Aboriginal people derive multiple livelihood benefits from harvest and trade. Aboriginal custodians and harvester groups involved in recent trade are more likely to benefit from research and development investment to inter-generational knowledge and skill transfer than from investments in plant breeding and commercial horticultural development. In an inductive comparison, our study found there to be strong alignment between key findings about the strategies used by harvesters and traders in bush produce and the ‘desert system’..","container-title":"The Rangeland Journal","DOI":"10.1071/RJ11028","ISSN":"1834-7541","issue":"4","journalAbbreviation":"Rangel. J.","language":"en","note":"publisher: CSIRO PUBLISHING","page":"395-416","source":"www.publish.csiro.au","title":"No bush foods without people: the essential human dimension to the sustainability of trade in native plant products from desert Australia","title-short":"No bush foods without people","volume":"33","author":[{"family":"Walsh","given":"Fiona"},{"family":"Douglas","given":"Josie"}],"issued":{"date-parts":[["2011",12,20]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. However, in many places indigenous and local knowledge has been subject to erosion ITEM CSL_CITATION {"citationID":"NM3VyZUs","properties":{"formattedCitation":"(Uprety, 2012)","plainCitation":"(Uprety, 2012)","noteIndex":0},"citationItems":[{"id":4468,"uris":["http://zotero.org/groups/2344805/items/A9DTX9R8"],"itemData":{"id":4468,"type":"article-journal","abstract":"Traditional knowledge has become a topic of considerable interest within the research and development environment. The contribution of traditional knowledge to conservation and management is increasingly recognized, and implementation endeavours are underway in several countries. The current scale of ecosystem degradation underscores the need for restoration interventions. It is increasingly recognized that successful ecological restoration depends on effective coordination of science and traditional ecological knowledge. This paper synthesizes the literature to evaluate the present and potential contribution of traditional knowledge to ecological restoration. Despite a growing number of articles published on traditional knowledge, only a few have addressed its contributions to ecological restoration per se. The main contributions of traditional knowledge to ecological restoration are in construction of reference ecosystems, particularly when historical information is not available; species selection for restoration plantations; site selection for restoration; knowledge about historical land management practices; management of invasive species; and post-restoration monitoring. Traditional knowledge and science are complementary and should be used in conjunction in ecological restoration projects. Incorporation of traditional knowledge can contribute to build a strong partnership for the successful implementation of restoration projects and increase their social acceptability, economical feasibility, and ecological viability.","call-number":"Sub180 or Esub20k","container-title":"Écoscience","DOI":"10.2980/19-3-3530","ISSN":"1195-6860","issue":"3","journalAbbreviation":"Écoscience","page":"225–237","title":"Contribution of traditional knowledge to ecological restoration: Practices and applications","volume":"19","author":[{"family":"Uprety","given":"Yadav"},{"family":"Asselin","given":"Hugo"},{"family":"Bergeron","given":"Yves"},{"family":"Doyon","given":"Frédérik"},{"family":"Boucher","given":"Jean-François"}],"issued":{"date-parts":[["2012",9]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. A study on the Greek island of Lemnos notes that new gatherers with limited knowledge and experience may diminish the future sustainability of gathering wild medicinal plants there ITEM CSL_CITATION {"citationID":"SpxY8XBu","properties":{"formattedCitation":"(Papageorgiou, 2020)","plainCitation":"(Papageorgiou, 2020)","noteIndex":0},"citationItems":[{"id":1340,"uris":["http://zotero.org/groups/2344805/items/ZH3L9RVH"],"itemData":{"id":1340,"type":"article-journal","container-title":"Journal of ethnobiology and ethnomedicine","DOI":"https://doi.org/10.1186/s13002-020-00390-4","issue":"1","note":"publisher: BioMed Central","page":"1–23","title":"Local knowledge about sustainable harvesting and availability of wild medicinal plant species in Lemnos island, Greece","volume":"16","author":[{"family":"Papageorgiou","given":"Dimitrios"},{"family":"Bebeli","given":"Penelope J"},{"family":"Panitsa","given":"Maria"},{"family":"Schunko","given":"Christoph"}],"issued":{"date-parts":[["2020"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Partnerships between indigenous peoples and local communities and scientists can also produce knowledge that will help sustain gathering in novel and changing landscapes ITEM CSL_CITATION {"citationID":"2ySS2KfQ","properties":{"formattedCitation":"(de Mello, 2020)","plainCitation":"(de Mello, 2020)","noteIndex":0},"citationItems":[{"id":7469,"uris":["http://zotero.org/groups/2344805/items/TV355YM2"],"itemData":{"id":7469,"type":"article-journal","container-title":"Forest Policy and Economics","DOI":"10.1016/j.forpol.2020.102109","ISSN":"13899341","journalAbbreviation":"Forest Policy and Economics","language":"en","page":"102109","source":"DOI.org (Crossref)","title":"Social-ecological sustainability of non-timber forest products: A review and theoretical considerations for future research","title-short":"Social-ecological sustainability of non-timber forest products","volume":"112","author":[{"family":"Mello","given":"Natália Girão Rodrigues","non-dropping-particle":"de"},{"family":"Gulinck","given":"Hubert"},{"family":"Van den Broeck","given":"Pieter"},{"family":"Parra","given":"Constanza"}],"issued":{"date-parts":[["2020",3]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. 
 
