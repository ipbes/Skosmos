mily":"Luque","given":"Diana"},{"family":"Doode","given":"Shoko"}],"issued":{"date-parts":[["2007"]]}}},{"id":245,"uris":["http://zotero.org/groups/2344805/items/BPJ3X2BM"],"itemData":{"id":245,"type":"paper-conference","container-title":"Poster","event-place":"Canada","event-title":"23 Meeting of SBSSTA (CBD)","publisher-place":"Canada","title":"Bighorn Sheep in Sonora, Mexico: A tale of recovery due to its sustainable use","author":[{"family":"Mosig","given":"Paola"},{"family":"Muñoz-Lacy","given":"Luis Guillermo"},{"family":"Guerrero","given":"Sol"},{"family":"Fernández","given":"T. M."},{"family":"Cruz","given":"Andrea"},{"family":"Martínez","given":"F. A."},{"family":"De León","given":"C."}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}
