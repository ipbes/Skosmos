ITEM CSL_CITATION {"citationID":"aj7cut4fes","properties":{"formattedCitation":"(Fukuda, 2019)","plainCitation":"(Fukuda, 2019)","noteIndex":0},"citationItems":[{"id":316,"uris":["http://zotero.org/groups/2344805/items/FZT64VPS"],"itemData":{"id":316,"type":"report","collection-title":"CITES & Livelihoods Case Study","language":"English","publisher":"CITES","title":"Saltwater crocodile harvest and ranching in Australia’s Northern","URL":"https://www.cites.org/sites/default/files/eng/prog/Livelihoods/case_studies/1.%20Australia_crocodiles_long_Aug2.pdf","author":[{"family":"Fukuda","given":"Yusuke"},{"family":"Webb","given":"Grahame"},{"family":"Cooney","given":"Rosie"}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}
