ITEM CSL_CITATION {"citationID":"a2hdgbto6rf","properties":{"formattedCitation":"(Karanth, Nichols, Karanth, Hines, & Christensen, 2010)","plainCitation":"(Karanth, Nichols, Karanth, Hines, & Christensen, 2010)","noteIndex":0},"citationItems":[{"id":31196,"uris":["http://zotero.org/groups/2344805/items/4JNTG2DK"],"itemData":{"id":31196,"type":"article-journal","container-title":"Proceedings of the Royal Society B: Biological Sciences","DOI":"10.1098/rspb.2010.0171","ISSN":"0962-8452, 1471-2954","issue":"1690","journalAbbreviation":"Proc. R. Soc. B","language":"en","page":"1971-1979","source":"DOI.org (Crossref)","title":"The shrinking ark: patterns of large mammal extinctions in India","title-short":"The shrinking ark","URL":"https://royalsocietypublishing.org/doi/10.1098/rspb.2010.0171","volume":"277","author":[{"family":"Karanth","given":"Krithi K."},{"family":"Nichols","given":"James D."},{"family":"Karanth","given":"K. Ullas"},{"family":"Hines","given":"James E."},{"family":"Christensen","given":"Norman L."}],"accessed":{"date-parts":[["2019",8,7]]},"issued":{"date-parts":[["2010",7,7]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} 
