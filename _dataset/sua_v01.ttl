":"A."},{"family":"Pearce","given":"T."},{"family":"Pérez Escobar","given":"O.A."},{"family":"Pieroni","given":"A."},{"family":"Pironon","given":"S."},{"family":"Prescott","given":"T.A.K."},{"family":"Qi","given":"Y.D."},{"family":"Qin","given":"H."},{"family":"Quave","given":"C.L."},{"family":"Rajaovelona","given":"L."},{"family":"Razanajatovo","given":"H."},{"family":"Reich","given":"P.B."},{"family":"Rianawati","given":"E."},{"family":"Rich","given":"T.C.G."},{"family":"Richards","given":"S.L."},{"family":"Rivers","given":"M.C."},{"family":"Ross","given":"A."},{"family":"Rumsey","given":"F."},{"family":"Ryan","given":"M."},{"family":"Ryan","given":"P."},{"family":"Sagala","given":"S."},{"family":"Sanchez","given":"M.D."},{"family":"Sharrock","given":"S."},{"family":"Shrestha","given":"K.K."},{"family":"Sim","given":"J."},{"family":"Sirakaya","given":"A."},{"family":"Sjöman","given":"H."},{"family":"Smidt","given":"E.C."},{"family":"Smith","given":"D."},{"family":"Smith","given":"P."},{"family":"Smith","given":"S.R."},{"family":"Sofo","given":"A."},{"family":"Spence","given":"N."},{"family":"Stanworth","given":"A."},{"family":"Stara","given":"K."},{"family":"Stevenson","given":"P.C."},{"family":"Stroh","given":"P."},{"family":"Suz","given":"L.M."},{"family":"Tambam","given":"B.B."},{"family":"Tatsis","given":"E.C."},{"family":"Taylor","given":"I."},{"family":"Thiers","given":"B."},{"family":"Thormann","given":"I."},{"family":"Vaglica","given":"V."},{"family":"Vásquez-Londoño","given":"C."},{"family":"Victor","given":"J."},{"family":"Viruel","given":"J."},{"family":"Walker","given":"B.E."},{"family":"Walker","given":"K."},{"family":"Walsh","given":"A."},{"family":"Way","given":"M."},{"family":"Wilbraham","given":"J."},{"family":"Wilkin","given":"P."},{"family":"Wilkinson","given":"T."},{"family":"Williams","given":"C."},{"family":"Winterton","given":"D."},{"family":"Wong","given":"K.M."},{"family":"Woodfield-Pascoe","given":"N."},{"family":"Woodman","given":"J."},{"family":"Wyatt","given":"L."},{"family":"Wynberg","given":"R."},{"family":"Zhang","given":"B.G."}],"accessed":{"date-parts":[["2021",3,29]]},"issued":{"date-parts":[["2020",9]]}}},{"id":906,"uris":["http://zotero.org/groups/2344805/items/48WC3ZWP"],"itemData":{"id":906,"type":"article-journal","abstract":"Bioenergy is a major component of the global transition to renewable energy technologies. The plant and fungal kingdoms offer great potential but remain mostly untapped. Their increased use could contribute to the renewable energy transition and addressing the United Nations Sustainable Development Goal 7 “Ensure access to affordable, reliable, sustainable and modern energy for all.” Current research focuses on species cultivated at scale in temperate regions, overlooking the wealth of potential new sources of small-scale energy where they are most urgently needed. A shift towards diversified, accessible bioenergy technologies will help to mitigate and adapt to the threats of climate change, decrease energy poverty, improve human health by reducing indoor pollution, increase energy resilience of communities, and decrease greenhouse gas emissions from fossil fuels.","container-title":"PLANTS, PEOPLE, PLANET","DOI":"https://doi.org/10.1002/ppp3.10147","issue":"5","page":"446-462","title":"Plant Power: Opportunities and challenges for meeting sustainable energy needs from the plant and fungal kingdoms","volume":"2","author":[{"family":"Grace","given":"Olwen M."},{"family":"Lovett","given":"Jon C."},{"family":"Gore","given":"Charles J. N."},{"family":"Moat","given":"Justin"},{"family":"Ondo","given":"Ian"},{"family":"Pironon","given":"Samuel"},{"family":"Langat","given":"Moses K."},{"family":"Pérez-Escobar","given":"Oscar A."},{"family":"Ross","given":"Andrew"},{"family":"Suzan Abbo","given":"Mary"},{"family":"Shrestha","given":"Krishna K."},{"family":"Gowda","given":"Balakrishna"},{"family":"Farrar","given":"Kerrie"},{"family":"Adams","given":"Jessica"},{"family":"Cámara-Leret","given":"Rodrigo"},{"family":"Diazgranados","given":"Mauricio"},{"family":"Ulian","given":"Tiziana"},{"family":"Sagala","given":"Saut"},{"family":"Rianawati","given":"Elisabeth"},{"family":"Hazra","given":"Amit"},{"family":"Masera","given":"Omar R."},{"family":"Antonelli","given":"Alexandre"},{"family":"Wilkin","given":"Paul"}],"issued":{"date-parts":[["2020"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}Fungi, in particular, have much unexplored potential within the bioenergy sector. Microbial fuel cells can be run on fungal enzymes, such as those from baker’s yeast (Saccharomyces cerevisiae), to generate electricity from plant biomass ITEM CSL_CITATION {"citationID":"a13vr7uesnh","properties":{"formattedCitation":"(Antonelli, 2020)","plainCitation":"(Antonelli, 2020)","noteIndex":0},"citationItems":[{"id":30901,"uris":["http://zotero.org/groups/2344805/items/G9883U5U"],"itemData":{"id":30901,"type":"report","note":"DOI: 10.34885/172","publisher":"Royal Botanic Gardens, Kew","source":"DOI.org (Datacite)","title":"State of the World's Plants and Fungi 2020","URL":"https://kew.iro.bl.uk/work/23394899-864d-4ef0-b864-857efea500c5","author":[{"family":"Antonelli","given":"A."},{"family":"Fry","given":"C."},{"family":"Smith","given":"R.J."},{"family":"Simmonds","given":"M.S.J."},{"family":"Kersey","given":"P.J."},{"family":"Pritchard","given":"H.W."},{"family":"Abbo","given":"M.S."},{"family":"Acedo","given":"C."},{"family":"Adams","given":"J."},{"family":"Ainsworth","given":"A.M."},{"family":"Allkin","given":"B."},{"family":"Annecke","given":"W."},{"family":"Bachman","given":"S.P."},{"family":"Bacon","given":"K."},{"family":"Bárrios","given":"S."},{"family":"Barstow","given":"C."},{"family":"Battison","given":"A."},{"family":"Bell","given":"E."},{"family":"Bensusan","given":"K."},{"family":"Bidartondo","given":"M.I."},{"family":"Blackhall-Miles","given":"R.J."},{"family":"Borrell","given":"J.S."},{"family":"B