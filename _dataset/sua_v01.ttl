n":"G.E."},{"family":"Neuenfeldt","given":"S."},{"family":"Kokkalis","given":"A."},{"family":"Lehmann","given":"A."},{"family":"Egekvist","given":"J."},{"family":"Kristensen","given":"K."},{"family":"Munk","given":"P."},{"family":"Hüssy","given":"K."},{"family":"Støttrup","given":"J.G."}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. The collapse of fishing systems and the overexploitation of stocks created new social contexts which demanded new and stricter management rules and improved governance, also seen as means to avoid social conflict ITEM CSL_CITATION {"citationID":"a2pemqbodj4","properties":{"formattedCitation":"(Marengo, 2015)","plainCitation":"(Marengo, 2015)","noteIndex":0},"citationItems":[{"id":31798,"uris":["http://zotero.org/groups/2344805/items/2BB3P5VE"],"itemData":{"id":31798,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Management and Ecology","DOI":"10.1111/fme.12110","issue":"3","page":"249-260","title":"Comparative analysis of artisanal and recreational fisheries for Dentex dentex in a Marine Protected Area","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84929265099&doi=10.1111%2ffme.12110&partnerID=40&md5=3d583f397f90edd8f42106c112c87d15","volume":"22","author":[{"family":"Marengo","given":"M."},{"family":"Culioli","given":"J.-M."},{"family":"Santoni","given":"M.-C."},{"family":"Marchand","given":"B."},{"family":"Durieux","given":"E.D.H."}],"issued":{"date-parts":[["2015"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. These needs were partially met with the official management measures adopted in many areas, with distinct levels of success. Apparently, the recovery of social recognition of those engaged in this practice and the relevance of the small-scale fisheries was also an outcome of successful management initiatives at some places ITEM CSL_CITATION {"citationID":"apg2mj0qfv","properties":{"formattedCitation":"(Carvalho, 2017)","plainCitation":"(Carvalho, 2017)","noteIndex":0},"citationItems":[{"id":376,"uris":["http://zotero.org/groups/2344805/items/L5VUDIJC"],"itemData":{"id":376,"type":"article-journal","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2017.01.008","page":"34-44","title":"Socio-economic, operational and technical characterisation of the harvesting of gooseneck barnacle (Pollicipes pollicipes) in SW Portugal: Insights towards fishery co-management","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85009170677&doi=10.1016%2fj.marpol.2017.01.008&partnerID=40&md5=7811606bf0e2b057b997b0e29ed391f9","volume":"78","author":[{"family":"Carvalho","given":"A.N."},{"family":"Vasconcelos","given":"P."},{"family":"Piló","given":"D."},{"family":"Pereira","given":"F."},{"family":"Gaspar","given":"M.B."}],"issued":{"date-parts":[["2017"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}.

* Africa
From the initial selection of 63 papers, this evaluation on African small-scale fisheries is based on 51 papers covering mainly the coastal and marine/oceanic small-scale fishing, which was the subject of approximately 40 papers (see the data management report for Chapter 3 systematic literature review at https://doi.org/10.5281/zenodo.6452651). Despite the importance of established fisheries in tropical and subtropical African rivers, the reviewed literature focused on inland small-scale fishing in the great African lakes and small rivers. The fishing practices in African great lakes was studied in eight papers ITEM CSL_CITATION {"citationID":"8Fzyo1ZC","properties":{"formattedCitation":"(Bulengela, Onyango, Brehm, Staehr, & Sweke, 2019; Hara & Njaya, 2015; Jamu, Banda, Njaya, & Hecky, 2011; Knaap & Ligtvoet, 2010; Kolding, B\\\\uc0\\\\u233{}n\\\\uc0\\\\u233{}, & Bavinck, 2014; Mgana, 2019; E. Mkuna & Baiyegunhi, 2019; Eliaza Mkuna & Baiyegunhi, 2019)","plainCitation":"(Bulengela, Onyango, Brehm, Staehr, & Sweke, 2019; Hara & Njaya, 2015; Jamu, Banda, Njaya, & Hecky, 2011; Knaap & Ligtvoet, 2010; Kolding, Béné, & Bavinck, 2014; Mgana, 2019; E. Mkuna & Baiyegunhi, 2019; Eliaza Mkuna & Baiyegunhi, 2019)","noteIndex":0},"citationItems":[{"id":31514,"uris":["http://zotero.org/groups/2344805/items/352B8WJL"],"itemData":{"id":31514,"type":"article-journal","archive":"Scopus","container-title":"Environment, Development and Sustainability","DOI":"10.1007/s10668-019-00443-z","title":"“Bring fishermen at the center”: the value of local knowledge for understanding fisheries resources and climate-related changes in Lake Tanganyika","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85072043163&doi=10.1007%2fs10668-019-00443-z&partnerID=40&md5=6630317de18ad2506714514f890d3c14","author":[{"family":"Bulengela","given":"G."},{"family":"Onyango","given":"P."},{"family":"Brehm","given":"J."},{"family":"Staehr","given":"P.A."},{"family":"Sweke","given":"E."}],"issued":{"date-parts":[["2019"]]}}},{"id":31748,"uris":["http://zotero.org/groups/2344805/items/IDA5KDZE"],"itemData":{"id":31748,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Research","DOI":"10.1016/j.fishres.2015.08.005","page":"10-18","title":"Between a rock and a hard place: The need for and challenges to implementation of Rights Based Fisheries Management in small-scale fisheries of southern Lake Malawi","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84940492487&doi=10.1016%2fj.fishres.2015.08.005&partnerID=40&md5=cd9365c18cb7f0cf2ff30eaec22047c8","volume":"174","author":[{"family":"Hara","given":"M."},{"family":"Njaya","given":"F."}],"issued":{"date-parts":[["2015"]]}},"label":"page"},{"id":31528,"uris":["http://zotero.org/groups/2344805/items/9LAI5MQ5"],"itemData":{"id":31528,"type":"article-journal","archive":"Scopus","container-title":"Journal of Great Lakes Research","DOI":"10.1016/j.jglr.2010.11.017","issue":"SUPPL. 1","page":"3-14","title":"Challenges to sustainable management of the lakes of Malawi","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-79952695965&doi=10.1016%2fj.jglr.2010.11.017&partnerID=40&md5=13fdc8fe7d639007c33e2f09e241cb28","volume":"37","author":[{"family":"Jamu","given":"D."},{"family":"Banda","given":"M."},{"family":"Njaya","given":"F."},{"family":"Hecky","given":"R.E."}],"issued":{"date-parts":[["2011"]]}},"label":"page"},{"id":28601,"uris":["http://zotero.org/groups/2344805/items/8VI397M4"],"itemData":{"id":28601,"type":"article-journal","container-title":"Aquatic Ecosystem Health and Management","DOI":"10.1080/14634988.2010.526088","issue":"4","language":"en","page":"429–436","title":"Is western consumption of nile perch from Lake Victoria sustainable?","URL":"https://doi.org/10.1080/14634988.2010.526088","volume":"13","author":[{"family":"Knaap","given":"M."},{"family":"Ligtvoet","given":"W."}],"issued":{"date-parts":[["2010"]]}},"label":"page"},{"id":9736,"uris":["http://zotero.org/groups/2344805/items/SM9K8SED"],"itemData":{"id":9736,"type":"article-journal","container-title":"Governance of marine fisheries and biodiversity conservation: Interaction and coevolution","journalAbbreviation":"Governance of marine fisheries and biodiversity conservation: Interaction and coevolution","page":"317-331","title":"Small-scale fisheries: Importance, vulnerability and deficient knowledge","author":[{"family":"Kolding","given":"Jeppe"},{"family":"Béné","given":"Christophe"},{"family":"Bavinck","given":"Maarten"}],"issued":{"date-parts":[["2014"]]}},"label":"page"},{"id":9097,"uris":["http://zotero.org/groups/2344805/items/YCZ4A3RH"],"itemData":{"id":9097,"type":"article-journal","archive":"Scopus","container-title":"PLoS ONE","DOI":"10.1371/journal.pone.0216580","issue":"10","title":"Adoption and consequences of new light-fishing technology (LEDs) on Lake Tanganyika, East Africa","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85073729945&doi=10.1371%2fjournal.pone.0216580&partnerID=40&md5=3eecd5133d041141eca03ca06d52d40b","volume":"14","author":[{"family":"Mgana","given":"H."},{"family":"Kraemer","given":"B.M."},{"family":"O’Reilly","given":"C.M."},{"family":"Staehr","given":"P.A."},{"family":"Kimirei","given":"I.A."},{"family":"Apse","given":"C."},{"family":"Leisher","given":"C."},{"family":"Ngoile","given":"M."},{"family":"McIntyre","given":"P.B."}],"issued":{"date-parts":[["2019"]]}},"label":"page"},{"id":9096,"uris":["http://zotero.org/groups/2344805/items/YKLMVZPL"],"itemData":{"id":9096,"type":"article-journal","archive":"Scopus","container-title":"Lakes and Reservoirs: Research and Management","DOI":"10.1111/lre.12274","issue":"3","page":"228-238","title":"Analysis of the technical efficiency of Nile perch (Lates niloticus) fishers in the Tanzanian portion of Lake Victoria: A stochastic frontier analysis","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85070214739&doi=10.1111%2flre.12274&partnerID=40&md5=d4287e1d4e20db0f55872148202eb480","volume":"24","author":[{"family":"Mkuna","given":"E."},{"family":"Baiyegunhi","given":"L.J.S."}],"issued":{"date-parts":[["2019"]]}}},{"id":8659,"uris":["http://zotero.org/groups/2344805/items/54VNRENH"],"itemData":{"id":8659,"type":"article-journal","abstract":"The current fishing pressure in Lake Victoria, Tanzania indicates that the Nile perch (Lates niloticus) is overfished and no regulations are enforced to maintain a sustainable fishery despite its significant contribution to the economy. This study examines the determinants of Nile perch overfishing and its intensity in Lake Victoria, Tanzania, using a double-hurdle model that is based on baseline survey data collected from 268 Nile perch fishers. The model analysed the data in two sequential hurdles, the first hurdle being whether or not a Nile perch fisher overfished (probability of overfishing), and the second hurdle being the difference between the actual average catch size and the minimum slot size of 50 cm total length (TL) (intensity of overfishing). The study revealed that different socio-economic, institutional and fishing effort influence Nile perch overfishing and its intensity in Lake Victoria, Tanzania. This, therefore, suggests that, to attain a balance between sustainable fishery management and the livelihood for Nile perch fishers in Lake Victoria, there is a need for the government to design policies that will consider the dynamics of the institutional setup and fishing effort in this lake.","container-title":"Hydrobiologia","DOI":"10.1007/s10750-019-3932-9","ISSN":"1573-5117","issue":"1","journalAbbreviation":"Hydrobiologia","page":"101-115","title":"Determinants of Nile perch (Lates niloticus) overfishing and its intensity in Lake Victoria, Tanzania: a double-hurdle model approach","URL":"https://doi.org/10.1007/s10750-019-3932-9","volume":"835","author":[{"family":"Mkuna","given":"Eliaza"},{"family":"Baiyegunhi","given":"Lloyd J. S."}],"issued":{"date-parts":[["2019",6,1]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Similar analysis for fishing practices in some African smaller lakes was published in three studies ITEM CSL_CITATION {"citationID":"9nVDqbNP","properties":{"formattedCitation":"(Kininmonth, 2017; Obegi, 2020; Tefera, Zerihun, & Wolde-Meskel, 2019)","plainCitation":"(Kininmonth, 2017; Obegi, 2020; Tefera, Zerihun, & Wolde-Meskel, 2019)","noteIndex":0},"citationItems":[{"id":8778,"uris":["http://zotero.org/groups/2344805/items/RV2MZ393"],"itemData":{"id":8778,"type":"article-journal","abstract":"Kininmonth, S., B. Crona, Ö. Bodin, I. Vaccaro, L. J. Chapman, and C. A. Chapman. 2016. Microeconomic relationships between and among fishers and traders influence the ability to respond to social-ecological changes in a small-scale fishery. Ecology and Society 22(2):26. https://doi.org/10.5751/ES-08833-220226","container-title":"Ecology and Society","DOI":"10.5751/ES-08833-220226","ISSN":"1708-3087","issue":"2","language":"en","license":"© 2017 by the author(s)","note":"publisher: The Resilience Alliance","source":"www.ecologyandsociety.org","title":"Microeconomic relationships between and among fishers and traders influence the ability to respond to social-ecological changes in a small-scale fishery","URL":"https://www.ecologyandsociety.org/vol22/iss2/art26/","volume":"22","author":[{"family":"Kininmonth","given":"Stuart"},{"family":"Crona","given":"Beatrice"},{"family":"Bodin","given":"Örjan"},{"family":"Vaccaro","given":"Ismael"},{"family":"Chapman","given":"Lauren"},{"family":"Chapman","given":"Colin"}],"accessed":{"date-parts":[["2020",10,27]]},"issued":{"date-parts":[["2017",5,29]]}},"label":"page"},{"id":9106,"uris":["http://zotero.org/groups/2344805/items/8NNC949I"],"itemData":{"id":9106,"type":"article-journal","archive":"Scopus","container-title":"Journal of Bioeconomics","DOI":"10.1007/s10818-019-09292-2","title":"Bio-economic modeling of fishing activities in Kenya: the case of Lake Naivasha Ramsar site","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85077895150&doi=10.1007%2fs10818-019-09292-2&partnerID=40&md5=f799789d7509d86e40dd2eae84e9b97e","author":[{"family":"Obegi","given":"B.N."},{"family":"Sarfo","given":"I."},{"family":"Morara","given":"G.N."},{"family":"Boera","given":"P."},{"family":"Waithaka","given":"E."},{"family":"Mutie","given":"A."}],"issued":{"date-parts":[["2020"]]}}},{"id":8827,"uris":["http://zotero.org/groups/2344805/items/69QHLAKK"],"itemData":{"id":8827,"type":"article-journal","archive":"Scopus","container-title":"African Journal of Aquatic Science","DOI":"10.2989/16085914.2019.1637710","issue":"3","page":"273-280","title":"Catch distribution and size structure of Nile tilapia (Oreochromis niloticus) in Lake Tana, Ethiopia: implications for fisheries management","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85074257417&doi=10.2989%2f16085914.2019.1637710&partnerID=40&md5=20541c4190f10e9cac45ec3da8882ce5","volume":"44","author":[{"family":"Tefera","given":"D.A."},{"family":"Zerihun","given":"M.M."},{"family":"Wolde-Meskel","given":"Y.T.G."}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}, and there were a few examples of small river fishing in South Africa and Egypt ITEM CSL_CITATION {"citationID":"ZMHiQXFQ","properties":{"formattedCitation":"(McCafferty, Ellender, Weyl, & Britz, 2012; Samy-Kamal, 2015)","plainCitation":"(McCafferty, Ellender, Weyl, & Britz, 2012; Samy-Kamal, 2015)","noteIndex":0},"citationItems":[{"id":31785,"uris":["http://zotero.org/groups/2344805/items/TXQYQZJY"],"itemData":{"id":31785,"type":"article-journal","archive":"Scopus","container-title":"Water SA","DOI":"10.4314/wsa.v38i2.18","issue":"2","page":"327-344","title":"The use of water resources for inland fisheries in South Africa","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84860523720&doi=10.4314%2fwsa.v38i