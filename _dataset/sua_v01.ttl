ITEM CSL_CITATION {"citationID":"a16pu8fstno","properties":{"formattedCitation":"(Foote & Wenzel, 2009)","plainCitation":"(Foote & Wenzel, 2009)","noteIndex":0},"citationItems":[{"id":864,"uris":["http://zotero.org/groups/2344805/items/IZJPDHAI"],"itemData":{"id":864,"type":"chapter","container-title":"Inuit, Polar Bears and Sustainable Use: Local, National and International Perspectives","page":"13-24","publisher":"University of Alberta Press","source":"ResearchGate","title":"Polar bear conservation hunting in Canada: Economics, culture and unintended consequences","title-short":"Polar bear conservation hunting in Canada","author":[{"family":"Foote","given":"Lee"},{"family":"Wenzel","given":"George"}],"editor":[{"family":"Milton","given":"M. R."},{"family":"Foote","given":"Lee"}],"issued":{"date-parts":[["2009",1,1]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}
