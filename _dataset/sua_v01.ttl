9887","volume":"3","author":[{"family":"Ban","given":"Natalie C"},{"family":"Eckert","given":"Lauren"},{"family":"McGreer","given":"Madeleine"},{"family":"Frid","given":"Alejandro"}],"accessed":{"date-parts":[["2020",9,1]]},"issued":{"date-parts":[["2017",8,3]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [25] ITEM CSL_CITATION {"citationID":"a28h2k3jg1o","properties":{"formattedCitation":"(Eckert, 2018)","plainCitation":"(Eckert, 2018)","noteIndex":0},"citationItems":[{"id":31727,"uris":["http://zotero.org/groups/2344805/items/WE8ZZ9T4"],"itemData":{"id":31727,"type":"article-journal","call-number":"Esub 21f","container-title":"Aquatic Conservation: Marine and Freshwater Ecosystems","DOI":"10.1002/aqc.2834","ISSN":"10527613","issue":"1","journalAbbreviation":"Aquatic Conserv: Mar Freshw Ecosyst","language":"English","page":"158-166","source":"DOI.org (Crossref)","title":"Diving back in time: Extending historical baselines for yelloweye rockfish with Indigenous knowledge","title-short":"Diving back in time","URL":"http://doi.wiley.com/10.1002/aqc.2834","volume":"28","author":[{"family":"Eckert","given":"Lauren E."},{"family":"Ban","given":"Natalie C."},{"family":"Frid","given":"Alejandro"},{"family":"McGreer","given":"Madeleine"}],"accessed":{"date-parts":[["2020",9,1]]},"issued":{"date-parts":[["2018",2]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}; [26] ITEM CSL_CITATION {"citationID":"TODcevBm","properties":{"formattedCitation":"(S\\\\uc0\\\\u225{}enz\\\\uc0\\\\u8211{}Arroyo, 2005)","plainCitation":"(Sáenz–Arroyo, 2005)","noteIndex":0},"citationItems":[{"id":31754,"uris":["http://zotero.org/groups/2344805/items/LV6VR48N"],"itemData":{"id":31754,"type":"article-journal","container-title":"Fish and Fisheries","ISSN":"1467-2960","issue":"2","journalAbbreviation":"Fish and Fisheries","page":"121-133","title":"Using fishers’ anecdotes, naturalists’ observations and gr