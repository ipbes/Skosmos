%2fj.marpol.2011.05.007&partnerID=40&md5=6e23c0e5dda0ec08d44e4465d27e417d","volume":"36","author":[{"family":"Le Manach","given":"F."},{"family":"Gough","given":"C."},{"family":"Harris","given":"A."},{"family":"Humber","given":"F."},{"family":"Harper","given":"S."},{"family":"Zeller","given":"D."}],"issued":{"date-parts":[["2012"]]}}},{"id":8821,"uris":["http://zotero.org/groups/2344805/items/HMCEEXLU"],"itemData":{"id":8821,"type":"article-journal","container-title":"Fisheries Centre Research Reports","issue":"4","journalAbbreviation":"Fisheries Centre Research Reports","page":"21","title":"Reconstruction of total marine fisheries catches for Madagascar","volume":"19","author":[{"family":"Le Manacha","given":"Frédéric"},{"family":"Goughb","given":"Charlotte"},{"family":"Humberb","given":"Frances"},{"family":"Harperc","given":"Sarah"},{"family":"Zellerc","given":"Dirk"}],"issued":{"date-parts":[["2011"]]}},"label":"page"},{"id":31804,"uris":["http://zotero.org/groups/2344805/items/JVXJTS9D"],"itemData":{"id":31804,"type":"article-journal","archive":"Scopus","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2013.08.002","page":"119-129","title":"Heredity or traditional knowledge: Fishing tactics and dynamics of artisanal mangrove crab (Scylla serrata) fishery","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84883530091&doi=10.1016%2fj.ocecoaman.2013.08.002&partnerID=40&md5=5ca3d6bd021a727acea9e28297b81734","volume":"84","author":[{"family":"Mirera","given":"D.O."},{"family":"Ochiewo","given":"J."},{"family":"Munyi","given":"F."},{"family":"Muriuki","given":"T."}],"issued":{"date-parts":[["2013"]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}.
	There is scarce published data about African small-scale fishing. However, it is well established that many peoples rely on small-scale fishing for their subsistence and livelihoods throughout Africa ITEM CSL_CITATION {"citationID":"a2gnhtju8d2","properties":{"formattedCitation":"(Musembi, Fulanda, Kairo, & Githaiga, 2019)","plainCitation":"(Musembi, Fulanda, Kairo, & Githaiga, 2019)","noteIndex":0},"citationItems":[{"id":31534,"uris":["http://zotero.org/groups/2344805/items/8FLQRXIR"],"itemData":{"id":31534,"type":"article-journal","archive":"Scopus","container-title":"Journal of the Indian Ocean Region","DOI":"10.1080/19480881.2019.1603608","issue":"2","page":"139-156","title":"Species composition, abundance and fishing methods of small-scale fisheries in the seagrass meadows of Gazi Bay, Kenya","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85065732359&doi=10.1080%2f19480881.2019.1603608&partnerID=40&md5=a6c1bc9e0c0760d4cd987c065d5f1659","volume":"15","author":[{"family":"Musembi","given":"P."},{"family":"Fulanda","given":"B."},{"family":"Kairo","given":"J."},{"family":"Githaiga","given":"M."}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Absence or inadequacy of data, under-estimates, and lack of stock assessment analysis were consistently mentioned by almost all papers reviewed. Those data sets supported by the FAO in many countries are usually underestimates since they are based only on landings, not considering data from illegal, unreported and unregulated fishing. Some papers present a reconstruction of data series, which attempted to include illegal, unreported and unregulated catch  ITEM CSL_CITATION {"citationID":"a2i2o5so03s","properties":{"formattedCitation":"(Barnes-Mauthe, Oleson, & Zafindrasilivonona, 2013; Jacquet, Fox, Motta, Ngusaru, & Zeller, 2010; Le Manach, 2012; Seto, 2017)","plainCitation":"(Barnes-Mauthe, Oleson, & Zafindrasilivonona, 2013; Jacquet, Fox, Motta, Ngusaru, & Zeller, 2010; Le Manach, 2012; Seto, 2017)","noteIndex":0},"citationItems":[{"id":524,"uris":["http://zotero.org/groups/2344805/items/B794PTQ4"],"itemData":{"id":524,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Research","DOI":"10.1016/j.fishres.2013.05.011","page":"175-185","title":"The total economic value of small-scale fisheries with a characterization of post-landing trends: An application in Madagascar with global relevance","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84880582478&doi=10.1016%2fj.fishres.2013.05.011&partnerID=40&md5=086f672e05aeac327b3ae0a2caf2921e","volume":"147","author":[{"family":"Barnes-Mauthe","given":"M."},{"family":"Oleson","given":"K.L.L."},{"family":"Zafindrasilivonona","given":"B."}],"issued":{"date-parts":[["2013"]]}},"label":"page"},{"id":31517,"uris":["http://zotero.org/groups/2344805/items/8VQACTNZ"],"itemData":{"id":31517,"type":"article-journal","container-title":"African Journal of Marine Science","ISSN":"1814-232X","issue":"2","journalAbbreviation":"African Journal of Marine Science","page":"197-206","title":"Few data but many fish: marine small-scale fisheries catches for Mozambique and Tanzania","volume":"32","author":[{"family":"Jacquet","given":"Jennifer"},{"family":"Fox","given":"Helen"},{"family":"Motta","given":"Helena"},{"family":"Ngusaru","given":"Amani"},{"family":"Zeller","given":"Dirk"}],"issued":{"date-parts":[["2010"]]}},"label":"page"},{"id":34121,"uris":["http://zotero.org/groups/2344805/items/QGFA5CWJ"],"itemData":{"id":34121,"type":"article-journal","archive":"Scopus","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2011.05.007","issue":"1","page":"218-225","title":"Unreported fishing, hungry people and political turmoil: The recipe for a food security crisis in Madagascar?","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-79961207744&doi=10.1016%2fj.marpol.2011.05.007&partnerID=40&md5=6e23c0e5dda0ec08d44e4465d27e417d","volume":"36","author":[{"family":"Le Manach","given":"F."},{"family":"Gough","given":"C."},{"family":"Harris","given":"A."},{"family":"Humber","given":"F."},{"family":"Harper","given":"S."},{"family":"Zeller","given":"D."}],"issued":{"date-parts":[["2012"]]}}},{"id":31794,"uris":["http://zotero.org/groups/2344805/items/XGZY77YJ"],"itemData":{"id":31794,"type":"article-journal","container-title":"Marine Policy","ISSN":"0308-597X","journalAbbreviation":"Marine Policy","page":"153-163","title":"War, fish, and foreign fleets: The marine fisheries catches of Sierra Leone 1950–2015","volume":"83","author":[{"family":"Seto","given":"Katherine"},{"family":"Belhabib","given":"Dyhia"},{"family":"Mamie","given":"Josephus"},{"family":"Copeland","given":"Duncan"},{"family":"Vakily","given":"Jan Michael"},{"family":"Seilert","given":"Heiko"},{"family":"Baio","given":"Andrew"},{"family":"Harper","given":"Sarah"},{"family":"Zeller","given":"Dirk"},{"family":"Zylich","given":"Kyrstn"}],"issued":{"date-parts":[["2017"]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. 
	Only one third of the papers reviewed presented any socioeconomic evaluation of fishing sustainability across the continent, and only two papers were focused on this topic. All other social evaluations demonstrated the high level of dependence of local communities on fishing practices ITEM CSL_CITATION {"citationID":"a1n1qm4j1m","properties":{"formattedCitation":"(Dyhia Belhabib, Greer, & Pauly, 2018; Bush, 2017)","plainCitation":"(Dyhia Belhabib, Greer, & Pauly, 2018; Bush, 2017)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":9797,"uris":["http://zotero.org/groups/2344805/items/4QTF5WQY","http://zotero.org/groups/2344805/items/NIYKV52V"],"itemData":{"id":9797,"type":"article-journal","container-title":"Conservation Letters","DOI":"10.1111/conl.12360","issue":"1","note":"publisher: Wiley Online Library","page":"e12360","title":"Trends in industrial and artisanal catch per effort in West African fisheries","volume":"11","author":[{"family":"Belhabib","given":"Dyhia"},{"family":"Greer","given":"Krista"},{"family":"Pauly","given":"Daniel"}],"issued":{"date-parts":[["2018"]]}},"label":"page"},{"id":31808,"uris":["http://zotero.org/groups/2344805/items/C68NDHTY"],"itemData":{"id":31808,"type":"article-journal","container-title":"Conservation Letters","DOI":"10.1111/conl.12286","issue":"4","page":"450-458","title":"Mosquito Net Use in an Artisanal East African Fishery","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84992159537&doi=10.1111%2fconl.12286&partnerID=40&md5=3b931159c35fef7e2598403638b788f3","volume":"10","author":[{"family":"Bush","given":"E.R."},{"family":"Short","given":"R.E."},{"family":"Milner-Gulland","given":"E.J."},{"family":"Lennox","given":"K."},{"family":"Samoilys","given":"M."},{"family":"Hill","given":"N."}],"issued":{"date-parts":[["2017"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. 
	Formal economic review shows that market prices either kept stable or increased in the last 60 years. This is an important factor to explain the increase in fishing effort and overexploitation of most stocks. Pressure from international markets for some high value species for exportation also added pressure on the stocks. This increased pressure led to increased competition between international fleets and local boats and sometimes conflict  ITEM CSL_CITATION {"citationID":"KXIZppuU","properties":{"formattedCitation":"(D. Belhabib, 2016; Seto, 2017)","plainCitation":"(D. Belhabib, 2016; Seto, 2017)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":31799,"uris":["http://zotero.org/groups/2344805/items/4ET9F84J"],"itemData":{"id":31799,"type":"article-journal","container-title":"Palgrave Communications","DOI":"10.1057/palcomms.2015.50","title":"Best for pleasure, not for business: Evaluating recreational marine fisheries in West Africa using unconventional sources of data","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84983558177&doi=10.1057%2fpalcomms.2015.50&partnerID=40&md5=23c6d71a2db9f25411d5f14b7cb9c3e2","volume":"2","author":[{"family":"Belhabib","given":"D."},{"family":"Campredon","given":"P."},{"family":"Lazar","given":"N."},{"family":"Sumaila","given":"U.R."},{"family":"Baye","given":"B.C."},{"family":"Kane","given":"E.A."},{"family":"Pauly","given":"D."}],"issued":{"date-parts":[["2016"]]}},"label":"page"},{"id":31794,"uris":["http://zotero.org/groups/2344805/items/XGZY77YJ"],"itemData":{"id":31794,"type":"article-journal","container-title":"Marine Policy","ISSN":"0308-597X","journalAbbreviation":"Marine Policy","page":"153-163","title":"War, fish, and foreign fleets: The marine fisheries catches of Sierra Leone 1950–2015","volume":"83","author":[{"family":"Seto","given":"Katherine"},{"family":"Belhabib","given":"Dyhia"},{"family":"Mamie","given":"Josephus"},{"family":"Copeland","given":"Duncan"},{"family":"Vakily","given":"Jan Michael"},{"family":"Seilert","given":"Heiko"},{"family":"Baio","given":"Andrew"},{"family":"Harper","given":"Sarah"},{"family":"Zeller","given":"Dirk"},{"family":"Zylich","given":"Kyrstn"}],"issued":{"date-parts":[["2017"]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}.

* Latin America (South and Central America, Mexico)
For the purpose of this assessment, Latin America includes the countries in South and Central America, Mexico and Caribbean Islands based on the similarities in their small-scale fisheries and social-ecological characteristics. This review is based on 107 articles (see the data management report for Chapter 3 systematic literature review at https://doi.org/10.5281/zenodo.6452651) from the review sources and those added by the assessment authors. These studies address coastal and inland small-scale fisheries in 15 countries with large numbers of studies from Brazil (55) and Mexico (20), which may reflect a larger number of fisheries scientists working in these countries rather than greater small-scale fisheries activity there. A selection of the studies provides international comparisons ITEM CSL_CITATION {"citationID":"a29tsjhohuj","properties":{"formattedCitation":"(Defeo, 2016; Guzm\\\\uc0\\\\u225{}n Maldonado, Macedo Lopes, Rodr\\\\uc0\\\\u237{}guez Fern\\\\uc0\\\\u225{}ndez, Lasso Alcala, & Sumalia, 2017)","plainCitation":"(Defeo, 2016; Guzmán Maldonado, Macedo Lopes, Rodríguez Fernández, Lasso Alcala, & Sumalia, 2017)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":34288,"uris":["http://zotero.org/groups/2344805/items/MVWWMNWF"],"itemData":{"id":34288,"type":"article-journal","abstract":"Co-management (Co-M), de?ned as the sharing of management tasks and responsibilities between governments and local users, is emerging as a powerful institutional arrangement to redress ?sheries paradigm failures, yet long-term assessments of its performance are lacking. A comparative analysis of ?ve smallscale Latin American shell?sheries was conducted to identify factors suggesting success and failure. In Chile, Uruguay and Mexico Co-M produced positive effects, including stabilization of landings at low levels, increase in abundance, CPUE, unit prices and revenues per unit of effort, and reduced interannual variability in several ?shery indicators, particularly in landings. Co-M was successful because it was mainly bottom-up implemented and accompanied by-catch shares (spatial property rights and community quotas). By contrast, Co-M implementation was unable to prevent the collapse of the Galapagos sea cucumber ?shery, as re?ected by a decrease in abundance and CPUE. Negative effects were also observed in the Galapagos spiny lobster ?shery during Co-M implementation. However, recovery was observed in recent years, re?ected in a stabilization of ?shing effort and the highest CPUE and economic revenues observed since the beginning of the Co-M implementation phase. The combined effects of market forces, climate variability and a moratorium on ?shing effort were critical in ?shery recovery. We conclude that Co-M is not a blueprint that can be applied to all shell?sheries to enhance their governability. These social–ecological systems need to be managed by jointly addressing problems related to the resources, their marine environment and the people targeting them, accounting for their socioeconomic and cultural contexts.","container-title":"Fish and Fisheries","DOI":"10.1111/faf.12101","ISSN":"14672960","issue":"1","journalAbbreviation":"Fish Fish","language":"en","page":"176-192","source":"DOI.org (Crossref)","title":"Co-management in Latin American small-scale shellfisheries: assessment from long-term case studies","title-short":"Co-management in Latin American small-scale shellfisheries","URL":"http://doi.wiley.com/10.1111/faf.12101","volume":"17","author":[{"family":"Defeo","given":"Omar"},{"family":"Castrejón","given":"Mauricio"},{"family":"Pérez-Castañeda","given":"Roberto"},{"family":"Castilla","given":"Juan C"},{"family":"Gutiérrez","given":"Nicolás L"},{"family":"Essington","given":"Timothy E"},{"family":"Folke","given":"Carl"}],"accessed":{"date-parts":[["2019",8,8]]},"issued":{"date-parts":[["2016",3]]}}},{"id":31567,"uris":["http://zotero.org/groups/2344805/items/52MQ2ZHY"],"itemData":{"id":31567,"type":"article-journal","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2016.11.021","ISSN":"0308597X","journalAbbreviation":"Marine Policy","language":"en","page":"192-199","source":"DOI.org (Crossref)","title":"Transboundary fisheries management in the Amazon: Assessing current policies for the management of the ornamental silver arawana (Osteoglossum bicirrhosum)","title-short":"Transboundary fisheries management in the Amazon","URL":"https://linkinghub.elsevier.com/retrieve/pii/S0308597X16305772","volume":"76","author":[{"family":"Guzmán Maldonado","given":"Adriana"},{"family":"Macedo Lopes","given":"Priscila Fabiana"},{"family":"Rodríguez Fernández","given":"Carlos Alberto"},{"family":"Lasso Alcala","given":"Carlos Andrés"},{"family":"Sumalia","given":"Ussif Rashid"}],"accessed":{"date-parts":[["2020",6,14]]},"issued":{"date-parts":[["2017",2]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} or continental level comparisons ITEM CSL_CITATION {"citationID":"XGoVeoyG","properties":{"formattedCitation":"(Brotz, 2017)","plainCitation":"(Brotz, 2017)","noteIndex":0},"citationItems":[{"id":31519,"uris":["http://zotero.org/groups/2344805/items/ZT6AHU57"],"itemData":{"id":31519,"type":"article-journal","container-title":"Reviews in Fish Biology and Fisheries","DOI":"10.1007/s11160-016-9445-y","issue":"1","title":"Jellyfish fisheries in the Americas: origin, state of the art, and perspectives on new fishing grounds","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84988429381&doi=10.1007%2fs11160-016-9445-y&partnerID=40&md5=9db4717398ca57dd1b5242882d9ff5ff","volume":"27","author":[{"family":"Brotz","given":"L."},{"family":"Schiariti","given":"A."},{"family":"López-Martínez","given":"J."},{"family":"Álvarez-Tello","given":"J."},{"family":"Peggy Hsieh","given":"Y.-H."},{"family":"Jones","given":"R.P."},{"family":"Quiñones","given":"J."},{"family":"Dong","given":"Z."},{"family":"Morandini","given":"A.C."},{"family":"Preciado","given":"M."},{"family":"Laaz","given":"E."},{"family":"Mianzan","given":"H."}],"issued":{"date-parts":[["2017"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Most studies (78) addressed the use of finfish but also reported on sharks, shellfish, lobsters, octopus, crabs and jellyfish. More than two thirds of the studies (78) deal with coastal fisheries with fewer (29) studies addressing inland fisheries, and most of these (25) were in the Amazon region (for details on the reviewed studies, (see the data management report for Chapter 3 systematic literature review at https://doi.org/10.5281/zenodo.6452651). More than half of the studies (56) had short time series ranging from 1 to 15 years of data collection. A few studies (17) included long range data series of 50 years or more, some of which included indigenous and local knowledge through interviews with seniors.	
	As expected, those well managed and ecologically sustainable fisheries were also considered to be economically sustainable and showed improved economic indicators such as increased prices or profits from sales of managed resources. These offset eventual decreases in total catches due to management measures, as observed among coastal invertebrate fisheries under territorial rights in Chile and Mexico ITEM CSL_CITATION {"citationID":"a7dbv97A","properties":{"formattedCitation":"(\\\\uc0\\\\u193{}lvarez, Espejel, Bocco, Cari\\\\uc0\\\\u241{}o, & Seingier, 2018; De la Cruz-Gonz\\\\uc0\\\\u225{}lez, Pati\\\\uc0\\\\u241{}o-Valencia, Luna-Raya, & Cisneros-Montemayor, 2018; Defeo, 2016; Gelcich, 2010)","plainCitation":"(Álvarez, Espejel, Bocco, Cariño, & Seingier, 2018; De la Cruz-González, Patiño-Valencia, Luna-Raya, & Cisneros-Montemayor, 2018; Defeo, 2016; Gelcich, 2010)","noteIndex":0},"citationItems":[{"id":359,"uris":["http://zotero.org/groups/2344805/items/ZKJFMIDT"],"itemData":{"id":359,"type":"article-journal","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2018.08.029","page":"203-214","title":"Environmental history of Mexican North Pacific fishing communities","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85052975797&doi=10.1016%2fj.ocecoaman.2018.08.029&partnerID=40&md5=7b1889198ba3e82c414b1cbb823188d6","volume":"165","author":[{"family":"Álvarez","given":"P."},{"family":"Espejel","given":"I."},{"family":"Bocco","given":"G."},{"family":"Cariño","given":"M."},{"family":"Seingier","given":"G."}],"issued":{"date-parts":[["2018"]]}}},{"id":358,"uris":["http://zotero.org/groups/2344805/items/NAZ4F7DS"],"itemData":{"id":358,"type":"article-journal","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2018.01.008","page":"96-102","title":"Self-empowerment and successful co-management in an artisanal fishing community: Santa Cruz de Miramar, Mexico","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85041435659&doi=10.1016%2fj.ocecoaman.2018.01.008&partnerID=40&md5=2e93d9232595fcefceb19189c999a30c","volume":"154","author":[{"family":"De la Cruz-González","given":"F.J."},{"family":"Patiño-Valencia","given":"J.L."},{"family":"Luna-Raya","given":"M.C."},{"family":"Cisneros-Montemayor","given":"A.M."}],"issued":{"date-parts":[["2018"]]}},"label":"page"},{"id":34288,"uris":["http://zotero.org/groups/2344805/items/MVWWMNWF"],"itemData":{"id":34288,"type":"article-journal","abstract":"Co-management (Co-M), de?ned as the sharing of management tasks and responsibilities between governments and local users, is emerging as a powerful institutional arrangement to redress ?sheries paradigm failures, yet long-term assessments of its performance are lacking. A comparative analysis of ?ve smallscale Latin American shell?sheries was conducted to identify factors suggesting success and failure. In Chile, Uruguay and Mexico Co-M produced positive effects, including stabilization of landings at low levels, increase in abundance, CPUE, unit prices and revenues per unit of effort, and reduced interannual variability in several ?shery indicators, particularly in landings. Co-M was successful because it was mainly bottom-up implemented and accompanied by-catch shares (spatial property rights and community quotas). By contrast, Co-M implementation was unable to prevent the collapse of the Galapagos sea cucumber ?shery, as re?ected by a decrease in abundance and CPUE. Negative effects were also observed in the Galapagos spiny lobster ?shery during Co-M implementation. However, recovery was observed in recent years, re?ected in a stabilization of ?shing effort and the highest CPUE and economic revenues observed since the beginning of the Co-M implementation phase. The combined effects of market forces, climate variability and a moratorium on ?shing effort were critical in ?shery recovery. We conclude that Co-M is not a blueprint that can be applied to all shell?sheries to enhance their governability. These social–ecological systems need to be managed by jointly addressing problems related to the resources, their marine environment and the people targeting them, accounting for their socioeconomic and cultural contexts.","container-title":"Fish and Fisheries","DOI":"10.1111/faf.12101","ISSN":"14672960","issue":"1","journalAbbreviation":"Fish Fish","language":"en","page":"176-192","source":"DOI.org (Crossref)","title":"Co-management in Latin American small-scale shellfisheries: assessment from long-term case studies","title-short":"Co-management in Latin American small-scale shellfisheries","URL":"http://doi.wiley.com/10.1111/faf.12101","volume":"17","author":[{"family":"Defeo","given":"Omar"},{"family":"Castrejón","given":"Mauricio"},{"family":"Pérez-Castañeda","given":"Roberto"},{"family":"Castilla","given":"Juan C"},{"family":"Gutiérrez","given":"Nicolás L"},{"family":"Essington","given":"Timothy E"},{"family":"Folke","given":"Carl"}],"accessed":{"date-parts":[["2019",8,8]]},"issued":{"date-parts":[["2016",3]]}}},{"id":363,"uris":["http://zotero.org/groups/2344805/items/EVV9MAHV"],"itemData":{"id":363,"type":"article-journal","archive":"Scopus","container-title":"Proceedings of the National Academy of Sciences of the United States of America","DOI":"10.1073/pnas.1012021107","issue":"39","page":"16794-16799","title":"Navigating transformations in governance of Chilean marine coastal resources","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-78049276265&doi=10.1073%2fpnas.1012021107&partnerID=40&md5=0a50cd77256a5b88f2095e7c9f9f915c","volume":"107","author":[{"family":"Gelcich","given":"S."},{"family":"Hughes","given":"T.P."},{"family":"Olsson","given":"P."},{"family":"Folke","given":"C."},{"family":"Defeo","given":"O."},{"family":"Fernández","given":"M."},{"family":"Foale","given":"S."},{"family":"Gunderson","given":"L.H."},{"family":"Rodríguez-Sickert","given":"C."},{"family":"Scheffer","given":"M."},{"family":"Steneck","given":"R.S."},{"family":"Castilla","given":"J.C."}],"issued":{"date-parts":[["2010"]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Nevertheless, the territorial users’ rights fisheries management in Chile also caused economic shortages through the collapse of a clam fishery and reduced economic opportunities to fishers not engaged in territorial users’ rights fisheries management, who relied on depleted open access areas ITEM CSL_CITATION {"citationID":"HxGURg9T","properties":{"formattedCitation":"(Aburto & Stotz, 2013; Garmendia, Subida, Aguilar, & Fern\\\\uc0\\\\u225{}ndez, 2021)","plainCitation":"(Aburto & Stotz, 2013; Garmendia, Subida, Aguilar, & Fernández, 2021)","noteIndex":0},"citationItems":[{"id":390,"uris":["http://zotero.org/groups/2344805/items/8ZMQRYKF"],"itemData":{"id":390,"type":"article-journal","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2012.10.013","page":"88-98","title":"Learning about TURFs and natural variability: Failure of surf clam management in Chile","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84869869570&doi=10.1016%2fj.ocecoaman.2012.10.013&partnerID=40&md5=4aebaba544b49db1ea191ef249232eda","volume":"71","author":[{"family":"Aburto","given":"J."},{"family":"Stotz","given":"W."}],"issued":{"date-parts":[["2013"]]}},"label":"page"},{"id":34279,"uris":["http://zotero.org/groups/2344805/items/29U5ZLPX"],"itemData":{"id":34279,"type":"article-journal","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2021.104425","ISSN":"0308597X","journalAbbreviation":"Marine Policy","language":"en","page":"104425","source":"DOI.org (Crossref)","title":"The use of fishers’ knowledge to assess benthic resource abundance across management regimes in Chilean artisanal fisheries","URL":"https://linkinghub.elsevier.com/retrieve/pii/S0308597X2100035X","volume":"127","author":[{"family":"Garmendia","given":"Vladimir"},{"family":"Subida","given":"Maria Dulce"},{"family":"Aguilar","given":"Ainara"},{"family":"Fernández","given":"Miriam"}],"accessed":{"date-parts":[["2021",2,19]]},"issued":{"date-parts":[["2021",5]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}.
	The positive economic effects observed in coastal shellfish fisheries were also observed in the pirarucu co-managed fishery in the Brazilian Amazonian rivers ITEM CSL_CITATION {"citationID":"a1b4s09brjr","properties":{"formattedCitation":"(Campos-Silva & Peres, 2016; L. Castello, Viana, Watkins, Pinedo-Vasquez, & Luzadis, 2009)","plainCitation":"(Campos-Silva & Peres, 2016; L. Castello, Viana, Watkins, Pinedo-Vasquez, & Luzadis, 2009)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":11559,"uris":["http://zotero.org/groups/2344805/items/PZ8SCRFZ","http://zotero.org/groups/2344805/items/CVPJDIXP"],"itemData":{"id":11559,"type":"article-journal","container-title":"Scientific Reports","DOI":"10.1038/srep34745","ISSN":"2045-2322","issue":"1","journalAbbreviation":"Sci Rep","language":"en","page":"34745","source":"DOI.org (Crossref)","title":"Community-based management induces rapid recovery of a high-value tropical freshwater fishery","URL":"http://www.nature.com/articles/srep34745","volume":"6","author":[{"family":"Campos-Silva","given":"João Vitor"},{"family":"Peres","given":"Carlos A."}],"accessed":{"date-parts":[["2022",3,22]]},"issued":{"date-parts":[["2016",12]]}}},{"id":34927,"uris":["http://zotero.org/groups/2344805/items/CYJQYLNZ","http://zotero.org/groups/2344805/items/TQF9WJ9U"],"itemData":{"id":34927,"type":"article-journal","container-title":"Environmental Management","DOI":"10.1007/s00267-008-9220-5","ISSN":"0364-152X, 1432-1009","issue":"2","journalAbbreviation":"Environmental Management","language":"en","page":"197-209","source":"DOI.org (Crossref)","title":"Lessons from Integrating Fishers of Arapaima in Small-Scale Fisheries Management at the Mamirauá Reserve, Amazon","URL":"http://link.springer.com/10.1007/s00267-008-9220-5","volume":"43","author":[{"family":"Castello","given":"Leandro"},{"family":"Viana","given":"João P."},{"family":"Watkins","given":"Graham"},{"family":"Pinedo-Vasquez","given":"Miguel"},{"family":"Luzadis","given":"Valerie A."}],"accessed":{"date-parts":[["2022",3,3]]},"issued":{"date-parts":[["2009",2]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}, where increased revenues from co-management led to further social benefits, through gender equality and improved income for women ITEM CSL_CITATION {"citationID":"ae3623msvf","properties":{"formattedCitation":"(Freitas, Esp\\\\uc0\\\\u237{}rito-Santo, Campos-Silva, Peres, & Lopes, 2020)","plainCitation":"(Freitas, Espírito-Santo, Campos-Silva, Peres, & Lopes, 2020)","noteIndex":0},"citationItems":[{"id":31568,"uris":["http://zotero.org/groups/2344805/items/H7FBX3BH"],"itemData":{"id":31568,"type":"article-journal","container-title":"Ecological Economics","DOI":"10.1016/j.ecolecon.2020.106709","ISSN":"09218009","journalAbbreviation":"Ecological Economics","language":"en","page":"106709","source":"DOI.org (Crossref)","title":"Resource co-management as a step towards gender equity in fisheries","URL":"https://linkinghub.elsevier.com/retrieve/pii/S0921800919312637","volume":"176","author":[{"family":"Freitas","given":"Carolina T."},{"family":"Espírito-Santo","given":"Helder M.V."},{"family":"Campos-Silva","given":"João Vitor"},{"family":"Peres","given":"Carlos A."},{"family":"Lopes","given":"Priscila F.M."}],"accessed":{"date-parts":[["2020",6,8]]},"issued":{"date-parts":[["2020",10]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Other studies on coastal small-scale fisheries employed economic modelling, which indicate that a fishery of octopus (Octopus maya) in Mexico would be more sustainable under current management, as economic performance does not improve under alternative management scenarios ITEM CSL_CITATION {"citationID":"UXMbx70M","properties":{"formattedCitation":"(Duarte, Hern\\\\uc0\\\\u225{}ndez-Flores, Salas, & Seijo, 2018)","plainCitation":"(Duarte, Hernández-Flores, Salas, & Seijo, 2018)","noteIndex":0},"citationItems":[{"id":31522,"uris":["http://zotero.org/groups/2344805/items/UYFV3W2S"],"itemData":{"id":31522,"type":"article-journal","container-title":"Fisheries Research","DOI":"10.1016/j.fishres.2017.11.020","page":"119-126","title":"Is it sustainable fishing for Octopus maya Voss and Solis, 1966, during the breeding season using a bait-based fishing technique?","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85037340186&doi=10.1016%2fj.fishres.2017.11.020&partnerID=40&md5=b557a5950e74007aae0a26fe42530559","volume":"199","author":[{"family":"Duarte","given":"J.A."},{"family":"Hernández-Flores","given":"A."},{"family":"Salas","given":"S."},{"family":"Seijo","given":"J.C."}],"issued":{"date-parts":[["2018"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Similarly, the recovery of shellfish through co-management in a Mexican community was shown to be profitable under two of four estimated future economic scenarios ITEM CSL_CITATION {"citationID":"6yRr68iB","properties":{"formattedCitation":"(Palacios-Abrantes, Herrera-Correal, Rodr\\\\uc0\\\\u237{}guez, Brunkow, & Molina, 2018)","plainCitation":"(Palacios-Abrantes, Herrera-Correal, Rodríguez, Brunkow, & Molina, 2018)","noteIndex":0},"citationItems":[{"id":32548,"uris":["http://zotero.org/groups/2344805/items/N8NFP5ZV"],"itemData":{"id":32548,"type":"article-journal","archive":"Scopus","container-title":"PLoS ONE","DOI":"10.1371/journal.pone.0209431","issue":"12","title":"Evaluating the bio-economic performance of a Callo de hacha (Atrina maura, Atrina tuberculosa & Pinna rugosa) fishery restoration plan in La Paz, Mexico","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85058775470&doi=10.1371%2fjournal.pone.0209431&partnerID=40&md5=0cc5599bb16631c6354484f1b8836f86","volume":"13","author":[{"family":"Palacios-Abrantes","given":"J."},{"family":"Herrera-Correal","given":"J."},{"family":"Rodríguez","given":"S."},{"family":"Brunkow","given":"J."},{"family":"Molina","given":"R."}],"issued":{"date-parts":[["2018"]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. 
	One study on fisheries in French Guiana evaluated various sustainability indicators, which suggested average sustainability for ecological, economic and social dimensions. Smaller fishing fleets were considered to be more sustainable ITEM CSL_CITATION {"citationID":"iJndpXrT","properties":{"formattedCitation":"(Ciss\\\\uc0\\\\u233{}, Blanchard, & Guyader, 2014)","plainCitation":"(Cissé, Blanchard, & Guyader, 2014)","noteIndex":0},"citationItems":[{"id":31532,"uris":["http://zotero.org/groups/2344805/items/379TV9EU"],"itemData":{"id":31532,"type":"article-journal","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2013.10.003","page":"397-405","title":"Sustainability of tropical small-scale fisheries: Integrated assessment in French Guiana","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84889591238&doi=10.1016%2fj.marpol.2013.10.003&partnerID=40&md5=7c2314b9d2cb4de5683fcc4924d33b5b","volume":"44","author":[{"family":"Cissé","given":"A.A."},{"family":"Blanchard","given":"F."},{"family":"Guyader","given":"O."}],"issued":{"date-parts":[["2014"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Several coastal small-scale fisheries considered to be less economically sustainable were the fishing of spawning aggregations of reef fish in Mexico ITEM CSL_CITATION {"citationID":"gLb5G0Se","properties":{"formattedCitation":"(Erisman, 2010)","plainCitation":"(Erisman, 2010)","noteIndex":0},"citationItems":[{"id":31797,"uris":["http://zotero.org/groups/2344805/items/EEUSS7ZM"],"itemData":{"id":31797,"type":"article-journal","container-title":"Fisheries Research","ISSN":"0165-7836","issue":"3","journalAbbreviation":"Fisheries Research","page":"279-288","title":"Seasonal, annual, and long-term trends in commercial fisheries for aggregating reef fishes in the Gulf of California, Mexico","volume":"106","author":[{"family":"Erisman","given":"Brad"},{"family":"Mascarenas","given":"Ismael"},{"family":"Paredes","given":"Gustavo"},{"family":"Mitcheson","given":"Yvonne Sadovy","non-dropping-particle":"de"},{"family":"Aburto-Oropeza","given":"Octavio"},{"family":"Hastings","given":"Philip"}],"issued":{"date-parts":[["2010"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} and the shark fishing in Mexico ITEM CSL_CITATION {"citationID":"X89ZZfla","properties":{"formattedCitation":"(Mart\\\\uc0\\\\u237{}nez-Candelas, P\\\\uc0\\\\u233{}rez-Jim\\\\uc0\\\\u233{}nez, Espinoza-Tenorio, McClenachan, & M\\\\uc0\\\\u233{}ndez-Loeza, 2020)","plainCitation":"(Martínez-Candelas, Pérez-Jiménez, Espinoza-Tenorio, McClenachan, & Méndez-Loeza, 2020)","noteIndex":0},"citationItems":[{"id":31795,"uris":["http://zotero.org/groups/2344805/items/3UQSPIR8"],"itemData":{"id":31795,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Research","DOI":"10.1016/j.fishres.2020.105526","title":"Use of historical data to assess changes in the vulnerability of sharks","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85079187749&doi=10.1016%2fj.fishres.2020.105526&partnerID=40&md5=653a68f2be7bd84597b6da8d3c7ae717","volume":"226","author":[{"family":"Martínez-Candelas","given":"I.A."},{"family":"Pérez-Jiménez","given":"J.C."},{"family":"Espinoza-Tenorio","given":"A."},{"family":"McClenachan","given":"L."},{"family":"Méndez-Loeza","given":"I."}],"issued":{"date-parts":[["2020"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} and Brazil ITEM CSL_CITATION {"citationID":"O0wGoz80","properties":{"formattedCitation":"(A. P. B. Martins, 2018)","plainCitation":"(A. P. B. Martins, 2018)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":31796,"uris":["http://zotero.org/groups/2344805/items/2P6FS6FS"],"itemData":{"id":31796,"type":"article-journal","archive":"Scopus","container-title":"PLoS ONE","DOI":"10.1371/journal.pone.0193969","issue":"3","title":"Analysis of the supply chain and conservation status of sharks (Elasmobranchii: Superorder Selachimorpha) based on fisher knowledge","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85043780434&doi=10.1371%2fjournal.pone.0193969&partnerID=40&md5=f021f9444a9f6ed7d1bcef898271e719","volume":"13","author":[{"family":"Martins","given":"A.P.B."},{"family":"Feitosa","given":"L.M."},{"family":"Lessa","given":"R.P."},{"family":"Almeida","given":"Z.S."},{"family":"Heupel","given":"M."},{"family":"Silva","given":"W.M."},{"family":"Tchaicka","given":"L."},{"family":"Nunes","given":"J.L.S."}],"issued":{"date-parts":[["2018"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. The decline in the economic sustainability of shark fishing is attributed to decreases in shark fishing activity, revenues and profits from shark fins. 
	Other economic problems refer to inequalities in the distribution of profits among crew members and boat owners ITEM CSL_CITATION {"citationID":"a1tompg7sgn","properties":{"formattedCitation":"(De Figueiredo Silva, Camargo, & Estupi\\\\uc0\\\\u241{}\\\\uc0\\\\u225{}n, 2012)","plainCitation":"(De Figueiredo Silva, Camargo, & Estupiñán, 2012)","noteIndex":0},"citationItems":[{"id":31533,"uris":["http://zotero.org/groups/2344805/items/II9AT8ZQ"],"itemData":{"id":31533,"type":"article-journal","container-title":"Cybium","issue":"1","page":"17-30","title":"Fishery management in a conservation area the case of the Oiapoque River in northern Brazil","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84861413885&partnerID=40&md5=a3d9fd5af740c92216f4dc907e37ec49","volume":"36","author":[{"family":"De Figueiredo Silva","given":"S.L."},{"family":"Camargo","given":"M."},{"family":"Estupiñán","given":"R.A."}],"issued":{"date-parts":[["2012"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}, low prices paid to fishers by the middlemen, the concentration of profits in large private companies ITEM CSL_CITATION {"citationID":"a28hr66ot2d","properties":{"formattedCitation":"(Gamboa-\\\\uc0\\\\u193{}lvarez, L\\\\uc0\\\\u243{}pez-Rocha, Poot-L\\\\uc0\\\\u243{}pez, Aguilar-Perera, & Villegas-Hern\\\\uc0\\\\u225{}ndez, 2020; Jimenez, Barboza, Amaral, & Lucena Fr\\\\uc0\\\\u233{}dou, 2019)","plainCitation":"(Gamboa-Álvarez, López-Rocha, Poot-López, Aguilar-Perera, & Villegas-Hernández, 2020; Jimenez, Barboza, Amaral, & Lucena Frédou, 2019)","noteIndex":0},"citationItems":[{"id":31812,"uris":["http://zotero.org/groups/2344805/items/XHV2QXF9"],"itemData":{"id":31812,"type":"article-journal","archive":"Scopus","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2019.105011","title":"Rise and decline of the sea cucumber fishery in Campeche Bank, Mexico","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85072996710&doi=10.1016%2fj.ocecoaman.2019.105011&partnerID=40&md5=3da2ed754775df91c7ac83f992a36908","volume":"184","author":[{"family":"Gamboa-Álvarez","given":"M.Á."},{"family":"López-Rocha","given":"J.A."},{"family":"Poot-López","given":"G.R."},{"family":"Aguilar-Perera","given":"A."},{"family":"Villegas-Hernández","given":"H."}],"issued":{"date-parts":[["2020"]]}},"label":"page"},{"id":31805,"uris":["http://zotero.org/groups/2344805/items/7YEXBUMG"],"itemData":{"id":31805,"type":"article-journal","archive":"Scopus","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2019.104954","title":"Understanding changes to fish stock abundance and associated conflicts: Perceptions of small-scale fishers from the Amazon coast of Brazil","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85072046989&doi=10.1016%2fj.ocecoaman.2019.104954&partnerID=40&md5=6f592a09b1087a526fff39be47e4c153","volume":"182","author":[{"family":"Jimenez","given":"É.A."},{"family":"Barboza","given":"R.S.L."},{"family":"Amaral","given":"M.T."},{"family":"Lucena Frédou","given":"F."}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} and increasing costs related to fishing operations such as fuel to reach more distant fishing grounds ITEM CSL_CITATION {"citationID":"94ijhhj1","properties":{"formattedCitation":"(T.M. Daw, 2008)","plainCitation":"(T.M. Daw, 2008)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":31520,"uris":["http://zotero.org/groups/2344805/items/SJHM55RR"],"itemData":{"id":31520,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Research","DOI":"10.1016/j.fishres.2007.09.027","issue":"1-3","page":"17-25","title":"Spatial distribution of effort by artisanal fishers: Exploring economic factors affecting the lobster fisheries of the Corn Islands, Nicaragua","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-40649120682&doi=10.1016%2fj.fishres.2007.09.027&partnerID=40&md5=5067ab5d60b1c112fa9675ec56a4e66d","volume":"90","author":[{"family":"Daw","given":"T.M."}],"issued":{"date-parts":[["2008"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. A study with crab gatherers in the Brazilian Amazonian coast considers the fishery ecologically sustainable (catches and sizes of crabs did not change), but not economically and socially sustainable. The relative revenue for fishers also declined, which sometimes led to social conflicts ITEM CSL_CITATION {"citationID":"gtG7yFFz","properties":{"formattedCitation":"(Glaser & Diele, 2004)","plainCitation":"(Glaser & Diele, 2004)","noteIndex":0},"citationItems":[{"id":31566,"uris":["http://zotero.org/groups/2344805/items/G5A9CHHW"],"itemData":{"id":31566,"type":"article-journal","container-title":"Ecological Economics","DOI":"10.1016/j.ecolecon.2004.01.017","ISSN":"09218009","issue":"3","journalAbbreviation":"Ecological Economics","language":"en","page":"361-373","source":"DOI.org (Crossref)","title":"Asymmetric outcomes: assessing central aspects of the biological, economic and social sustainability of a mangrove crab fishery, Ucides cordatus (Ocypodidae), in North Brazil","title-short":"Asymmetric outcomes","URL":"https://linkinghub.elsevier.com/retrieve/pii/S0921800904001065","volume":"49","author":[{"family":"Glaser","given":"Marion"},{"family":"Diele","given":"Karen"}],"accessed":{"date-parts":[["2021",3,14]]},"issued":{"date-parts":[["2004",7]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}.
	The social aspects of small-scale fisheries were addressed by only 19 of 78 studies on coastal small-scale fisheries and 5 of 29 studies on inland small-scale fisheries (see the data management report for Chapter 3 systematic literature review at https://doi.org/10.5281/zenodo.6452651). Some of the territorial co-management coastal fisheries of invertebrates, mainly in Chile and Mexico, show social benefits such as improved perceptions among fishers about the fishery, more time available to dedicate to other activities, decreased conflicts over resources, reinforced property rights over resources, improved institutional collaboration, community organization and capacity building ITEM CSL_CITATION {"citationID":"JkAIS6Wa","properties":{"formattedCitation":"(\\\\uc0\\\\u193{}lvarez, 2018; Defeo, 2016; Gelcich, 2017, 2010; Palacios-Abrantes, 2018)","plainCitation":"(Álvarez, 2018; Defeo, 2016; Gelcich, 2017, 2010; Palacios-Abrantes, 2018)","noteIndex":0},"citationItems":[{"id":359,"uris":["http://zotero.org/groups/2344805/items/ZKJFMIDT"],"itemData":{"id":359,"type":"article-journal","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2018.08.029","page":"203-214","title":"Environmental history of Mexican North Pacific fishing communities","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85052975797&doi=10.1016%2fj.ocecoaman.2018.08.029&partnerID=40&md5=7b1889198ba3e82c414b1cbb823188d6","volume":"165","author":[{"family":"Álvarez","given":"P."},{"family":"Espejel","given":"I."},{"family":"Bocco","given":"G."},{"family":"Cariño","given":"M."},{"family":"Seingier","given":"G."}],"issued":{"date-parts":[["2018"]]}}},{"id":34288,"uris":["http://zotero.org/groups/2344805/items/MVWWMNWF"],"itemData":{"id":34288,"type":"article-journal","abstract":"Co-management (Co-M), de?ned as the sharing of management tasks and responsibilities between governments and local users, is emerging as a powerful institutional arrangement to redress ?sheries paradigm failures, yet long-term assessments of its performance are lacking. A comparative analysis of ?ve smallscale Latin American shell?sheries was conducted to identify factors suggesting success and failure. In Chile, Uruguay and Mexico Co-M produced positive effects, including stabilization of landings at low levels, increase in abundance, CPUE, unit prices and revenues per unit of effort, and reduced interannual variability in several ?shery indicators, particularly in landings. Co-M was successful because it was mainly bottom-up implemented and accompanied by-catch shares (spatial property rights and community quotas). By contrast, Co-M implementation was unable to prevent the collapse of the Galapagos sea cucumber ?shery, as re?ected by a decrease in abundance and CPUE. Negative effects were also observed in the Galapagos spiny lobster ?shery during Co-M implementation. However, recovery was observed in recent years, re?ected in a stabilization of ?shing effort and the highest CPUE and economic revenues observed since the beginning of the Co-M implementation phase. The combined effects of market forces, climate variability and a moratorium on ?shing effort were critical in ?shery recovery. We conclude that Co-M is not a blueprint that can be applied to all shell?sheries to enhance their governability. These social–ecological systems need to be managed by jointly addressing problems related to the resources, their marine environment and the people targeting them, accounting for their socioeconomic and cultural contexts.","container-title":"Fish and Fisheries","DOI":"10.1111/faf.12101","ISSN":"14672960","issue":"1","journalAbbreviation":"Fish Fish","language":"en","page":"176-192","source":"DOI.org (Crossref)","title":"Co-management in Latin American small-scale shellfisheries: assessment from long-term case studies","title-short":"Co-management in Latin American small-scale shellfisheries","URL":"http://doi.wiley.com/10.1111/faf.12101","volume":"17","author":[{"family":"Defeo","given":"Omar"},{"family":"Castrejón","given":"Mauricio"},{"family":"Pérez-Castañeda","given":"Roberto"},{"family":"Castilla","given":"Juan C"},{"family":"Gutiérrez","given":"Nicolás L"},{"family":"Essington","given":"Timothy E"},{"family":"Folke","given":"Carl"}],"accessed":{"date-parts":[["2019",8,8]]},"issued":{"date-parts":[["2016",3]]}}},{"id":364,"uris":["http://zotero.org/groups/2344805/items/KY3M28JI"],"itemData":{"id":364,"type":"article-journal","archive":"Scopus","container-title":"Bulletin of Marine Science","DOI":"10.5343/bms.2015.1082","issue":"1","page":"53-67","title":"Fishers' perceptions on the Chilean coastal TURF system after two decades: Problems, benefits, and emerging needs","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85009956088&doi=10.5343%2fbms.2015.1082&partnerID=40&md5=282619c33be9c7354daa0444ec5ce5c2","volume":"93","author":[{"family":"Gelcich","given":"S."},{"family":"Cinner","given":"J."},{"family":"Donlan","given":"C.J."},{"family":"Tapia-Lewin","given":"S."},{"family":"Godoy","given":"N."},{"family":"Castilla","given":"J.C."}],"issued":{"date-parts":[["2017"]]}}},{"id":363,"uris":["http://zotero.org/groups/2344805/items/EVV9MAHV"],"itemData":{"id":363,"type":"article-journal","archive":"Scopus","container-title":"Proceedings of the National Academy of Sciences of the United States of America","DOI":"10.1073/pnas.1012021107","issue":"39","page":"16794-16799","title":"Navigating transformations in governance of Chilean marine coastal resources","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-78049276265&doi=10.1073%2fpnas.1012021107&partnerID=40&md5=0a50cd77256a5b88f2095e7c9f9f915c","volume":"107","author":[{"family":"Gelcich","given":"S."},{"family":"Hughes","given":"T.P."},{"family":"Olsson","given":"P."},{"family":"Folke","given":"C."},{"family":"Defeo","given":"O."},{"family":"Fernández","given":"M."},{"family":"Foale","given":"S."},{"family":"Gunderson","given":"L.H."},{"family":"Rodríguez-Sickert","given":"C."},{"family":"Scheffer","given":"M."},{"family":"Steneck","given":"R.S."},{"family":"Castilla","given":"J.C."}],"issued":{"date-parts":[["2010"]]}}},{"id":32548,"uris":["http://zotero.org/groups/2344805/items/N8NFP5ZV"],"itemData":{"id":32548,"type":"article-journal","archive":"Scopus","container-title":"PLoS ONE","DOI":"10.1371/journal.pone.0209431","issue":"12","title":"Evaluating the bio-economic performance of a Callo de hacha (Atrina maura, Atrina tuberculosa & Pinna rugosa) fishery restoration plan in La Paz, Mexico","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85058775470&doi=10.1371%2fjournal.pone.0209431&partnerID=40&md5=0cc5599bb16631c6354484f1b8836f86","volume":"13","author":[{"family":"Palacios-Abrantes","given":"J."},{"family":"Herrera-Correal","given":"J."},{"family":"Rodríguez","given":"S."},{"family":"Brunkow","given":"J."},{"family":"Molina","given":"R."}],"issued":{"date-parts":[["2018"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Similarly, the co-managed pirarucu fisheries in the Brazilian Amazon have improved social sustainability through more equalitarian distribution of income, sense of pride, stronger culture and indigenous and local knowledge ITEM CSL_CITATION {"citationID":"a14h13ac031","properties":{"formattedCitation":"(Campos-Silva & Peres, 2016; Freitas, 2020)","plainCitation":"(Campos-Silva & Peres, 2016; Freitas, 2020)","noteIndex":0},"citationItems":[{"id":11559,"uris":["http://zotero.org/groups/2344805/items/PZ8SCRFZ","http://zotero.org/groups/2344805/items/CVPJDIXP"],"itemData":{"id":11559,"type":"article-journal","container-title":"Scientific Reports","DOI":"10.1038/srep34745","ISSN":"2045-2322","issue":"1","journalAbbreviation":"Sci Rep","language":"en","page":"34745","source":"DOI.org (Crossref)","title":"Community-based management induces rapid recovery of a high-value tropical freshwater fishery","URL":"http://www.nature.com/articles/srep34745","volume":"6","author":[{"family":"Campos-Silva","given":"João Vitor"},{"family":"Peres","given":"Carlos A."}],"accessed":{"date-parts":[["2022",3,22]]},"issued":{"date-parts":[["2016",12]]}}},{"id":31568,"uris":["http://zotero.org/groups/2344805/items/H7FBX3BH"],"itemData":{"id":31568,"type":"article-journal","container-title":"Ecological Economics","DOI":"10.1016/j.ecolecon.2020.106709","ISSN":"09218009","journalAbbreviation":"Ecological Economics","language":"en","page":"106709","source":"DOI.org (Crossref)","title":"Resource co-management as a step towards gender equity in fisheries","URL":"https://linkinghub.elsevier.com/retrieve/pii/S0921800919312637","volume":"176","author":[{"family":"Freitas","given":"Carolina T."},{"family":"Espírito-Santo","given":"Helder M.V."},{"family":"Campos-Silva","given":"João Vitor"},{"family":"Peres","given":"Carlos A."},{"family":"Lopes","given":"Priscila F.M."}],"accessed":{"date-parts":[["2020",6,8]]},"issued":{"date-parts":[["2020",10]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. 
	In coastal small-scale fisheries some problems undermining social sustainability are ongoing conflicts between fishers and managers of protected areas ITEM CSL_CITATION {"citationID":"a5f79rtl20","properties":{"formattedCitation":"(De Figueiredo Silva, 2012; Jimenez, 2019; P.F.M. Lopes, Rosa, Salyvonchyk, Nora, & Begossi, 2013; Priscila F. M. Lopes, Silvano, Nora, & Begossi, 2013)","plainCitation":"(De Figueiredo Silva, 2012; Jimenez, 2019; P.F.M. Lopes, Rosa, Salyvonchyk, Nora, & Begossi, 2013; Priscila F. M. Lopes, Silvano, Nora, & Begossi, 2013)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":31533,"uris":["http://zotero.org/groups/2344805/items/II9AT8ZQ"],"itemData":{"id":31533,"type":"article-journal","container-title":"Cybium","issue":"1","page":"17-30","title":"Fishery management in a conservation area the case of the Oiapoque River in northern Brazil","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84861413885&partnerID=40&md5=a3d9fd5af740c92216f4dc907e37ec49","volume":"36","author":[{"family":"De Figueiredo Silva","given":"S.L."},{"family":"Camargo","given":"M."},{"family":"Estupiñán","given":"R.A."}],"issued":{"date-parts":[["2012"]]}}},{"id":31805,"uris":["http://zotero.org/groups/2344805/items/7YEXBUMG"],"itemData":{"id":31805,"type":"article-journal","archive":"Scopus","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2019.104954","title":"Understanding changes to fish stock abundance and associated conflicts: Perceptions of small-scale fishers from the Amazon coast of Brazil","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85072046989&doi=10.1016%2fj.ocecoaman.2019.104954&partnerID=40&md5=6f592a09b1087a526fff39be47e4c153","volume":"182","author":[{"family":"Jimenez","given":"É.A."},{"family":"Barboza","given":"R.S.L."},{"family":"Amaral","given":"M.T."},{"family":"Lucena Frédou","given":"F."}],"issued":{"date-parts":[["2019"]]}}},{"id":"ERpTB65M/rg7HeekB","uris":["http://zotero.org/users/5932248/items/GHKUSU69"],"itemData":{"id":2568,"type":"article-journal","archive":"Scopus","container-title":"Marine Policy","DOI":"10.1016/j.marpol.2012.12.033","issue":"1","page":"100-110","title":"Suggestions for fixing top-down coastal fisheries management through participatory approaches","volume":"40","author":[{"family":"Lopes","given":"P.F.M."},{"family":"Rosa","given":"E.M."},{"family":"Salyvonchyk","given":"S."},{"family":"Nora","given":"V."},{"family":"Begossi","given":"A."}],"issued":{"date-parts":[["2013"]]}},"label":"page"},{"id":"ERpTB65M/0P0AyEaz","uris":["http://zotero.org/users/5932248/items/X8T7BI2B"],"itemData":{"id":3281,"type":"article-journal","container-title":"AMBIO","DOI":"10.1007/s13280-013-0452-0","ISSN":"0044-7447, 1654-7209","issue":"8","journalAbbreviation":"AMBIO","language":"en","page":"963-974","source":"DOI.org (Crossref)","title":"Transboundary Socio-Ecological Effects of a Marine Protected Area in the Southwest Atlantic","volume":"42","author":[{"family":"Lopes","given":"Priscila F. M."},{"family":"Silvano","given":"Renato A. M."},{"family":"Nora","given":"Vinicius A."},{"family":"Begossi","given":"Alpina"}],"issued":{"date-parts":[["2013",12]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. These include increased theft of fishing gear and potential competition for space with industrial vessels ITEM CSL_CITATION {"citationID":"AcL7ilOk","properties":{"formattedCitation":"(T.M. Daw, 2008)","plainCitation":"(T.M. Daw, 2008)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":31520,"uris":["http://zotero.org/groups/2344805/items/SJHM55RR"],"itemData":{"id":31520,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Research","DOI":"10.1016/j.fishres.2007.09.027","issue":"1-3","page":"17-25","title":"Spatial distribution of effort by artisanal fishers: Exploring economic factors affecting the lobster fisheries of the Corn Islands, Nicaragua","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-40649120682&doi=10.1016%2fj.fishres.2007.09.027&partnerID=40&md5=5067ab5d60b1c112fa9675ec56a4e66d","volume":"90","author":[{"family":"Daw","given":"T.M."}],"issued":{"date-parts":[["2008"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}, high risk practices, such as diving, which can involve accidents ITEM CSL_CITATION {"citationID":"azdYfEzs","properties":{"formattedCitation":"(Gamboa-\\\\uc0\\\\u193{}lvarez, 2020; Guebert-Bartholo, Barletta, Costa, Lucena, & Da Silva, 2011)","plainCitation":"(Gamboa-Álvarez, 2020; Guebert-Bartholo, Barletta, Costa, Lucena, & Da Silva, 2011)","noteIndex":0},"citationItems":[{"id":31812,"uris":["http://zotero.org/groups/2344805/items/XHV2QXF9"],"itemData":{"id":31812,"type":"article-journal","archive":"Scopus","container-title":"Ocean and Coastal Management","DOI":"10.1016/j.ocecoaman.2019.105011","title":"Rise and decline of the sea cucumber fishery in Campeche Bank, Mexico","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85072996710&doi=10.1016%2fj.ocecoaman.2019.105011&partnerID=40&md5=3da2ed754775df91c7ac83f992a36908","volume":"184","author":[{"family":"Gamboa-Álvarez","given":"M.Á."},{"family":"López-Rocha","given":"J.A."},{"family":"Poot-López","given":"G.R."},{"family":"Aguilar-Perera","given":"A."},{"family":"Villegas-Hernández","given":"H."}],"issued":{"date-parts":[["2020"]]}},"label":"page"},{"id":31529,"uris":["http://zotero.org/groups/2344805/items/K4CBBBPP"],"itemData":{"id":31529,"type":"article-journal","archive":"Scopus","container-title":"Journal of Coastal Research","issue":"SPEC. ISSUE 64","page":"398-402","title":"Fishery and the use of space in a tropical semi-arid estuarine region of Northeast Brazil: Subsistence and overexploitation","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84856007386&partnerID=40&md5=937050ef0d03f2ab550a9c910ec88cd4","author":[{"family":"Guebert-Bartholo","given":"F.M."},{"family":"Barletta","given":"M."},{"family":"Costa","given":"M.F."},{"family":"Lucena","given":"L.R."},{"family":"Da Silva","given":"C.P."}],"issued":{"date-parts":[["2011"]]}},"label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} and disruption of fishing cooperatives ITEM CSL_CITATION {"citationID":"9kwZByVa","properties":{"formattedCitation":"(Rubio-Cisneros, Aburto-Oropeza, Jackson, & Ezcurra, 2017)","plainCitation":"(Rubio-Cisneros, Aburto-Oropeza, Jackson, & Ezcurra, 2017)","noteIndex":0},"citationItems":[{"id":31810,"uris":["http://zotero.org/groups/2344805/items/G6E2Y4TC"],"itemData":{"id":31810,"type":"article-journal","archive":"Scopus","container-title":"Tropical Conservation Science","DOI":"10.1177/1940082917697261","title":"Coastal exploitation throughout Marismas Nacionales Wetlands in Northwest Mexico","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85034591999&doi=10.1177%2f1940082917697261&partnerID=40&md5=236d09f3e3433502b2c72d0f75a25689","volume":"10","author":[{"family":"Rubio-Cisneros","given":"N.T."},{"family":"Aburto-Oropeza","given":"O."},{"family":"Jackson","given":"J."},{"family":"Ezcurra","given":"E."}],"issued":{"date-parts":[["2017"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Even in the relatively successful co-managed Chilean shellfish. Other social problems at the Brazilian coast include increased commercialization and price of shark meat, which decreases the availability of shark meat for local people and threatens their food security ITEM CSL_CITATION {"citationID":"0u67JC58","properties":{"formattedCitation":"(Barbosa-Filho, 2019)","plainCitation":"(Barbosa-Filho, 2019)","noteIndex":0},"citationItems":[{"id":34914,"uris":["http://zotero.org/groups/2344805/items/2CKBEEQG"],"itemData":{"id":34914,"type":"article-journal","container-title":"Ethnobiology Letters","DOI":"10.14237/ebl.10.1.2019.1560","issue":"1","page":"97-103","title":"Historical shark meat consumption and trade trends in a global richness hotspot","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85077912499&doi=10.14237%2febl.10.1.2019.1560&partnerID=40&md5=049227e121a3f3f153e4fe59c99c5e13","volume":"10","author":[{"family":"Barbosa-Filho","given":"M.L.V."},{"family":"Hauser-Davis","given":"R.A."},{"family":"Siciliano","given":"S."},{"family":"Dias","given":"T.L.P."},{"family":"Alves","given":"R.R.N."},{"family":"Costa-Neto","given":"E.M."}],"issued":{"date-parts":[["2019"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. 
      Scientific and indigenous and local knowledge informed assessments have at times differed about the sustainable use of certain fisheries. For example, in a Colombian lagoon community social conflict arose between fishers and researchers due to differences in how they conceptualize sustainability, ITEM CSL_CITATION {"citationID":"kgXB2MSy","properties":{"formattedCitation":"(Torres-Guevara, Lopez, & Schl\\\\uc0\\\\u252{}ter, 2016)","plainCitation":"(Torres-Guevara, Lopez, & Schlüter, 2016)","noteIndex":0},"citationItems":[{"id":31531,"uris":["http://zotero.org/groups/2344805/items/56G8BD8N"],"itemData":{"id":31531,"type":"article-journal","archive":"Scopus","container-title":"Sustainability (Switzerland)","DOI":"10.3390/su8060549","issue":"6","title":"Understanding artisanal fishers' behaviors: The case of Ciénaga Grande de Santa Marta, Colombia","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84976287037&doi=10.3390%2fsu8060549&partnerID=40&md5=b648244e55b422c7dc8c3ca3d2e186ca","volume":"8","author":[{"family":"Torres-Guevara","given":"L.E."},{"family":"Lopez","given":"M.C."},{"family":"Schlüter","given":"A."}],"issued":{"date-parts":[["2016"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. A similar situation was observed in the Dominican Republic where fishers, based on their indigenous and local knowledge, considered the fisheries as more depleted through catches of juvenile fish of most species but scientists believed the fisheries targeted mostly adult fish and would thus be in a better state ITEM CSL_CITATION {"citationID":"IHAixsdc","properties":{"formattedCitation":"(Mclean & Forrester, 2018)","plainCitation":"(Mclean & Forrester, 2018)","noteIndex":0},"citationItems":[{"id":31811,"uris":["http://zotero.org/groups/2344805/items/YSC2X2MV"],"itemData":{"id":31811,"type":"article-journal","archive":"Scopus","container-title":"Ecological Applications","DOI":"10.1002/eap.1675","issue":"3","page":"668-680","title":"Comparing fishers’ and scientific estimates of size at maturity and maximum body size as indicators for overfishing","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-85045848392&doi=10.1002%2feap.1675&partnerID=40&md5=4409b165f43c20a1e5fb554a4f835651","volume":"28","author":[{"family":"Mclean","given":"E.L."},{"family":"Forrester","given":"G.E."}],"issued":{"date-parts":[["2018"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Both cases draw attention to the need for better dialogue and cooperation between fishers and scientists. 
	The main social problems related to the inland ornamental fisheries in the Brazilian Amazon are the negative effects of a reduced trade in the Negro River and a potential collapse of exploited species in the Xingu River, which will drastically reduce income and negatively affect the livelihoods of many impoverished riverine people, most of whom lack employment alternatives ITEM CSL_CITATION {"citationID":"5oONkRZi","properties":{"formattedCitation":"(Evers, Pinnegar, & Taylor, 2019a)","plainCitation":"(Evers, Pinnegar, & Taylor, 2019a)","noteIndex":0},"citationItems":[{"id":31539,"uris":["http://zotero.org/groups/2344805/items/6NA2GXDA"],"itemData":{"id":31539,"type":"article-journal","container-title":"Journal of Fish Biology","DOI":"10.1111/jfb.13930","ISSN":"0022-1112, 1095-8649","journalAbbreviation":"J Fish Biol","language":"en","page":"jfb.13930","source":"DOI.org (Crossref)","title":"Where are they all from? – sources and sustainability in the ornamental freshwater fish trade","title-short":"Where are they all from?","URL":"https://onlinelibrary.wiley.com/doi/abs/10.1111/jfb.13930","author":[{"family":"Evers","given":"Hans?Georg"},{"family":"Pinnegar","given":"John K."},{"family":"Taylor","given":"Martin I."}],"accessed":{"date-parts":[["2021",2,19]]},"issued":{"date-parts":[["2019",4,8]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. Another social problem of this fishery is the health issues related to the labor-intensive fishing performed mostly by aged fishers. Younger people are less and less involved in these activities. Not only does this have negative impacts on the labor distribution, but may also disrupt knowledge transmission of indigenous and local knowledge ITEM CSL_CITATION {"citationID":"vWcdD7RL","properties":{"formattedCitation":"(Ladislau, 2020)","plainCitation":"(Ladislau, 2020)","noteIndex":0},"citationItems":[{"id":31573,"uris":["http://zotero.org/groups/2344805/items/249IDV5Z"],"itemData":{"id":31573,"type":"article-journal","abstract":"Abstract The Negro river basin is considered the largest area of extractive of ornamental fish in Brazil. This area has fundamental importance for the populations from the Amazon. The present study aimed to describe socioeconomic profile of ornamental fishermen known as “piabeiros” in the Municipality of Barcelos, as well as the ornamental fishery, fisheries area, target species, environments, fishing techniques, equipment, capture techniques and main difficulties faced by the current activity. This study was carried out in municipality of Barcelos, through semi - structured interviews, with artisanal ornamental fishermen (N= 89). The main families of ornamental fish caught and traded were: Characidae, Lebiasinidae, Gasteropelecidae, Cichilidae, Anostomidae, Loricaridae, Potamotrygonidae and Gymnotidae. The main catchment areas were igarapés, lakes, flooded fields, beaches, river banks and igapó forest. Rapiché was the most used equipment in the fisheries both by the fishermen of the urban areas (43.81%) and rural (41.89%). Most of the fishermen are associated with the colony of fishermen of Barcelos (Z33). The data showed that the dynamics of ornamental fishing have changed in a short time and directly affected fishermen, in addition to the low age renewal with the participation of younger fishermen, threatening the transmission of ecological knowledge to future generations. As a result, the increase of the problems related to the productive chain and absence of public power to the activity, since ornamental fishing has already been treated as one of the main economic activities more important for the local communities and for the State of Amazonas.\\n          , \\n            Resumo A bacia do rio Negro é considerada a maior área de extrativismo de peixes ornamentais do Brasil. Esta área possui importância fundamental para as populações da Amazônia. O presente estudo objetivou descrever o perfil socioeconômico de pescadores conhecidos como “piabeiros” no município de Barcelos, bem como a pesca ornamental, área de pesca, espécies-alvo, ambientes, técnicas de pesca, equipamentos, técnicas de captura e dificuldades enfrentadas nesta atividade. O estudo foi realizado por meio de entrevistas semi - estruturadas, com pescadores artesanais ornamentais (N= 89). Os dados mostram que as famílias de peixes ornamentais capturados e comercializados foram: Characidae, Lebiasinidae, Gasteropelecidae, Cichilidae, Anostomidae, Loricaridae, Potamotrygonidae e Gymnotidae. As áreas de captura descritas foram igarapés, lagos, alagados, praias, margens de rios e floresta de igapó. O Rapiché foi o equipamento mais utilizado nas pescarias tanto pelos pescadores das áreas urbanas (43,81%) como rurais (41,89%). A maioria dos pescadores está associada à colônia de pescadores de Barcelos (Z33). Os dados coletados mostraram que a dinâmica da pesca ornamental mudou em pouco tempo e afetou diretamente os pescadores. Além da baixa taxa de renovação, com a participação de pescadores mais jovens, ameaçando a transmissão de conhecimento ecológico para as gerações futuras. Como resultado, notamos o aumento dos problemas relacionados à cadeia produtiva e a ausência de poder público na atividade. A pesca ornamental já foi tratada como uma das principais atividades econômicas para as comunidades locais e para o Estado do Amazonas.","container-title":"Brazilian Journal of Biology","DOI":"10.1590/1519-6984.215806","ISSN":"1678-4375, 1519-6984","issue":"3","journalAbbreviation":"Braz. J. Biol.","page":"544-556","source":"DOI.org (Crossref)","title":"Ornamental fishing in the region of Barcelos, Amazonas: socioeconomic description and scenario of activity in the view of “piabeiros”","title-short":"Ornamental fishing in the region of Barcelos, Amazonas","URL":"http://www.scielo.br/scielo.php?script=sci_arttext&pid=S1519-69842020000300544&tlng=en","volume":"80","author":[{"family":"Ladislau","given":"D. S."},{"family":"Ribeiro","given":"M. W. S."},{"family":"Castro","given":"P. D. S."},{"family":"Aride","given":"P. H. R."},{"family":"Paiva","given":"A. J. V."},{"family":"Polese","given":"M. F."},{"family":"Souza","given":"A. B."},{"family":"Bassul","given":"L. A."},{"family":"Lavander","given":"H. D."},{"family":"Oliveira","given":"A. T."}],"accessed":{"date-parts":[["2021",2,19]]},"issued":{"date-parts":[["2020",9]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}.

* North America
From a total of 28 sources on coastal and inland small-scale fisheries in temperate North America retrieved, 22 are included in this review (see the data management report for Chapter 3 systematic literature review at https://doi.org/10.5281/zenodo.6452651), which are evenly distributed between the United States of America (12) and Canada (9). One study addressed both countries, which is also the only study on inland fisheries ITEM CSL_CITATION {"citationID":"wGL0s2dt","properties":{"formattedCitation":"(S.J. Cooke & Murchie, 2015)","plainCitation":"(S.J. Cooke & Murchie, 2015)","dontUpdate":true,"noteIndex":0},"citationItems":[{"id":1076,"uris":["http://zotero.org/groups/2344805/items/8ZW6Z25M"],"itemData":{"id":1076,"type":"article-journal","archive":"Scopus","container-title":"Fisheries Management and Ecology","DOI":"10.1111/fme.12005","issue":"1","page":"1-13","title":"Status of aboriginal, commercial and recreational inland fisheries in North America: Past, present and future","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84921899044&doi=10.1111%2ffme.12005&partnerID=40&md5=8fb48b0fa2a71e9f519b46338bafa65d","volume":"22","author":[{"family":"Cooke","given":"S.J."},{"family":"Murchie","given":"K.J."}],"issued":{"date-parts":[["2015"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. The reviewed studies include a variety of fishing resources, such as coastal and reef fishes, crabs, lobster, shellfish and sea cucumbers (see the data management report for Chapter 3 systematic literature review at https://doi.org/10.5281/zenodo.6452651). We also include a case study on the sustainability of small-scale whaling activities in the north (see Box 3.4). 
