"]]}}},{"id":31757,"uris":["http://zotero.org/groups/2344805/items/AV76QX5G"],"itemData":{"id":31757,"type":"article-journal","container-title":"Marine Policy","ISSN":"0308-597X","journalAbbreviation":"Marine Policy","page":"111-120","title":"Fishers’ knowledge indicates short-term temporal changes in the amount and composition of catches in the southwestern Atlantic","volume":"71","author":[{"family":"Lima","given":"Evelyn G"},{"family":"Begossi","given":"Alpina"},{"family":"Hallwass","given":"Gustavo"},{"family":"Silvano","given":"Renato AM"}],"issued":{"date-parts":[["2016"]]}}},{"id":31716,"uris":["http://zotero.org/groups/2344805/items/IMNC98Q2"],"itemData":{"id":31716,"type":"article-journal","archive":"Scopus","container-title":"Coastal Management","DOI":"10.1080/08920753.2012.727734","issue":"6","page":"594-611","title":"Comparing Fisher Interviews, Logbooks, and Catch Landings Estimates of Extraction Rates in a Small-Scale Fishery","URL":"https://www.scopus.com/inward/record.uri?eid=2-s2.0-84868265819&doi=10.1080%2f08920753.2012.727734&partnerID=40&md5=ad8d271ce5cfe17e3269d685d23c03d3","volume":"40","author":[{"family":"O'Donnell","given":"K.P."},{"family":"Molloy","given":"P.P."},{"family":"Vincent","given":"A.C.J."}],"issued":{"date-parts":[["2012"]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"} to several decades, with some going back to the 1950s and 1960s ITEM CSL_CITATION {"citationID":"ac49eh4egh","properties":{"formattedCitation":"(Ainsworth, 2011; Lavides, 2016; Lozano-Montes, Pitcher, & Haggan, 2008)","plainCitation":"(Ainsworth, 2011; Lavides, 2016; Lozano-Montes, Pitcher, & Haggan, 2008)","noteIndex":0},"citationItems":[{"id":1073,"uris":["http://zotero.org/groups/2344805/items/RR3EFF6E"],"itemData":{"id":1073,"type":"article-journal","container-title":"Marine and Coastal Fisheries","DOI":"10.1080/19425120.2010.549047","issue":"1","page":"190-218","title":"Quantifying species abundance trends in t