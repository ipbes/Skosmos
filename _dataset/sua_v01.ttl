["2017"]]}}},{"id":19197,"uris":["http://zotero.org/groups/2344805/items/IP2W3ASX"],"itemData":{"id":19197,"type":"article-journal","container-title":"Population ecology","issue":"3","language":"en","page":"463–476","title":"Demography of Oenocarpus bataua and implications for sustainable harvest of its fruit in western Amazon","volume":"58","author":[{"family":"Isaza","given":"C."},{"family":"Martorell","given":"C."},{"family":"Cevallos","given":"D."},{"family":"Galeano","given":"G."},{"family":"Valencia","given":"R."},{"family":"Balslev","given":"H."}],"issued":{"date-parts":[["2016"]]}}},{"id":7638,"uris":["http://zotero.org/groups/2344805/items/U684F2U9"],"itemData":{"id":7638,"type":"article-journal","container-title":"Journal of Applied Ecology","DOI":"10.1111/1365-2664.13100","ISSN":"00218901","issue":"4","journalAbbreviation":"J Appl Ecol","language":"en","page":"1682-1691","source":"DOI.org (Crossref)","title":"Towards smarter harvesting from natural palm populations by sparing the individuals that contribute most to population growth or productivity","volume":"55","author":[{"family":"Jansen","given":"Merel"},{"family":"Anten","given":"Niels P. R."},{"family":"Bongers","given":"Frans"},{"family":"Martínez-Ramos","given":"Miguel"},{"family":"Zuidema","given":"Pieter A."}],"editor":[{"family":"Garibaldi","given":"Lucas"}],"issued":{"date-parts":[["2018",7]]}}},{"id":19210,"uris":["http://zotero.org/groups/2344805/items/KQF62M6Z"],"itemData":{"id":19210,"type":"article-journal","container-title":"Journal of Ecology","issue":"4","language":"en","page":"1032–1043","title":"Resilience of palm populations to disturbance is determined by interactive effects of fire, herbivory and harvest","volume":"103","author":[{"family":"Mandle","given":"L."},{"family":"Ticktin","given":"T."},{"family":"Zuidema","given":"P.A."}],"issued":{"date-parts":[["2015"]]}}},{"id":6037,"uris":["http://zotero.org/groups/2344805/items/ZDHJHPU3"],"itemData":{"id":6037,"type":"article-journal","abstract":"Palm heart is an important non-timber forest product obtained from various palm species in tropical forests. We studied the effect of four decades of palm heart extraction from the clonal palm Euterpe oleracea at the southern Paci?c coast of Colombia. We monitored populations that had been subject to a range of harvest intensities and used measured vital rates (survival, growth, sexual and clonal reproduction) to construct population matrix models. We then used these models to simulate several harvest scenarios and to project the population dynamics for the next 50 years. Our projections suggest that the currently implemented intensive harvest regimes – which involve up to four harvests per year – result in dramatic demographic changes, primarily affecting seedlings and adults. In addition, current harvest regimes affect the future supply of palm heart, which is projected to drop sharply during the ?rst years following harvest and fails to recover unless a number of stems are spared. Our simulations indicate that the most sustainable scenarios involve annual harvest between 50% and 75% of all harvestable stems, without any removal of small shoots from the clumps. Implementation of this regime must be accompanied by other management practices, including planning harvestable areas, marking the stems to be cut during subsequent harvests, assigning harvesters to speci?c areas, and leaving harvest residues as mulch around clumps. The degradation of populations of E. oleracea directly affects livelihoods of local people, by reducing cash income from palm heart sales and by reducing availability of palm fruits, a locally important food resource.","container-title":"Forest Ecology and Management","DOI":"10.1016/j.foreco.2014.01.028","ISSN":"03781127","journalAbbreviation":"Forest Ecology and Management","language":"en","page":"274-284","source":"DOI.org (Crossref)","title":"The fate of populations of Euterpe oleracea harvested for palm heart in Colombia","volume":"318","author":[{"family":"Vallejo","given":"Martha Isabel"},{"family":"Galeano","given":"Gloria"},{"family":"Bernal","given":"Rodrigo"},{"family":"Zuidema","given":"Pieter A."}],"issued":{"date-parts":[["2014",4]]}}}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citation.json"}. These factors can interact additively, antagonistically or synergistically ITEM CSL_CITATION {"citationID":"5Ly9ZGKT","properties":{"formattedCitation":"(del Castillo, 2013; Groner, 2021; Hart\\\\uc0\\\\u8208{}Fredeluces, 2021; Mandle, 2015)","plainCitation":"(del Castillo, 2013; Groner, 2021; Hart?Fredeluces, 2021; Mandle, 2015)","noteIndex":0},"citationItems":[{"id":20096,"uris":["http://zotero.org/groups/2344805/items/2TXWK8BD"],"itemData":{"id":20096,"type":"article-journal","container-title":"Ecology and Evolution","DOI":"10.1002/ece3.765","ISSN":"2045-7758, 2045-7758","issue":"11","journalAbbreviation":"Ecol Evol","language":"en","page":"3935-3946","source":"DOI.org (Crossref)","title":"Possible combined effects of climate change, deforestation, and harvesting on the epiphyte <i>Catopsis compacta</i> : a multidisciplinary approach","title-short":"Possible combined effects of climate change, deforestation, and harvesting on the epiphyte <i>Catopsis compacta</i>","volume":"3","author":[{"family":"Castillo","given":"Rafael F.","non-dropping-particle":"del"},{"family":"Trujillo?Argueta","given":"Sonia"},{"family":"Rivera?García","given":"Raul"},{"family":"Gómez?Ocampo","given":"Zaneli"},{"family":"Mondragón?Chaparro","given":"Demetria"}],"issued":{"date-parts":[["2013",10]]}}},{"id":19190,"uris":["http://zotero.org/groups/2344805/items/U72QZCK2"],"itemData":{"id":19190,"type":"article-journal","container-title":"Ecological Applications","language":"en","title":"Climate change, land cover change, and overharvesting threaten a widely used medicinal plant in South Africa","volume":"e2545","author":[{"family":"Groner","given":"V.P."},{"family":"Nicholas","gi