"family":"Hopewell","given":"Kristen"},{"family":"Horta e Costa","given":"Bárbara B."},{"family":"Houghton","given":"Jonathan D. R."},{"family":"Iitembu","given":"Johannes. A."},{"family":"Isaacs","given":"Moenieba"},{"family":"Isahaku","given":"Sadique"},{"family":"Ishimura","given":"Gakushi"},{"family":"Islam","given":"Monirul"},{"family":"Issifu","given":"Ibrahim"},{"family":"Jackson","given":"Jeremy"},{"family":"Jacquet","given":"Jennifer"},{"family":"Jensen","given":"Olaf P."},{"family":"Ramon","given":"Jorge Jimenez"},{"family":"Jin","given":"Xue"},{"family":"Jonah","given":"Alberta"},{"family":"Jouffray","given":"Jean-Baptiste"},{"family":"Juniper","given":"S. Kim"},{"family":"Jusoh","given":"Sufian"},{"family":"Kadagi","given":"Isigi"},{"family":"Kaeriyama","given":"Masahide"},{"family":"Kaiser","given":"Michel J."},{"family":"Kaiser","given":"Brooks Alexandra"},{"family":"Kakujaha-Matundu","given":"Omu"},{"family":"Karuaihe","given":"Selma T."},{"family":"Karumba","given":"Mary"},{"family":"Kemmerly","given":"Jennifer D."},{"family":"Khan","given":"Ahmed S."},{"family":"Kimani","given":"Patrick"},{"family":"Kleisner","given":"Kristin"},{"family":"Knowlton","given":"Nancy"},{"family":"Kotowicz","given":"Dawn"},{"family":"Kurien","given":"John"},{"family":"Kwong","given":"Lian E."},{"family":"Lade","given":"Steven"},{"family":"Laffoley","given":"Dan"},{"family":"Lam","given":"Mimi E."},{"family":"Lam","given":"Vicky W. L."},{"family":"Lange","given":"Glenn-Marie"},{"family":"Latif","given":"Mohd T."},{"family":"Le Billon","given":"Philippe"},{"family":"Le Brenne","given":"Valérie"},{"family":"Le Manach","given":"Frédéric"},{"family":"Levin","given":"Simon A."},{"family":"Levin","given":"Lisa"},{"family":"Limburg","given":"Karin E."},{"family":"List","given":"John"},{"family":"Lombard","given":"Amanda T."},{"family":"Lopes","given":"Priscila F. M."},{"family":"Lotze","given":"Heike K."},{"family":"Mallory","given":"Tabitha G."},{"family":"Mangar","given":"Roshni S."},{"family":"Marszalec","given":"Daniel"},{"family":"Mattah","given":"Precious"},{"family":"Mayorga","given":"Juan"},{"family":"McAusland","given":"Carol"},{"family":"McCauley","given":"Douglas J."},{"family":"McLean","given":"Jeffrey"},{"family":"McMullen","given":"Karly"},{"family":"Meere","given":"Frank"},{"family":"Mejaes","given":"Annie"},{"family":"Melnychuk","given":"Michael"},{"family":"Mendo","given":"Jaime"},{"family":"Micheli","given":"Fiorenza"},{"family":"Millage","given":"Katherine"},{"family":"Miller","given":"Dana"},{"family":"Mohamed","given":"Kolliyil Sunil"},{"family":"Mohammed","given":"Essam"},{"family":"Mokhtar","given":"Mazlin"},{"family":"Morgan","given":"Lance"},{"family":"Muawanah","given":"Umi"},{"family":"Munro","given":"Gordon R."},{"family":"Murray","given":"Grant"},{"family":"Mustafa","given":"Saleem"},{"family":"Nayak","given":"Prateep"},{"family":"Newell","given":"Dianne"},{"family":"Nguyen","given":"Tu"},{"family":"Noack","given":"Frederik"},{"family":"Nor","given":"Adibi M."},{"family":"Nunoo","given":"Francis K. E."},{"family":"Obura","given":"David"},{"family":"Okey","given":"Tom"},{"family":"Okyere","given":"Isaac"},{"family":"Onyango","given":"Paul"},{"family":"Oostdijk","given":"Maartje"},{"family":"Orlov","given":"Polina"},{"family":"Österblom","given":"Henrik"},{"family":"Owens","given":"Dwight"},{"family":"Owens","given":"Tessa"},{"family":"Oyinlola","given":"Mohammed"},{"family":"Pacoureau","given":"Nathan"},{"family":"Pakhomov","given":"Evgeny"},{"family":"Abrantes","given":"Juliano Palacios"},{"family":"Pascual","given":"Unai"},{"family":"Paulmier","given":"Aurélien"},{"family":"Pauly","given":"Daniel"},{"family":"Pèlèbè","given":"Rodrigue Orobiyi Edéya"},{"family":"Peñalosa","given":"Daniel"},{"family":"Pennino","given":"Maria G."},{"family":"Peterson","given":"Garry"},{"family":"Pham","given":"Thuy T. T."},{"family":"Pinkerton","given":"Evelyn"},{"family":"Polasky","given":"Stephen"},{"family":"Polunin","given":"