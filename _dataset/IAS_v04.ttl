<http://ontology.ipbes.net/report/subm/IAS23-D25-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Engage broadly across governmental sectors, industry, the scientific community, Indigenous Peoples and local communities and the wider public (established but incomplete) {6.4.2, 6.4.3, 6.7.2.4};" ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "6.4.2, 6.4.3, 6.7.2.4" .

<http://ontology.ipbes.net/report/subm/IAS23-D25-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Support, fund and mobilize resources for innovation, research and environmentally sound technology (established but incomplete) {6.3.3.4, 6.7.2.7};" ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "6.3.3.4, 6.7.2.7" .

<http://ontology.ipbes.net/report/subm/IAS23-D25-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.6>,
