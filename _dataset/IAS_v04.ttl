<http://ontology.ipbes.net/report/subm/IAS23-A1-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.2> ;
    ipbes:hasDescription "Alien species (plants, animals, fungi and microorganisms, including pathogens) are being introduced globally at an unprecedented rate; currently, approximately 200 new alien species are recorded every year (well established) {2.2.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A1-SM1> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.1> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.2> ;
    ipbes:hasDescription "Invasive alien species represent a subset of alien species, consisting of those that have established and spread and are known to have a negative impact on nature and, in some cases, people (figure SPM.1). Although their numbers are likely to be underestimated and expected to increase, to date 1,061 alien plants (6 per cent of all established alien plants), 1,852 alien invertebrates (22 per cent), 461 alien vertebrates (14 per cent) and 141 alien microbes (11 per cent) are known to be invasive globally (established but incomplete) {4.2}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A1-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.5> ;
    ipbes:hasDescription " Although some invasive alien species can provide benefits for people (e.g., through provision of food and fibre), those benefits do not mitigate or undo their negative impacts on nature, nature’s contributions to people, and good quality of life across all regions and taxa globally (well established) {1.3.4, 4.1.2, 4.3, 4.4, 4.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.3.4, 4.1.2, 4.3, 4.4, 4.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A1-SM3> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.2> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.2> ;
    ipbes:hasDescription "In addition to their impacts on nature, about 16 per cent of invasive alien species have negative impacts on nature’s contributions to people, and about 7 per cent on good quality of life (figure SPM.2) (established but incomplete) {4.2}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A1-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.2> ;
    ipbes:hasDescription "Based on data and information included in this assessment, most impacts are reported in the Americas (34 per cent), Europe and Central Asia (31 per cent) and Asia-Pacific (25 per cent), with fewer reported in Africa (7 per cent) (established but incomplete) {4.2}. Twenty per cent of all impacts are reported from islands (established but incomplete) {4.2}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A1-SM5> a ipbes:SubMessage ;
    ipbes:hasDescription "A disproportionate number of documented negative impacts have been reported from the terrestrial realm (75 per cent), especially temperate and boreal forests and woodlands and cultivated areas (including agricultural land) (established but incomplete) {table 4.2}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "table 4.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A1-SM6> a ipbes:SubMessage ;
    ipbes:hasDescription "About one quarter of the documented negative impacts have been reported from aquatic realms (freshwater: 14 per cent; marine: 10 per cent), especially from inland surface waters/waterbodies and shelf ecosystems (established but incomplete) {table 4.2}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "table 4.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "Invasive alien species have contributed solely or alongside other drivers of change to 60 per cent of recorded global animal and plant extinctions (established but incomplete) {box 4.4, 4.3.1}, " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.4, 4.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM1> a ipbes:SubMessage ;
    ipbes:hasDescription "while invasive alien species are the only driver attributed to 16 per cent of documented global extinctions (established but incomplete) {box 4.4}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.4" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM10> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.7> ;
    ipbes:hasDescription "The magnitude of the negative impacts of invasive alien species on nature depends on the context, and the factors that determine the highest magnitudes of impact are not well understood (established but incomplete) {box 4.9, 4.3.2.1, 4.7.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.9, 4.3.2.1, 4.7.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM11> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "For example, the ctenophore Mnemiopsis leidyi (sea walnut) has depleted zooplankton, the main food source of the anchovy, and consequently contributed to the collapse of anchovy populations in the Black Sea, but this has not occurred in the Mediterranean Sea, the Baltic Sea or the North Sea (well established) {4.3.2.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.3.2.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM2> a ipbes:SubMessage ;
    ipbes:hasDescription "The majority of documented global extinctions (90 per cent) with invasive alien species as one of the major causes are reported from islands (established but incomplete) {box 4.4}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.4" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM3> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.3> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "At least 218 invasive alien species have caused 1,215 documented local extinctions of native species across all taxa (figure SPM.3) (established but incomplete) {4.3.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "Invasive alien species harm native species most often by changing ecosystem properties (27 per cent), for example soil and water characteristics, and through competition between species (24 per cent), predation (18 per cent) and herbivory (12 per cent) (established but incomplete) {4.3.1.3}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.3.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "The majority of reports of the impacts of invasive alien species on native species document negative effects (85 per cent), primarily negatively impacting the growth, survival and reproduction of individuals, which lead to local population declines and local and global extinctions (well established) {4.3.1}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "Some invasive alien species have a profound ecological impact that spans various levels, from individual species and communities to whole ecosystems, resulting in complex, undesirable and in some cases irreversible outcomes when the system has crossed a threshold beyond which ecosystem restoration is not possible (well established) {box 4.12, 4.3.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 4.12, 4.3.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "For example, Castor canadensis (North American beaver) and Magallana gigas (Pacific oyster) change ecosystem properties by transforming habitats, with cascading effects on a myriad of native species (well established) {4.3.2.1, box 4.11}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.3.2.1, box 4.11" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "On Christmas Island, the arrival of the invasive alien Anoplolepis gracilipes (yellow crazy ant) caused the decline of the native Christmas Island Gecarcoidea natalis (red crabs), which resulted in the population explosion of the invasive alien Lissachatina fulica (giant African land snail) (well established) {3.3.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A2-SM9> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.3> ;
    ipbes:hasDescription "Increased biotic homogenization (or loss of uniqueness) of biological communities is a major negative impact of invasive alien species (well established) {1.3.4}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.3.4" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "Islands, and particularly remote islands with high endemism, are more susceptible to impacts from invasive alien species than mainlands (well established) {1.6.8, 4.3.1.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.6.8, 4.3.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "Indeed, in addition to the majority of documented global extinctions attributed mainly to invasive alien species occurring on islands, local extinctions account for 9 per cent of documented impacts of invasive alien species on islands, in contrast to 4 per cent on mainlands (well established) {4.3.1.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.3.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "For example, Boiga irregularis (brown tree snake) caused the global extinction of Myiagra freycineti (Guam flycatcher) and local extinction or serious population reduction for many other resident bird species in Guam (well established) {4.3.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM3> a ipbes:SubMessage ;
    ipbes:hasDescription "Islands are also vulnerable to climate change, which can increase the rate of establishment and spread of many invasive alien species (well established) {box 2.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 2.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM4> a ipbes:SubMessage ;
    ipbes:hasDescription "Many invasive alien species on islands only occupy a small portion of their predicted range and are likely to expand further (established but incomplete) {box 2.5}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 2.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM5> a ipbes:SubMessage ;
    ipbes:hasDescription "The number of alien plants exceeds the total number of native plants on more than one quarter of islands (well established) {box 2.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 2.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "Invasive alien species have been reported in areas protected for nature conservation, some remote areas (e.g., high mountains), and also in tundra and deserts, which emphasizes that these areas, despite being protected for nature conservation or remote, are also vulnerable to the negative impacts of invasive alien species (well established) {box 2.4, 4.3.1.2, 4.3.2.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 2.4, 4.3.1.2, 4.3.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "Fifty-three invasive alien species have caused the local extinctions of 240 native species in protected areas globally (established but incomplete) {4.3.1.2}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.3.1.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A3-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "The invasive alien Rattus rattus (black rat) has been documented as the only cause of the global extinction of Nesoryzomys darwini and Nesoryzomys indefessus (rice rats), which were endemic to the protected areas of the Galapagos Islands (well established) {4.3.1}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Some alien species have been intentionally introduced for their benefits to people, often without consideration or knowledge of their negative impacts (well established) {3.3.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.4> ;
    ipbes:hasDescription "However, nearly 80 per cent of the documented impacts of invasive alien species on nature’s contributions to people are negative (well established) {4.4.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.4.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.6> ;
    ipbes:hasDescription "Reduction in food supply is by far the most frequently reported impact across all taxa and regions (well established) {4.4.1, 4.6.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.4.1, 4.6.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.4> ;
    ipbes:hasDescription "In terrestrial systems, invasive alien plants are the taxonomic group most frequently reported as having a negative impact, particularly in cultivated areas and temperate and boreal forests (well established) {4.4.2.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.4.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.3> ;
    ipbes:hasDescription "For example, in north-western Europe Picea sitchensis (Sitka spruce) severely alters habitats such as coastal heathlands and mires, which are important habitats for threatened and endangered plants, birds and other species, and for local cultural heritage (well established) {4.3.2.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.3.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.4> ;
    ipbes:hasDescription "In coastal areas, invasive alien invertebrates are the most frequently reported taxonomic group with an impact on nature’s contributions to people, particularly provision of food (well established) {4.4.2.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.4.2.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.4> ;
    ipbes:hasDescription "For example, Carcinus maenas (European shore crab) has had an impact on commercial shellfish beds in New England and Canada, Asterias amurensis (northern Pacific seastar) and Ciona intestinalis (sea vase) have negatively affected mariculture and fisheries along the Korean coast, and Mytilopsis sallei (Caribbean false mussel) has displaced native clams and oysters that are locally important fishery resources in India (well established) {4.4.2.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.4.2.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM7> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.3> ;
    ipbes:hasDescription "In 2019, global annual costs of biological invasions were estimated to exceed US$423 billion, with variations across regions, but this is likely to be a gross underestimate (figure SPM.3) (established but incomplete) {box 4.13}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.13" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM8> a ipbes:SubMessage ;
    ipbes:hasDescription "Ninety-two per cent of this cost is attributed to the damage that the invasive alien species have caused to nature’s contributions to people and good quality of life; only 8 per cent is related to the management expenditures for biological invasions (established but incomplete) {box 4.13}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.13" .

<http://ontology.ipbes.net/report/subm/IAS23-A4-SM9> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.2> ;
    ipbes:hasDescription "Economic benefits are often gained by a few people or sectors while costs, often long-term ones, are borne by many others (established but incomplete) {3.2.3.5, 4.2.1, 6.2.2(6)}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.2.3.5, 4.2.1, 6.2.2(6)" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM0> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.3> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5> ;
    ipbes:hasDescription "Invasive alien species can threaten livelihoods, water and food security, economies and human health (e.g., causing diseases, allergies and physical injuries) (figure SPM.3) (well established) {4.5.1, 4.5.1.3}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.5.1, 4.5.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM1> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.3> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5> ;
    ipbes:hasDescription "with 85 per cent of the documented impacts of invasive alien species on good quality of life being negative (figure SPM.3) (well established) {4.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM10> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "In some cases, invasive alien species have been unintentionally transported and introduced through emergency relief and aid (e.g., seeds of the invasive alien plant Parthenium hysterophorus (parthenium weed) arrived with grain in aid shipments in several countries) (well established) {3.2.2.3}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.2.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM11> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.6> ;
    ipbes:hasDescription "increasing the risk of possible negative impacts on quality of life (established but incomplete) {4.5.1, 4.6.3}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.5.1, 4.6.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5> ;
    ipbes:hasDescription "Invasive alien species can also serve as vectors for infectious zoonotic diseases that can lead to epidemics, such as malaria, dengue fever, chikungunya, Zika, yellow fever and West Nile fever, which are transmitted by invasive mosquito species (e.g., Aedes albopictus and Aedes aegyptii) (well established) {box 1.14, 4.5.1.3}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 1.14, 4.5.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5> ;
    ipbes:hasDescription "Invasive alien plants can impact human health directly, particularly through the production of highly allergenic pollen, for example, Prosopis juliflora (mesquite) and Ambrosia artemisiifolia (common ragweed) (well established) {4.5.1.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.5.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5> ;
    ipbes:hasDescription "Indigenous Peoples and local communities, ethnic minorities, migrants, poor rural and urban communities are disproportionately impacted by invasive alien vector-borne diseases (established but incomplete) {4.5.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.7> ;
    ipbes:hasDescription "Although there is limited research on the interplay between gender relations and invasive alien species (established but incomplete) {4.5.1, 4.7.2}," ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.5.1, 4.7.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription " there is some evidence of inequities and marginalization in gender- and age-specific activities where invasive alien species impede access to natural resources or require management (established but incomplete) {4.5.1, 5.2, 5.2.1, 5.5.5}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.5.1, 5.2, 5.2.1, 5.5.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5> ;
    ipbes:hasDescription "For example, in Lake Victoria artisanal fisheries mainly involving men have declined following the introduction, establishment and spread of the invasive alien plant Pontederia crassipes (water hyacinth), which has led to the depletion of tilapia (established but incomplete) {4.5.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "In East Africa, management of the invasive alien plant Opuntia spp. (prickly pear) requires repeated weeding by hand, which is often undertaken by women and children and has in many cases become their most time-consuming activity (established but incomplete) {5.5.5}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.5.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A5-SM9> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Invasive alien species may be introduced for economic development, for example through financing large-scale infrastructures (well established) {3.2.5, 3.3.1.3, 3.3.1.4, box 3.11, 3.3.1.1, 3.3.2.1.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.5, 3.3.1.3, 3.3.1.4, box 3.11, 3.3.1.1, 3.3.2.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM0> a ipbes:SubMessage ;
    ipbes:hasDescription "More than 2,300 invasive alien species have been documented on lands managed, used and/or owned by Indigenous Peoples, with some negatively affecting their quality of life and cultural identities. Indigenous lands in Oceania and North America have particularly high numbers of recorded invasive alien species (established but incomplete) {box 2.6}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 2.6" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM1> a ipbes:SubMessage ;
    ipbes:hasDescription "However, numbers of invasive alien species are, on average, consistently lower on Indigenous lands compared to other lands (established but incomplete) {box 2.6}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 2.6" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM10> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Negative impact reports include water security and human and livestock health, as well as acknowledging that invasive alien species limit access to traditional lands, reduce mobility and require increased labour to manage (established but incomplete) {box 4.9, 4.5.1, 4.5.1.4, 4.6.3.1, 4.6.3.2, 5.5.5}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.9, 4.5.1, 4.5.1.4, 4.6.3.1, 4.6.3.2, 5.5.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM11> a ipbes:SubMessage ;
    ipbes:hasDescription "Invasive alien species can also adversely affect the autonomy, rights and cultural identity of Indigenous Peoples and local communities (established but incomplete) {box 4.15} " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.15" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM12> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.6> ;
    ipbes:hasDescription "through the loss of traditional livelihoods, knowledge and cultural practices (well established) {4.6.3.2}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.6.3.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM13> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.6> ;
    ipbes:hasDescription "often leading to general feelings of despair, sadness and stress (established but incomplete) {4.6.3.2}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "4.6.3.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.6> ;
    ipbes:hasDescription "Many Indigenous Peoples and local communities emphasize the inter-relatedness of the land, water and humans and other species, which can lead to a range of diverse perceptions of specific invasive alien species (well established) {1.6.7.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.6.7.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.6> ;
    ipbes:hasDescription "In some cases, Indigenous Peoples and local communities may consider an invasive alien species a valued part of their nature (established but incomplete) {1.6.7.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "1.6.7.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-4.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-4.6> ;
    ipbes:hasDescription "There are also examples where Indigenous Peoples and local communities have created new income sources by relying on invasive alien species (well established) {4.5.1, 4.6.2}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "4.5.1, 4.6.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM5> a ipbes:SubMessage ;
    ipbes:hasDescription "but that often occurs through necessity rather than choice. However, impact reports by some Indigenous Peoples and local communities document 68 per cent negative impacts and 32 per cent positive impacts on their good quality of life caused by invasive alien species (established but incomplete) {table 4.33}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "table 4.33" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "Indigenous Peoples and local communities often have a good understanding of how the complex interactions among drivers facilitate the introduction and spread of invasive alien species on their lands (established but incomplete) {3.2.3.6, box 3.15}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.2.3.6, box 3.15" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "For example, Indigenous Peoples and local communities recognize that the use of invasive alien species for food, fibre, income generation or medicinal purposes can cause negative impacts on nature’s contributions to people and their good quality of life (well established) {3.2.3.6, box 3.6}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.3.6, box 3.6" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "especially in situations where the native species they traditionally depended on for those benefits have declined (established but incomplete) {3.2.3.6; 3.2.5}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.2.3.6; 3.2.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A6-SM9> a ipbes:SubMessage ;
    ipbes:hasDescription "Impact reports by some Indigenous Peoples and local communities document 92 per cent negative impacts and 8 per cent positive impacts on nature caused by invasive alien species (established but incomplete) {table 4.31}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "table 4.31" .

<http://ontology.ipbes.net/report/subm/IAS23-A7-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-1.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Perceptions of specific invasive alien species and their value differ among and within stakeholder groups and Indigenous Peoples and local communities, as different community members can experience different impacts depending on gender, age, livelihood and a multitude of other factors (established but incomplete) {1.5.2, 1.6.7.1, 3.2.1, 5.6.1.2}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "1.5.2, 1.6.7.1, 3.2.1, 5.6.1.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A7-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Value conflicts arise when invasive alien species are considered to be a major threat by some stakeholders and beneficial by others (well established) {5.6.1.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.6.1.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A7-SM2> a ipbes:SubMessage ;
    ipbes:hasDescription "An invasive alien species may have been intentionally introduced for a particular purpose, including to mitigate other drivers of change (well established) {box 3.9}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 3.9" .

<http://ontology.ipbes.net/report/subm/IAS23-A7-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "but can have negative impacts on other sectors (well established) {3.3.1.1, 3.2.5, 5.6.1.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.1.1, 3.2.5, 5.6.1.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A7-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "For example, introduced pigs are important culturally in Hawaii and are hunted for subsistence, ceremony and recreation, despite causing severe negative impacts by driving and maintaining the spread of invasive alien plants within Hawaiian rainforest (established but incomplete) {5.6.1.2}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.6.1.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A7-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.2> ;
    ipbes:hasDescription "Divergence of perceptions of invasive alien species can prevent effective decision-making and management (established but incomplete) {5.6.1.2, 6.2.2(9)}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.6.1.2, 6.2.2(9)" .

<http://ontology.ipbes.net/report/subm/IAS23-A7-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "The management of invasive alien species can, in some cases, raise multiple ethical debates about animal welfare and rights (well established) {1.5.3, 5.6.2.1, box 6.13}" ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.5.3, 5.6.2.1, box 6.13" .

<http://ontology.ipbes.net/report/subm/IAS23-A7-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4> ;
    ipbes:hasDescription "(e.g., the challenges of effectively managing the biological invasion of Hippopotamus amphibius (African hippopotamus) in Colombia due to it being considered a charismatic species) (established but incomplete) {5.4.3.1}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.4.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.1> ;
    ipbes:hasDescription "Most countries (80 per cent, 156 out of 196) have targets for the management of biological invasions within their national biodiversity strategies and action plans, 74 per cent (145) of which are aligned with Aichi Biodiversity Target 9 (well established) {6.1.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.1.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.1> ;
    ipbes:hasDescription "Assessment of the progress towards meeting Aichi Biodiversity Target 9 concluded that there was still a considerable gap between the development and adoption of invasive alien species policy and implementation at national levels (well established) {6.1.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.1.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM10> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "and lack of coordination, with unclear roles and responsibilities among government agencies, stakeholders and Indigenous Peoples and local communities (well established) {6.2.2(3), 6.2.2(7), 6.2.3, 6.7.2.5}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.2.2(3), 6.2.2(7), 6.2.3, 6.7.2.5" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM11> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.2> ;
    ipbes:hasDescription "Nearly half of all countries (45 per cent) do not invest in management of biological invasions (Sustainable Development Goal indicator 15.8.1) (established but incomplete) {6.1.3}. Lack of awareness of the need for collective and coordinated responses can also hinder implementation {6.1.1, 6.2.2(9)}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "6.1.1, 6.2.2(9)",
        "6.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM12> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.2> ;
    ipbes:hasDescription "	B. Globally, invasive alien species and their impacts are increasing rapidly and are predicted to continue rising in the future" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM2> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-tableSPM.A3> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.1> ;
    ipbes:hasDescription "Although the number of countries with national invasive alien species checklists, including databases, has more than doubled in the last decade (196 countries in 2022) (table SPM.A3) {6.1.3}, 83 per cent do not have national legislation or regulations specifically on invasive alien species (well established) {6.1.3}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.3> ;
    ipbes:hasDescription "which also increases the risk of biological invasions for neighbouring countries (well established) {6.3.2.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.3.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.1> ;
    ipbes:hasDescription "Only 17 per cent of countries have national legislation for biological invasions, whereas an estimated 69 per cent have biological invasions-specific legislation as part of legislation in other sectors (well established) {6.1.2, 6.1.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.1.2, 6.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Although many agribusinesses do not manage the risk of the plants they trade (established but incomplete) {5.6.2.1}, " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.6.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM6> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-boxSPM.1> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3> ;
    ipbes:hasDescription "in some cases the business sector has developed voluntary codes of conduct in tandem with government regulations (box SPM.1) (well established) {5.4.1, 6.3.1.4(4), box 6.7}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.1, 6.3.1.4(4), box 6.7" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.3> ;
    ipbes:hasDescription "It should be noted, however, that voluntary codes of conduct are intended to complement, not replace, obligations within national legislation that regulate activities that transport, sell or use alien species (well established) {6.3.1.4(4)}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.3.1.4(4)" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "The transport of invasive alien species along trade supply chains (e.g., in shipping containers) may be poorly managed and consequently may constitute a biosecurity risk (well established) {5.6.2.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.6.2.2" .

<http://ontology.ipbes.net/report/subm/IAS23-A8-SM9> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.2> ;
    ipbes:hasDescription "There are many reasons for the limited adoption, implementation and efficacy of policy instruments, including varying capacity and resources across regions (well established) {6.2.2(7), 5.6.2.2} " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.2.2(7), 5.6.2.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM0> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.3> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.2> ;
    ipbes:hasDescription "Thirty-seven per cent of all known alien species have been reported since 1970 (figure SPM.3) (established but incomplete) {2.2.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "2.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.2> ;
    ipbes:hasDescription "The number of alien species has been rising continuously for centuries in all regions (well established) {2.2.1} " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM10> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.2> ;
    ipbes:hasDescription "Projections of long-term trends for invasive alien species numbers are not available but they are expected to be similar to those for established alien species (established but incomplete) {2.2.1}. T" ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "2.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM11> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.3> ;
    ipbes:hasDescription "he documented global economic cost of biological invasions has increased fourfold every 10 years since 1970 (figure SPM.3) and is anticipated to continue rising (established but incomplete) {box 4.13}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 4.13" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.6> ;
    ipbes:hasDescription "and is expected to continue increasing in the future (well established) {2.6.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.6.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM3> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figureSPM.4> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "Global exploration and colonialism beginning in 1500, with the associated movement of people and goods, and industrialization from 1850 resulted in the transport and introduction of alien species and were historically important. Increases in global trade since 1950 have resulted in unprecedentedly high and increasing numbers of alien species being introduced (figure SPM.4). Some of these have become invasive (well established) {2.1, 3.2.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.1, 3.2.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.6> ;
    ipbes:hasDescription "Even without the introduction of new species, given the opportunity, many already-established alien species in a region may continue to expand their geographic ranges and spread into new countries and regions (well established) {2.6.1}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.6.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-Box2.7> ;
    ipbes:hasDescription "including into remote environments such as mountain, polar (i.e., Antarctica and the Arctic) and desert ecosystems (well established) {2.5.2.8, 2.5.2.7, Box 2.7, box 3.11}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.5.2.8, 2.5.2.7, Box 2.7, box 3.11" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.6> ;
    ipbes:hasDescription "Under a “business-as-usual” scenario, which assumes the continuation of past trends in drivers, the total number of alien species is projected to further increase globally, and by 2050 is expected to be approximately 36 per cent higher than in 2005 (established but incomplete) {2.6.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "2.6.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.1> ;
    ipbes:hasDescription "As trends in major drivers are predicted to accelerate in the future (well established) {3.1.1}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.6> ;
    ipbes:hasDescription "the number of alien species worldwide is expected to increase faster than predicted under the “business-as-usual” scenario (established but incomplete) {2.6.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "2.6.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B10-SM9> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-tableSPM.A1> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.6> ;
    ipbes:hasDescription "There is a lack of quantified projections for invasive alien species under different scenarios (table SPM.A1), which impedes a comparison of trends for alternative futures (well established) {2.6.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.6.5" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.1> ;
    ipbes:hasDescription "There has been a fivefold increase in the size of the global economy over the last 50 years (well established) {3.1.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM1> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-figure SPM.5> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "International trade, which has increased nearly tenfold over the same period, represents the most important pathway through which invasive alien species are transported worldwide (figure SPM.5) (well established) {3.1.1, 3.2.3.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.1.1, 3.2.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "There is a strong link between the volume of commodity imports and the number of invasive alien species in a region, and patterns in the global spread of species mirror shipping and air traffic networks (well established) {3.2.3.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.3.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM3> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-boxSPM.2> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "The construction of shipping canals (e.g., Suez, Panama) has connected previously separated marine and freshwater regions, facilitating the spread of invasive alien species through species migration, ballast water transfers (box SPM.2) and biofouling (well established) {3.2.3.1, 3.3.1.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.3.1, 3.3.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM4> a ipbes:SubMessage ;
    ipbes:hasDescription "For example, 150 years after the opening of the Suez Canal, marine alien species are still being newly recorded in the Mediterranean Sea (well established) {box 3.7}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 3.7" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Biosecurity measures at international borders have not kept pace with the growing volume, diversity and origins of global trade (including e-trade) and travel (well established) {3.2.4.2, 3.2.3.4, 5.6.2.2}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.4.2, 3.2.3.4, 5.6.2.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3> ;
    ipbes:hasDescription "Projected growth in international trade and the movement of people, including tourism, will lead to further pressure on border inspection regimes and could soon overwhelm the biosecurity capability of most countries (well established) {3.2.3.1, 6.3.1.4}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.3.1, 6.3.1.4" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3> ;
    ipbes:hasDescription "Box SPM.2. The International Convention for the Control and Management of Ships’ Ballast Water and Sediments: an example of international collaboration to prevent biological invasions" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM8> a ipbes:SubMessage ;
    ipbes:hasDescription "Many invasive alien species have been introduced to coastal and inland water ecosystems globally through ballast water discharges {3.2.3.1}. For example, @T its introduction via ballast water discharge, Dreissena polymorpha (zebra mussel) has become widespread in the Great Lakes of North America {box 2.9}. Dreissena polymorpha has been implicated in the transfer of botulinum toxin to higher trophic levels, which has been further facilitated by climate change, specifically by increased water temperatures, leading to mortality of waterfowl in the Great Lakes {box 4.5}. Furthermore, the shells of Dreissena polymorpha can cause skin injuries to recreational swimmers and commercial fishers {box 4.15}. The International Maritime Organization has developed an international instrument to address the transfer of harmful aquatic organisms and pathogens in ballast water of maritime vessels {5.5.1}. The International Convention for the Control and Management of Ships’ Ballast Water and Sediments was adopted by the International Maritime Organization in 2004 and came into force in 2017 {5.5.1}. It is the first international legally binding legislation requiring ships to manage their ballast water so that aquatic organisms and pathogens are eliminated before the ballast water is released in a new location {3.2.3.1, 5.5.1, 6.1.3, 6.31}. While the global efficacy of ballast water management cannot be assessed yet, there is evidence that it has reduced invasive alien species introductions in the Great Lakes of North America {5.5.1}: between 1959 and 2006, one new alien species was discovered every seven months, but there was an abrupt shift (85 per cent decline) in the number of newly established alien species following the implementation of the ballast water regulations by Canada and the United States of America in 2006 and 2008 respectively {box 2.9}." ;
    dcterms:identifier "3.2.3.1",
        "3.2.3.1, 5.5.1, 6.1.3, 6.31",
        "5.5.1",
        "box 2.9",
        "box 4.15",
        "box 4.5" .

<http://ontology.ipbes.net/report/subm/IAS23-B11-SM9> a ipbes:SubMessage ;
    ipbes:hasDescription "Dreissena polymorpha (zebra mussel) was introduced through ballast water discharge in the Great Lakes of North America, causing a negative impact on nature, nature’s contributions to people, and good quality of life." .

<http://ontology.ipbes.net/report/subm/IAS23-B12-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Land- and sea-use changes may increase the vulnerability of natural ecosystems to the establishment and spread of invasive alien species through increasing fragmentation and habitat disturbance, for example by changing grazing, fire regimes, soil disturbance, or watershed flow (well established) {3.3.1.2, 3.3.1.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.1.2, 3.3.1.5" .

<http://ontology.ipbes.net/report/subm/IAS23-B12-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Transportation and utility infrastructures such as roads, tracks, railways, pipelines, canals and bridges, among others, can create corridors that facilitate the spread of invasive alien species, including into remote, undisturbed and protected areas (well established) {3.3.1.3, box 2.7, box 3.7}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.1.3, box 2.7, box 3.7" .

<http://ontology.ipbes.net/report/subm/IAS23-B12-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Marine and aquatic infrastructure may alter seascapes and the functioning of marine ecosystems, facilitating the spread of invasive alien species (established but incomplete) {3.2.2.4, 3.3.1.4, 5.6.1.4}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.2.2.4, 3.3.1.4, 5.6.1.4" .

<http://ontology.ipbes.net/report/subm/IAS23-B12-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "The numbers of invasive alien species were reported to be 1.5 to 2.5 times higher on pontoons and pilings than on natural rocky reefs (established but incomplete) {3.3.1.4}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.3.1.4" .

<http://ontology.ipbes.net/report/subm/IAS23-B12-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "More generally, land-use change can facilitate biological invasions through alteration of processes that cause natural disturbance of landscapes, such as wildfire or grazing regimes (established but incomplete) {3.3.1.5}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.3.1.5" .

<http://ontology.ipbes.net/report/subm/IAS23-B12-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "In several regions of the world, grazing by feral alien ungulates (horses, camels, buffalo, pigs) facilitates the spread of invasive alien plants, sometimes through complex species interactions involving the suppression of native species and the facilitation of other alien species (well established) {3.3.1.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.1.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B12-SM6> a ipbes:SubMessage ;
    ipbes:hasDescription "As a specific example, invasive alien ungulates (wild boar, deer) can transport invasive ectomycorrhizal (root associated symbiotic) fungi, which are beneficial for the establishment and spread of alien pine trees, over long distances, rendering habitats susceptible to pine invasion (well established) {box 3.10}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 3.10" .

<http://ontology.ipbes.net/report/subm/IAS23-B12-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Climate change, along with the continued intensification and expansion of land-use change may lead to future increases in the establishment and spread of invasive alien species in disturbed habitats and in nearby natural habitats (established but incomplete) {3.3.4}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.3.4" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.5> ;
    ipbes:hasDescription "The outcomes of interactions among multiple drivers, including feedback, are complex and varied (well established) {1.3.3, 3.1.5, 3.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.3.3, 3.1.5, 3.5" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.5> ;
    ipbes:hasDescription "Some of the highest current rates and greatest magnitudes of biological invasion occur where land-use change interacts with one or more additional drivers (established but incomplete) {3.5.1, 3.5.2, 3.5.3}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.5.1, 3.5.2, 3.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM10> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "Indirect drivers also interact with one another. For example, sociocultural changes may lead to increased rates of infrastructure development through urbanisation, and these interactions may further influence the rate and magnitude of change in land- and sea-use and other direct drivers that may in turn facilitate biological invasions (well established) {3.2.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM11> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.6> ;
    ipbes:hasDescription "Feedback and non-linear relationships among interacting drivers are likely to be exacerbated with ongoing and concurrent amplification of drivers (established but incomplete) {3.1.1, 3.5, 3.6.3, box 4.5}, " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.1.1, 3.5, 3.6.3, box 4.5" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM12> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.6> ;
    ipbes:hasDescription "potentially leading to numbers of invasive alien species never previously encountered (established but incomplete) {2.6.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "2.6.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM2> a ipbes:SubMessage ;
    ipbes:hasDescription "For example, interactions among land-use change, climate change and nutrient pollution have driven the introduction, establishment and spread of Pontederia crassipes (water hyacinth) across Africa (well established) {box 3.12}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 3.12" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.4> ;
    ipbes:hasDescription "Extraction of natural resources is closely linked with major economic and demographic drivers and can lead to a range of wider ecosystem impacts, including habitat degradation and loss, which facilitates invasive alien species (well established) {3.3.2, 3.4.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.2, 3.4.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Climate change is predicted to lead to major changes in land- and sea-use and, in some regions, in human migration patterns (established but incomplete) {3.3.4}, " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.3.4" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "but also to more extreme events among natural drivers, such as droughts, floods, wildfires, tropical storms and oceanic storm waves (established but incomplete) {3.3.4.3}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.3.4.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM6> a ipbes:SubMessage ;
    ipbes:hasDescription "Additionally, invasive alien plants, especially trees and grasses, can sometimes be highly flammable and therefore promote more intense and frequent fire regimes, causing increased risks to nature and people and increased carbon release into the atmosphere (well established) {box 1.4}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 1.4" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Climate change is also predicted to enhance the competitive ability of some invasive alien species and to extend areas suitable for them, thus offering new opportunities for introductions and establishment (established but incomplete) {3.3.4}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.3.4" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Invasive alien species can facilitate the establishment and spread of other invasive alien species, resulting in positive feedback that increases impacts through a process known as “invasional meltdown” (well established) {3.3.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B13-SM9> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.4> ;
    ipbes:hasDescription "Biodiversity loss can reduce the resilience of ecosystems to invasive alien species, with subsequent feedback facilitating the establishment and spread of other invasive alien species (well established) {3.4.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.4.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.2> ;
    ipbes:hasDescription "There are often time lags in detection and reporting of newly introduced invasive alien species (well established) {2.2.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.2> ;
    ipbes:hasDescription "Some invasive alien species spread very rapidly, while others take longer to spread and fully occupy their potential ranges (well established) {2.2.1, 2.2.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.2.1, 2.2.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.5> ;
    ipbes:hasDescription "For some invasive alien species, the impact is immediate and continues into the long-term (e.g., fast-spreading pathogens such as Zika virus and Batrachochytrium dendrobatidis (chytrid fungus), and fast-spreading predators such as lionfish), while for others there may be a considerable time lag, spanning decades in some cases, before the impact is apparent (e.g., many invasive alien trees) (well established) {1.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.5" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.5> ;
    ipbes:hasDescription "Such time lags can lead to people not perceiving the ongoing slow changes in their environment, including the impacts of invasive alien species (well established) {1.5.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.5.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.6> ;
    ipbes:hasDescription "There can also be significant time lags in the response of invasive alien species to various drivers because the underlying processes that facilitate biological invasions operate at varying temporal scales (short- to long-term) (well established) {1.5, 3.2.3.1, 3.6.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "1.5, 3.2.3.1, 3.6.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Invasive alien species may increase in numbers after a long period at low density as a result of changes in interactions with other species, for example as a result of the introduction of a missing dispersal agent or the removal of a competitor (3.3.5.1). For example, in the western United States, the invasive alien Carcinus maenas (European shore crab) reduced the abundance of a native clam, releasing another alien species, Gemma gemma (the amethyst gem clam), from competition, allowing it to become superabundant and to spread, after having been locally distributed and at low abundance for over 50 years (well established) {3.3.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.1> ;
    ipbes:hasDescription "Patterns in the numbers of alien species seen today reflect the drivers of decades ago (i.e., invasion debt) (established but incomplete) {3.1.1, 3.1.5}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "3.1.1, 3.1.5" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.6> ;
    ipbes:hasDescription "Consequently, past and ongoing amplification of drivers may lead to a long legacy of future invasive alien species as, for example, the number of new alien species that become invasive increases over time (i.e., invasion debt) (established but incomplete) {2.3.1.5, 3.1.5, 3.6.3}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "2.3.1.5, 3.1.5, 3.6.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B14-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.6> ;
    ipbes:hasDescription "C.	 Invasive alien species and their negative impacts can be prevented and mitigated through effective management" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "The transport and introduction of an invasive alien species can be intentional or unintentional, or in some cases both (well established) {3.2, 3.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2, 3.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Historically, many invasive alien species have been intentionally introduced outside their natural range around the world for their perceived benefits to people, without consideration or knowledge of their negative impacts (well established) {3.2.1, 3.2.3, 3.3.1, 3.3.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.1, 3.2.3, 3.3.1, 3.3.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM10> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "Demographic drivers also facilitate the introduction and spread of invasive alien species, although it is acknowledged that drivers differ across regions (well established) {3.2.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM11> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.1> ;
    ipbes:hasDescription "In the last 50 years, the number of people in the world has more than doubled, consumption has tripled, and global trade has grown nearly tenfold, with shifting patterns across regions (well established) {3.1.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM12> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "This acceleration of the world economy is increasing the rate and magnitude of many direct and indirect drivers, particularly those related to trade, travel and land- and sea-use change, leading to further biological invasions (well established) {3.1.1, 3.2.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.1.1, 3.2.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "For example, invasive alien species are often used in forestry, agriculture, horticulture, aquaculture and as pets (well established) {3.2.3.2, 3.3.1.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.3.2, 3.3.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "In the Mediterranean basin alone, more than 35 per cent of alien freshwater fish have arisen from aquaculture (well established) {3.3.1.1.1}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.1.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription " Invasive alien species have also been intentionally introduced for recreation and amenity (well established) {3.2.1, 3.2.3.3} " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.1, 3.2.3.3" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "and for soil stabilization (well established) {3.3.1.1.2, 3.3.1.6, 3.3.4.6}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.1.1.2, 3.3.1.6, 3.3.4.6" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "Many invasive alien species have also been introduced unintentionally, including as contaminants of soils and traded goods, stowaways in shipments (well established) {3.2.3.1, 3.2.3.2, 3.2.3.4}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.3.1, 3.2.3.2, 3.2.3.4" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "stowaways in ballast water and sediments, and as biofouling organisms that attach themselves to ships’ hulls and other surfaces on vessels (well established) {3.2.3.1, 3.2.5, 3.3.2.3, box 3.7}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.2.3.1, 3.2.5, 3.3.2.3, box 3.7" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.2> ;
    ipbes:hasDescription "Additionally, online trade in animals, plants and other organisms is contributing to the introduction of invasive alien species worldwide (well established) {2.1.2, 3.2.4.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "2.1.2, 3.2.4.2" .

<http://ontology.ipbes.net/report/subm/IAS23-B9-SM9> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-3.3> ;
    ipbes:hasDescription "Progressive degradation of nature, including from pollution and fragmentation of ecosystems, has facilitated the establishment and spread of invasive alien species (well established) {3.3.1.2, 3.3.1.3, 3.3.1.5, 3.3.1.6, 3.3.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "3.3.1.2, 3.3.1.3, 3.3.1.5, 3.3.1.6, 3.3.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C15-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.6> ;
    ipbes:hasDescription "There are three options for preventing or reducing the number and negative impacts of invasive alien species:" .

<http://ontology.ipbes.net/report/subm/IAS23-C15-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Pathway management, based on the analysis of pre-border, border and post-border risks, can prevent the movement and spread of invasive alien species through surveillance and the implementation of biosecurity response measures (well established) {5.3.1.1, 5.5.1, 5.5.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.3.1.1, 5.5.1, 5.5.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C15-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Species-based management at a local or landscape level, which includes surveillance, early detection and rapid response, eradication, containment and widespread control (including biological control), and can be applied throughout the biological invasion process (well established) {5.3.1.2, 5.5.2, 5.5.3, 5.5.4, 5.5.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.3.1.2, 5.5.2, 5.5.3, 5.5.4, 5.5.5" .

<http://ontology.ipbes.net/report/subm/IAS23-C15-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Site- or ecosystem-based management, which can both protect and restore native species and ecosystems (well established) {5.3.1.3, 5.5.6}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.3.1.3, 5.5.6" .

<http://ontology.ipbes.net/report/subm/IAS23-C15-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "The use of individual species-based and site-based approaches for the management of multiple invasive alien species has been both successful and cost-effective for terrestrial and closed water systems, especially in biogeographically isolated areas such as small islands and lakes (well established) {5.3.1, 5.3.2, 5.5.4}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.3.1, 5.3.2, 5.5.4" .

<http://ontology.ipbes.net/report/subm/IAS23-C15-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.3> ;
    ipbes:hasDescription "While some management approaches can be applied at multiple scales across terrestrial and closed water systems (well established) {5.1.1, 5.3.1.4.}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.1.1, 5.3.1.4." .

<http://ontology.ipbes.net/report/subm/IAS23-C15-SM6> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-e.g.,ballastwaterandbiofouling;box SPM.2> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3> ;
    ipbes:hasDescription "pathway management (e.g., ballast water and biofouling; box SPM.2) is by far the most effective option for managing biological invasions in marine and connected water systems, and can be achieved by enhanced international and regional cooperation (well established) {5.5.1, 6.3.2.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.1, 6.3.2.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C16-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.2> ;
    ipbes:hasDescription "Frameworks and tools have been developed based on evidence from practice, science and other knowledge systems, including those of Indigenous Peoples and local communities. These can underpin impact assessment, monitoring and prioritization of intentional and unintentional introduction pathways, species and sites for the successful management of biological invasions (well established) {5.2.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.2.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C16-SM1> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-table SPM.A1> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.4> ;
    ipbes:hasDescription "Although many knowledge and data gaps exist (table SPM.A1), the tools enable management actions to proceed under a risk assessment and risk management framework in line with a precautionary approach, as appropriate, using inclusive decision-making that leads to the review of all the measures (well established) {5.2.2.1, 5.2.2.3, 5.2.2.4, 5.3.3, 6.4.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.2.2.1, 5.2.2.3, 5.2.2.4, 5.3.3, 6.4.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C16-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Decision-making may be challenged by multiple sources of uncertainty, such as projections in other drivers of change, which can be recognied, quantified and documented to contextualize decisions (well established) {5.6.2.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.6.2.5" .

<http://ontology.ipbes.net/report/subm/IAS23-C16-SM3> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-tableSPM.A3> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.6> ;
    ipbes:hasDescription "Many sources of accessible literature and information (including open-access data), analytical tools and other types of knowledge can be used to support decision-making for all countries, which could lead to coordinated management outcomes globally (table SPM.A3) (established but incomplete) {6.6.1.5}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "6.6.1.5" .

<http://ontology.ipbes.net/report/subm/IAS23-C16-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.6> ;
    ipbes:hasDescription "Objectives and actions for managing biological invasions within terrestrial and closed water systems or marine and connected water systems and the level (high, medium, low) of their (a) current availability (availability of target-specific tools for implementing management); (b) ease of use (ease of implementation or specialist or technological expertise to implement); and (c) effectiveness (likely long-term efficacy and outcomes of implementation). Hashed boxes indicate responses with a low level of confidence and crossed boxes indicate there was no data available to perform an assessment. Actions are aligned with figure SPM.6 and encompass pathway management, species-, site- and ecosystem-based management targets. All management approaches may have non-target impacts, as indicated by superscript a." .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Prevention measures through pathway management, including strictly enforced pre-border quarantine, import controls and border biosecurity, have increased interception rates and slowed the rate of invasive alien species arriving and establishing globally (well established) {5.4.3.1, 5.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.3.1, 5.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "For example, in Australasia, the number of interceptions of Halyomorpha halys (brown marmorated stink bug), recognized as a major threat in the agricultural sector, have declined following implementation of a systems-based pathway management approach (well established) {5.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3> ;
    ipbes:hasDescription "Measures to address escape from confinement are also necessary (established but incomplete) {5.3.1.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.3.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "It is, however, difficult to prevent further natural dispersal of invasive alien species from a previously invaded range (well established) {5.5.1, box 1.6}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.1, box 1.6" .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3> ;
    ipbes:hasDescription "Prevention is important on islands and in ecosystems where eradication poses significant technical challenges (well established) {5.3.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.3.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.7> ;
    ipbes:hasDescription "Effective prevention measures depend on adequate and sustained funding, capacity-building, technical and scientific cooperation, transfer of technology, monitoring, and relevant and appropriate biosecurity legislation and enforcement, which is supported by strong infrastructure, quarantine and inspection facilities, including diagnostic support services (well established) {5.4.2, 5.6.2, 5.6.2.2, 5.7}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.2, 5.6.2, 5.6.2.2, 5.7" .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Risk assessment could be used by businesses to engage different sectors in the prevention and management of biological invasions (established but incomplete) {5.6.2.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.6.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3> ;
    ipbes:hasDescription "Adoption of regulated species lists with explicit prohibition of or permission for the importing of specific alien species, underpinned by risk analysis, has been an effective prevention strategy (well established) {5.6.2.1, 6.3.1.4}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.6.2.1, 6.3.1.4" .

<http://ontology.ipbes.net/report/subm/IAS23-C17-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription """It is estimated that nearly 70 per cent of marine invasive alien species established worldwide were introduced via biofouling (established but incomplete) {5.5.1}.
""" ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C18-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.2> ;
    ipbes:hasDescription "Horizon scanning and risk analysis are examples of the many decision-support tools used to identify and prioritize emerging invasive alien species to support preparedness (well established) {5.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C18-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Such tools can inform the development of rapid response plans in advance of an incursion to guide action effectively following the detection of priority invasive alien species (well established) {5.2.2.1.a, 5.2.2.1.b, 5.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.2.2.1.a, 5.2.2.1.b, 5.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C18-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Early detection of invasive alien species can enable rapid intervention to contain and eradicate invasive alien species before they spread (well established) {5.1.1, 5.3.1.1, 5.5.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.1.1, 5.3.1.1, 5.5.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C18-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "General surveillance strategies (e.g., through citizen science, sentinel sites, and remote sensing) for detecting new invasive alien species can also underpin effective preparedness (established but incomplete) {5.3.1.1, 5.4.2.1.a, 5.4.2.2.a, 5.5.2, box 6.20}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.3.1.1, 5.4.2.1.a, 5.4.2.2.a, 5.5.2, box 6.20" .

<http://ontology.ipbes.net/report/subm/IAS23-C18-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "For example, in Africa, Asia and Latin America, the PlantwisePlus programme assists smallholder farmers with the identification of pests and damaged crops, contributing to early detection of invasive alien species outbreaks (well established) {5.5.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Over the last 100 years, there have been 1,550 documented examples of eradication on 998 islands, with success cited in 88 per cent of cases (well established) {5.5.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM1> a ipbes:SubMessage ;
    ipbes:hasDescription "One of the many examples is French Polynesia, where Rattus rattus (black rat), Felis catus (cat), Oryctolagus cuniculus (rabbit) and Capra hircus (goat) have been successfully eradicated (well established) {box 5.8}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 5.8" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Eradication of invasive alien plants is particularly difficult because of the longevity of dormant seeds that can persist in soil (i.e., soil seed bank), although there are examples of successful eradication of invasive alien plant species with limited distributions (well established) {5.5.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM3> a ipbes:SubMessage ;
    ipbes:hasDescription "Also, rapid response to incursions, detected early, of some invertebrates have been successful, for example, eradication of Solenopsis invicta (red imported fire ant) in New Zealand (well established) {box 5.14}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "box 5.14" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "There are examples of largerscale eradications, such as Ondatra zibethicus (muskrat) and Myocastor coypus (coypu) from the United Kingdom (well established) {5.5.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "However, large-scale eradications are difficult and unlikely to be feasible in many cases (well established) {5.5.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "In addition to the extent of the area invaded, the success of eradication programmes depends on the support and engagement of relevant stakeholders and Indigenous Peoples and local communities (well established) {5.4.2.2.a, 5.5.3, 5.6.2.1, 5.6.2.2}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.2.2.a, 5.5.3, 5.6.2.1, 5.6.2.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Eradication programmes are aided by a rapid flow of information on the extent and location of invasive alien species, which can be provided by people who live nearby (well established) {5.4.2.2.a, 5.5.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.2.2.a, 5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Evidence suggests that there have been no fully successful eradication programmes for established invasive alien species in marine ecosystems (well established) {5.5.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C19-SM9> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "While eradication programmes can only be achieved with access to upfront cost, they are generally cheaper than long-term and permanent control cost and impacts (well established) {5.5.3}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "There are many examples of successful containment and control of invasive alien species in terrestrial and closed water systems and aquaculture (e.g., containment of Styela clava (Asian tunicate) invading the aqua-cultured blue mussel in Canada) (well established) {5.5.4}, " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.4" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "but most attempts in marine and open water ecosystems have been largely ineffective (established but incomplete) {5.5.4, 5.5.5}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.5.4, 5.5.5" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM10> a ipbes:SubMessage ;
    ipbes:hasDescription "Classical biological control uses host-specific natural enemies (biological control agents) of invasive alien species (target) to suppress and control such species. Mikania micrantha (bitter vine), a native species of Central and South America, is one of the highest-impact fast-growing {2.5.2.1} invasive alien plants within the agricultural systems and natural and planted forests of the Asia-Pacific region {box 5.21}, affecting the livelihoods of farmers and rural communities, including women {4.5.1, 4.6.1}. In the native range of Mikania micrantha, a rust fungus (Puccinia spegazzinii) specific to this invasive alien plant causes necrosis of leaves and cankers on the stem and petioles {box 5.21}. Starting in 2006, Puccinia spegazzinii was introduced as a classical biological control agent and established in five countries in the Asia-Pacific region, where it has provided effective control of Mikania micrantha {box 5.21}. However, in India the rust fungus failed to survive in the field following introduction {box 5.21}." ;
    dcterms:identifier "2.5.2.1",
        "4.5.1, 4.6.1",
        "box 5.21" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM2> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-tableSPM.1> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Containment of invasive alien species can be achieved with physical, chemical and biological control actions or in combination (table SPM.1) (well established) {5.4.3.2, 5.5.4}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.3.2, 5.5.4" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4> ;
    ipbes:hasDescription "Physical and chemical control options are mostly effective at a local scale but can also be effective at larger scales; these control options are limited by labour costs and generally provide short-term suppression but not sustained control (well established) {5.4.3.2.a}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.3.2.a" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4> ;
    ipbes:hasDescription "Furthermore, chemical control may have non-target impacts, needs to be implemented under regulatory compliance requirements and has decreasing societal acceptability (well established) {5.4.3.2.b}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.3.2.b" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Biological control has been very effective in controlling some invasive alien plants, invertebrates and, to a lesser extent, plant microbes and a few invasive alien vertebrates, but it may have non-target impacts if not well regulated (well established) {5.5.5.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "To reduce the risks of unintended consequences, including non-target impacts, from biological control, international standards and risk-based regulatory frameworks (developed under the International Plant Protection Convention) have been applied and continue to be effective across many countries (well established) {5.5.2}. " ;
    dcterms:identifier "5.5.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM7> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-boxSPM.3> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "The use of biological control for invasive alien plants and invertebrates has been successful in more than 60 per cent of documented cases (box SPM.3), with one third of the alien plant species requiring no further form of control, while also leading to benefits to biodiversity and ecosystem resilience (well established) {5.5.5.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription """Classical biological control to suppress invasive alien species populations at landscape scales has been effectively practised for more than 100 years (well established) {5.5.5.3}. 
""" ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.5.5.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C20-SM9> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Box SPM.3. Classical biological control of Mikania micrantha (bitter vine): an example of effective suppression of a widespread invasive alien species" .

<http://ontology.ipbes.net/report/subm/IAS23-C21-SM0> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-boxSPM.4> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "The integration of site- and/or ecosystem-based management, including ecosystem restoration, can improve management outcomes, enhancing ecosystem function and resilience to environmental change, including future invasive alien species, especially under climate and land-use change (box SPM.4) (well established) {5.3.1, 5.3.2, 5.4.3, 5.5.6, 5.6.1.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.3.1, 5.3.2, 5.4.3, 5.5.6, 5.6.1.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C21-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.6> ;
    ipbes:hasDescription "The success of any applied adaptive site- or ecosystembased management approach, including ecosystem restoration, depends on long-term monitoring to assess management efficacy using ecological and social indicators (established but incomplete) {5.5.2, 6.6.3}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.5.2, 6.6.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C21-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Long-term monitoring of sites ensures early detection of new introductions, reintroductions and re-emergence of invasive alien species (e.g., from a seed bank that includes invasive alien plants) and can inform further management actions (well established) {5.4.3.3.b, 5.5.6}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.3.3.b, 5.5.6" .

<http://ontology.ipbes.net/report/subm/IAS23-C21-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "However, most studies failed to quantify the effectiveness of ecosystem restoration since they failed to measure the initial status of native vegetation. This has led to inconsistent conclusions regarding the best invasive alien plant control option which may lead to the most effective ecosystem restoration {5.4.3.3b; 5.5.6}. Regarding freshwater ecosystems, monitoring biodiversity using macroinvertebrate-based indices is a widely used method globally. However, knowledge is lacking on how invasive alien species may affect the metric scores and therefore classification of a river's status (established but incomplete) {5.6.2.3}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.4.3.3b; 5.5.6",
        "5.6.2.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C21-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "In marine and connected water systems, ecosystem restoration has so far proved to be largely ineffective because the systems are open, leading to difficulties in implementing and evaluating management actions (established but incomplete) {5.5.6, 5.6.1.1}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.5.6, 5.6.1.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C21-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Box SPM.4. Working for Water programme: an example of management of invasive alien species leading to recovery of nature’s contributions to people " .

<http://ontology.ipbes.net/report/subm/IAS23-C21-SM6> a ipbes:SubMessage ;
    ipbes:hasDescription "Control of widespread invasive alien species requires sustained, large-scale efforts but can lead to improvement in the provision of a range of nature’s contributions to people {box 5.19}. Certain invasive alien plants, such as shrubs and trees, can reduce water availability, especially in scenarios of increasing drought caused by climate change {box 5.4}. In South Africa, the Working for Water programme, an Expanded Public Works Programme, was introduced in 1995 and targeted historically disadvantaged communities, primarily women, youth and disabled people, creating jobs to reduce poverty nationally through the removal of widespread woody invasive alien species threatening water conservation {box 5.19}. The programme generated 20,000 jobs per year over the first 15 years and has helped to improve nature’s contributions to people by improving water security {box 5.19}. It has contributed to rural development by providing training in entrepreneurial and management skills while encouraging a sense of community and dignity among workers, especially women. The Working for Water programme shows how partnerships with rural communities to manage invasive alien species can bring both ecological and social benefits {box 5.19}." ;
    dcterms:identifier "box 5.19",
        "box 5.4" .

<http://ontology.ipbes.net/report/subm/IAS23-C22-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4> ;
    ipbes:hasDescription "The development of tools and technologies ranging from biotechnology to bioinformatics and data analytics is ongoing for managing pathways, surveillance and detection, rapid response and eradication, local containment and control of widespread invasive alien species (well established) {5.4.1, 5.4.2, 5.4.3}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.1, 5.4.2, 5.4.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C22-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4> ;
    ipbes:hasDescription "eDNA-based approaches have been used for detection and identification of invasive alien, mostly aquatic, species such as Orconectes rusticus (rusty crayfish) (well established) {5.4.2.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C22-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4> ;
    ipbes:hasDescription "New approaches can be integrated with existing management actions to support site- and ecosystem-based management and restoration (established but incomplete) {5.4}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.4" .

<http://ontology.ipbes.net/report/subm/IAS23-C22-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.4> ;
    ipbes:hasDescription "Multi-stakeholder engagement, including risk communication and context-specific application of approaches through local communities, can improve public acceptability and adoption of new tools and technologies for managing biological invasions and the control of invasive alien species (well established) {5.2.1, 5.4.3, 5.6.2.1, 6.4.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.2.1, 5.4.3, 5.6.2.1, 6.4.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C22-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4> ;
    ipbes:hasDescription "Potential benefits and risks of novel technologies can be assessed using a risk assessment and risk management framework in line with a precautionary approach, as appropriate (well established) {5.4.3.2.f}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.3.2.f" .

<http://ontology.ipbes.net/report/subm/IAS23-C22-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4> ;
    ipbes:hasDescription "Using this framework in consultation with regulators, stakeholders and Indigenous Peoples and local communities can limit the potential for unintended consequences (well established) {5.4.3.2}. " ;
    dcterms:identifier "5.4.3.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C22-SM6> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3> ;
    ipbes:hasDescription "However, most countries do not have the regulatory frameworks and/or technical capabilities needed to guide and support development and implementation of new tools and technologies (established but incomplete) {5.4.3.2, 6.3.3.4}. " ;
    dcterms:identifier "5.4.3.2, 6.3.3.4" .

<http://ontology.ipbes.net/report/subm/IAS23-C22-SM7> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Access to modern tools and technologies and the ability to utilize them can be limited, particularly in developing countries, meaning greater capacity-building is required and improved technical and scientific cooperation (well established) {5.6.2.4, 6.7.2.7}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.6.2.4, 6.7.2.7" .

<http://ontology.ipbes.net/report/subm/IAS23-C23-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.5> ;
    ipbes:hasDescription "Access to adequate and sustained financial and other resources, including international funding to support developing countries, underpins and improves the effectiveness of actions for long-term management of biological invasions, including eradication, control and ongoing monitoring, by, for example, providing access to modern tools and enhancing capacity to deploy them (well established) {5.3.1, 5.5.7, 5.6.2.1, 5.6.2.2, 5.6.2.4, 6.5, 6.5.7}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.3.1, 5.5.7, 5.6.2.1, 5.6.2.2, 5.6.2.4, 6.5, 6.5.7" .

<http://ontology.ipbes.net/report/subm/IAS23-C23-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.5> ;
    ipbes:hasDescription "Engagement by all stakeholders, governments and the private sector helps to optimize management of biological invasions in terms of economic, environmental and social outcomes, particularly when resources are limited (well established) {5.2.1, 6.5.1}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.2.1, 6.5.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C23-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.4> ;
    ipbes:hasDescription "Societal support is important for eradication and control of some invasive alien species, particularly vertebrates, for which there are ethical considerations {5.3.1.4, 5.4.3.2, 5.6.2.1}. A lack of stakeholder participation in adaptive management can lead to negative consequences for good quality of life, especially for Indigenous Peoples and local communities who have adapted by using invasive alien species, that include loss of livelihoods, marginalization and/or gender inequity (well established) {box 4.18, 5.2.1, 5.4.3.3.a, 5.5.3, 5.6.1.2, 6.4.1}. " ;
    dcterms:identifier "5.3.1.4, 5.4.3.2, 5.6.2.1",
        "box 4.18, 5.2.1, 5.4.3.3.a, 5.5.3, 5.6.1.2, 6.4.1" .

<http://ontology.ipbes.net/report/subm/IAS23-C23-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.4>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "The involvement of all stakeholders can be achieved by using an adaptive co-management approach to the process, from decision-making to the implementation of management actions (well established) {5.4.3.3.a, 5.6.2.5}. " ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.4.3.3.a, 5.6.2.5" .

<http://ontology.ipbes.net/report/subm/IAS23-C23-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.7>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.4> ;
    ipbes:hasDescription "Adaptive co-management includes capacity-building; co-creation, co-design, co-development and co-implementation; social learning; and broad partnerships (established but incomplete) {5.7, 6.4.2, 6.4.3.2, 6.4.4}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.7, 6.4.2, 6.4.3.2, 6.4.4" .

<http://ontology.ipbes.net/report/subm/IAS23-C23-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Collaboratively addressing the management of biological invasions around which there are conflicting values among different sectors, stakeholders and Indigenous Peoples and local communities is a significant global policy challenge (well established) {5.6.1.2}." ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "5.6.1.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C24-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "Many communities successfully manage invasive alien species on their lands (established but incomplete) {box 5.6, 5.5.2, 5.5.4, 5.5.5}, " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "box 5.6, 5.5.2, 5.5.4, 5.5.5" .

<http://ontology.ipbes.net/report/subm/IAS23-C24-SM1> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/IAS23-boxSPM.4> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5> ;
    ipbes:hasDescription "leading to increases in nature’s contributions to people (box SPM.4) (established but incomplete) {5.5.4, 5.5.5}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.5.4, 5.5.5" .

<http://ontology.ipbes.net/report/subm/IAS23-C24-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.4> ;
    ipbes:hasDescription "Consultation with Indigenous Peoples and local communities, through their free, prior and informed consent, by applying co-design principles for decision-making and actions helps to ensure efficacy of management outcomes at the local level (established but incomplete) {5.2.1, 6.4.3}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.2.1, 6.4.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C24-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.5>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.4> ;
    ipbes:hasDescription "Co-delivered biocultural management plans based on shared scientific, technical and Indigenous and local knowledge systems have assisted surveillance and detection, eradication, containment and control of invasive alien species (established but incomplete) {5.5.3, 5.6.1.2, 6.4.3.2}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "5.5.3, 5.6.1.2, 6.4.3.2" .

<http://ontology.ipbes.net/report/subm/IAS23-C24-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.4> ;
    ipbes:hasDescription "Such co-governance structures improve quality of life for Indigenous Peoples and local communities (established but incomplete) {6.4.3}." ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "6.4.3" .

<http://ontology.ipbes.net/report/subm/IAS23-C24-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.4> ;
    ipbes:hasDescription "D.	 Ambitious progress to manage biological invasions can be achieved with integrated governance" .

<http://ontology.ipbes.net/report/subm/IAS23-D25-SM0> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Integrated governance for biological invasions consists of establishing the relationships between the roles of actors, institutions and instruments. This involves all those elements of the interactions between people and nature that act on biological invasion and their management, in order to identify the strategic interventions needed to improve outcomes of prevention and control of invasive alien species {box 6.5}. A context-specific integrated governance approach provides flexibility for countries to identify which strategic actions should be prioritized and can help in managing trade-offs and policy conflicts and in avoiding unintended policy consequences and inefficient expenditure (established but incomplete) {6.2.3, 6.7.1}. " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "6.2.3, 6.7.1",
        "box 6.5" .

<http://ontology.ipbes.net/report/subm/IAS23-D25-SM1> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Strategic actions to prevent the introduction and impact of invasive alien species include:" .

<http://ontology.ipbes.net/report/subm/IAS23-D25-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Enhance coordination and collaboration across international and regional mechanisms (established but incomplete) {6.2.3.4, 6.7.2.1}; " ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "6.2.3.4, 6.7.2.1" .

<http://ontology.ipbes.net/report/subm/IAS23-D25-SM3> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.2>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Develop and adopt effective and achievable national implementation strategies (well established) {6.2.3.2, 6.3.3.1, 6.7.2.3};" ;
    ipbes:hasWellestablished "Well-established" ;
    dcterms:identifier "6.2.3.2, 6.3.3.1, 6.7.2.3" .

<http://ontology.ipbes.net/report/subm/IAS23-D25-SM4> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Share efforts and commitments and understanding of the specific roles of all actors (established but incomplete) {6.7.2.5};" ;
    ipbes:hasEstablishedIncomplete "Established_but_incomplete" ;
    dcterms:identifier "6.7.2.5" .

<http://ontology.ipbes.net/report/subm/IAS23-D25-SM5> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.7> ;
    ipbes:hasDescription "Improve policy coherence (well established) {6.3.1.1, 6.3.2, 6.3.3.1, 6.7.2.2};" ;
