<http://ontology.ipbes.net/report/subm/SUA22-A.1-SM14> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/SUA22-3.3> ;
    ipbes:hasDescription "People in economically disadvantaged urban and rural areas rely on wild plants, algae and fungi as sources of essential calories, micronutrients and medicine (well established) {3.3.2, 3.3.2.2.2}. " ;
