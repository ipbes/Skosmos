    ipbes:Reference <http://ontology.ipbes.net/report/ref/2345372/items/84DS7I74>,
        <http://ontology.ipbes.net/report/ref/2345372/items/P5AHSHZ8>,
        <http://ontology.ipbes.net/report/ref/2345372/items/X4THTQZ6> ;
